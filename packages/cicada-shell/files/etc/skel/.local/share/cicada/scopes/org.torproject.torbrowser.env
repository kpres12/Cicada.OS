# Tor Browser. NETWORK=tor is enforced by the kernel (onion namespace), not by
# a proxy setting the browser could ignore or a bug could bypass.
#
# Use THIS for anonymity, not Helium-with-Tor. Tor Browser's protection is that
# every user presents the same fingerprint; a different browser over Tor is a
# small, distinctive population and is easier to single out, not harder.
NETWORK=tor
FILES=portal
CAMERA=deny
MIC=deny
USB=deny
SENSORS=deny
