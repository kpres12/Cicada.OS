{
  "layer": "top",
  "position": "top",
  "height": 26,
  "spacing": 0,
  "modules-left": ["custom/cicada", "custom/term", "custom/web", "custom/files", "hyprland/workspaces", "custom/profile"],
  "modules-center": ["hyprland/window"],
  "modules-right": ["custom/scopes", "custom/rf", "network", "pulseaudio", "battery", "clock"],
  "custom/cicada": {
    "format": "CICADA // MAGI-01",
    "tooltip": "click: launcher",
    "interval": "once",
    "on-click": "wofi --show drun"
  },
  "custom/term": {
    "format": "TERM",
    "tooltip": "Kitty",
    "interval": "once",
    "on-click": "kitty"
  },
  "custom/files": {
    "format": "FILES",
    "tooltip": "Thunar",
    "interval": "once",
    "on-click": "thunar"
  },
  "custom/profile": {
    "exec": "cicada-profile list 2>/dev/null | head -1 | awk '{print toupper($0)}' | sed 's/^$/PERSONAL/'",
    "format": "USR {}",
    "interval": 10,
    "tooltip": false
  },
  "custom/scopes": {
    "exec": "test -d \"$HOME/.local/share/cicada/scopes\" && echo SCOPES || echo SCOPES INIT",
    "interval": 15,
    "tooltip": "Super+I  MAGI-02 scopes",
    "on-click": "kitty --title CICADA-SCOPES -e cicada-scopes"
  },
  "custom/rf": {
    "exec": "rfkill list wifi 2>/dev/null | grep -q 'Soft blocked: yes' && echo 'RF BLOCK' || echo 'RF LIVE'",
    "interval": 5,
    "tooltip": false
  },
  "hyprland/workspaces": {
    "format": "{name}",
    "disable-scroll": true
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 42
  },
  "clock": {
    "format": "{:%Y-%b-%d %H:%M}Z",
    "tooltip": false
  },
  "battery": {
    "format": "BAT {capacity}",
    "format-charging": "BAT+ {capacity}",
    "format-plugged": "AC {capacity}",
    "format-critical": "BAT CRIT {capacity}"
  },
  "network": {
    "format-wifi": "NET {essid}",
    "format-ethernet": "NET WIRED",
    "format-disconnected": "NET DOWN",
    "tooltip": false
  },
  "pulseaudio": {
    "format": "AUD {volume}",
    "format-muted": "AUD MUTE"
  }
}
