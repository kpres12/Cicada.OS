{
  "layer": "top",
  "position": "top",
  "height": 38,
  "spacing": 0,
  "modules-left": ["custom/cicada", "custom/term", "custom/web", "custom/files", "custom/settings", "hyprland/workspaces", "custom/profile"],
  "modules-center": ["hyprland/window"],
  "modules-right": ["custom/close", "custom/swaync", "network", "pulseaudio", "backlight", "battery", "clock"],
  "custom/cicada": {
    "format": "CICADA",
    "tooltip": "click: launcher (Cicada apps only)",
    "interval": "once",
    "on-click": "cicada-wofi"
  },
  "custom/term": {
    "format": "TERM",
    "tooltip": "Kitty (owner shell)",
    "interval": "once",
    "on-click": "cicada-run org.cicada.kitty -- kitty"
  },
  "custom/web": {
    "format": "WEB",
    "tooltip": "Helium",
    "interval": "once",
    "on-click": "/usr/local/bin/chromium"
  },
  "custom/files": {
    "format": "FILES",
    "tooltip": "Files (sandboxed)",
    "interval": "once",
    "on-click": "cicada-files"
  },
  "custom/settings": {
    "format": "SETTINGS",
    "tooltip": "Wi-Fi, sound, scopes, profiles, dock, lock",
    "interval": "once",
    "on-click": "cicada-run org.cicada.settings -- cicada-settings"
  },
  "custom/close": {
    "format": "CLOSE",
    "tooltip": "Close the focused window (also Alt+F4)",
    "interval": "once",
    "on-click": "hyprctl dispatch killactive"
  },
  "custom/profile": {
    "exec": "cicada-profile list 2>/dev/null | head -1 | tr '[:lower:]' '[:upper:]'",
    "format": "USR {}",
    "interval": 10,
    "tooltip": false
  },
  "custom/swaync": {
    "format": "MSG",
    "tooltip": "notification center",
    "interval": "once",
    "on-click": "swaync-client -t -sw"
  },
  "hyprland/workspaces": {
    "format": "{name}",
    "disable-scroll": true
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 42
  },
  "clock": {
    "format": "{:%Y-%b-%d %H:%M}",
    "tooltip": false
  },
  "battery": {
    "format": "BAT {capacity}",
    "format-charging": "BAT+ {capacity}",
    "format-plugged": "AC {capacity}",
    "format-critical": "BAT CRIT {capacity}"
  },
  "network": {
    "format-wifi": "WIFI {essid}",
    "format-ethernet": "WIRED",
    "format-disconnected": "WIFI OFF",
    "tooltip": "click: pick a network",
    "on-click": "cicada-run org.cicada.wifi -- cicada-wifi"
  },
  "pulseaudio": {
    "format": "VOL {volume}",
    "format-muted": "MUTED",
    "on-click": "cicada-settings sound",
    "on-click-right": "pamixer -t",
    "on-scroll-up": "pamixer -i 5",
    "on-scroll-down": "pamixer -d 5"
  },
  "backlight": {
    "format": "BRI {percent}",
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-",
    "on-click": "cicada-settings brightness"
  },
}
