{
  "layer": "top",
  "position": "top",
  "height": 38,
  "spacing": 0,
  "modules-left": ["custom/cicada", "custom/term", "custom/web", "custom/files", "custom/settings", "hyprland/workspaces", "custom/profile", "hyprland/window"],
  "modules-center": ["group/magi"],
  "modules-right": ["custom/close", "custom/swaync", "group/sys", "custom/zulu", "clock"],

  // MAGI-01 gauges. Telemetry is a bordered panel with an inverted label tab,
  // the same construction the lock and the pattern bay use — see docs/DESIGN.md.
  "group/magi": {
    "orientation": "inline",
    "modules": ["custom/magi-tab", "cpu", "custom/gpu", "memory", "custom/temp"]
  },
  "group/sys": {
    "orientation": "inline",
    "modules": ["custom/sys-tab", "network", "pulseaudio", "backlight", "battery"]
  },

  "custom/magi-tab": {
    "format": "MAGI-01",
    "tooltip": false,
    "interval": "once"
  },
  "custom/sys-tab": {
    "format": "SYS",
    "tooltip": false,
    "interval": "once"
  },

  "cpu": {
    "format": "CPU {usage}",
    "interval": 2,
    "states": { "hot": 85 },
    "tooltip": false
  },
  "memory": {
    "format": "MEM {percentage}",
    "interval": 2,
    "states": { "hot": 90 },
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
  },
  // JSON so the number and the caveat about what it measures travel together.
  "custom/gpu": {
    "exec": "cicada-telemetry gpu-json",
    "exec-if": "command -v cicada-telemetry",
    "return-type": "json",
    "interval": 2,
    "format": "GPU {}"
  },
  // hwmon indexes are assigned in probe order and are not stable across boots.
  // cicada-telemetry matches on driver name instead, so this works on the MBA
  // prototype and on AMD desktops without per-machine edits.
  "custom/temp": {
    "exec": "cicada-telemetry temp-json",
    "exec-if": "command -v cicada-telemetry",
    "return-type": "json",
    "interval": 5,
    "format": "TMP {}°",
    "tooltip": false
  },
  "custom/zulu": {
    "exec": "cicada-telemetry zulu",
    "exec-if": "command -v cicada-telemetry",
    "interval": 20,
    "format": "{}",
    "tooltip": false
  },

  "custom/cicada": {
    "format": "CICADA",
    "tooltip": "click: launcher (Cicada apps only)",
    "interval": "once",
    "on-click": "cicada-wofi"
  },
  "custom/term": {
    "format": "TERM",
    "tooltip": "Kitty (owner shell)",
    "interval": "once",
    "on-click": "cicada-run org.cicada.kitty -- kitty"
  },
  "custom/web": {
    "format": "WEB",
    "tooltip": "Helium",
    "interval": "once",
    "on-click": "/usr/local/bin/chromium"
  },
  "custom/files": {
    "format": "FILES",
    "tooltip": "Files (sandboxed)",
    "interval": "once",
    "on-click": "cicada-files"
  },
  "custom/settings": {
    "format": "SETTINGS",
    "tooltip": "Wi-Fi, sound, scopes, profiles, dock, lock",
    "interval": "once",
    "on-click": "cicada-run org.cicada.settings -- cicada-settings"
  },
  "custom/close": {
    "format": "CLOSE",
    "tooltip": "Close the focused window (also Alt+F4)",
    "interval": "once",
    "on-click": "hyprctl dispatch killactive"
  },
  "custom/profile": {
    "exec": "cicada-profile list 2>/dev/null | head -1 | tr '[:lower:]' '[:upper:]'",
    "format": "USR {}",
    "interval": 10,
    "tooltip": false
  },
  "custom/swaync": {
    "format": "MSG",
    "tooltip": "notification center",
    "interval": "once",
    "on-click": "swaync-client -t -sw"
  },
  "hyprland/workspaces": {
    "format": "{name}",
    "disable-scroll": true
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 32
  },
  "clock": {
    "format": "{:%Y-%b-%d %H:%M}",
    "tooltip-format": "<tt>{:%Y-%m-%d %H:%M:%S %Z}</tt>"
  },
  "battery": {
    // Without states, waybar never assigns the .critical class, so both
    // format-critical below and #battery.critical in style.css are dead text —
    // the bar reads "BAT 4" in calm amber right up to the shutdown.
    "states": { "warning": 25, "critical": 12 },
    "format": "BAT {capacity}",
    "format-charging": "BAT+ {capacity}",
    "format-plugged": "AC {capacity}",
    "format-warning": "BAT LOW {capacity}",
    "format-critical": "BAT CRIT {capacity}",
    // Waybar resolves format-{state}-{status} before format-{state}, so without
    // these two a charging pack at 8% would still shout CRIT. On the wall it is
    // not an emergency — say so.
    "format-warning-charging": "BAT+ {capacity}",
    "format-critical-charging": "BAT+ {capacity}"
  },
  "network": {
    "format-wifi": "WIFI {essid}",
    "format-ethernet": "WIRED",
    "format-disconnected": "WIFI OFF",
    "tooltip": "click: pick a network",
    "on-click": "cicada-run org.cicada.wifi -- cicada-wifi"
  },
  "pulseaudio": {
    "format": "VOL {volume}",
    "format-muted": "MUTED",
    "on-click": "cicada-settings sound",
    "on-click-right": "pamixer -t",
    "on-scroll-up": "pamixer -i 5",
    "on-scroll-down": "pamixer -d 5"
  },
  "backlight": {
    "format": "BRI {percent}",
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-",
    "on-click": "cicada-settings brightness"
  }
}
