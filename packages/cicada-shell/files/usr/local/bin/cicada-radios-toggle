#!/usr/bin/env bash
# Keep rfkill and NetworkManager radio in the same state.
set -euo pipefail
wifi_soft=$(rfkill list wifi 2>/dev/null | grep -c "Soft blocked: yes" || true)
wifi_soft="${wifi_soft:-0}"
if [[ "${wifi_soft}" -gt 0 ]]; then
  rfkill unblock wifi 2>/dev/null || true
  rfkill unblock bluetooth 2>/dev/null || true
  nmcli radio wifi on >/dev/null 2>&1 || true
  cicada-seal append rf.unblock "{}" >/dev/null 2>&1 || true
  notify-send "Cicada" "Wi-Fi unblocked" 2>/dev/null || true
else
  nmcli radio wifi off >/dev/null 2>&1 || true
  rfkill block wifi 2>/dev/null || true
  rfkill block bluetooth 2>/dev/null || true
  cicada-seal append rf.block "{}" >/dev/null 2>&1 || true
  notify-send "Cicada" "Wi-Fi blocked" 2>/dev/null || true
fi
