#!/usr/bin/env bash
# Cicada Scopes — Graphene-shaped permission panel (store + UX).
# Enforcement is cicada-run on every sandboxed launch.
# User files can only tighten system floors under /usr/share/cicada/scopes.
set -euo pipefail

STORE="${CICADA_SCOPES_ROOT:-$HOME/.local/share/cicada/scopes}"
STORE_SYS="/usr/share/cicada/scopes"
mkdir -p "${STORE}"

# Boxed apps only. Owner shell (Kitty) is host/adb — not in this sheet.
APPS=(
  "org.cicada.helium|HELIUM|browser"
  "org.keepassxc.KeePassXC|KEEPASSXC|secrets"
  "org.cicada.files|FILES|files"
)

defaults_for() {
  case "$1" in
    org.keepassxc.KeePassXC)
      printf 'NETWORK=deny\nFILES=portal\nCAMERA=deny\nMIC=deny\nUSB=deny\nSENSORS=deny\n'
      ;;
    org.cicada.files)
      printf 'NETWORK=deny\nFILES=allow\nCAMERA=deny\nMIC=deny\nUSB=deny\nSENSORS=deny\n'
      ;;
    org.cicada.helium)
      printf 'NETWORK=allow\nFILES=portal\nCAMERA=deny\nMIC=deny\nUSB=deny\nSENSORS=deny\n'
      ;;
    *)
      printf 'NETWORK=deny\nFILES=deny\nCAMERA=deny\nMIC=deny\nUSB=deny\nSENSORS=deny\n'
      ;;
  esac
}

_load_sys_floor() {
  local id="$1"
  SYS_NETWORK=allow SYS_FILES=allow SYS_CAMERA=allow SYS_MIC=allow SYS_USB=allow SYS_SENSORS=allow
  if [[ -f "${STORE_SYS}/${id}.env" ]]; then
    # shellcheck disable=SC1090
    # Isolate: do not clobber the in-memory user values we are about to clamp.
    local NETWORK=deny FILES=deny CAMERA=deny MIC=deny USB=deny SENSORS=deny
    source "${STORE_SYS}/${id}.env"
    SYS_NETWORK="${NETWORK:-deny}" SYS_FILES="${FILES:-deny}"
    SYS_CAMERA="${CAMERA:-deny}" SYS_MIC="${MIC:-deny}"
    SYS_USB="${USB:-deny}" SYS_SENSORS="${SENSORS:-deny}"
  fi
}

_net_rank() {
  case "$1" in deny) echo 0 ;; tor) echo 1 ;; vpn-only) echo 2 ;; *) echo 3 ;; esac
}

_files_rank() {
  case "$1" in deny) echo 0 ;; portal) echo 1 ;; *) echo 2 ;; esac
}

# Reject a proposed value that is looser than the system floor.
_clamp_net() {
  local want="$1" floor="$2"
  if [[ "$(_net_rank "${want}")" -gt "$(_net_rank "${floor}")" ]]; then
    echo "${floor}"
  else
    echo "${want}"
  fi
}

_clamp_files() {
  local want="$1" floor="$2"
  if [[ "$(_files_rank "${want}")" -gt "$(_files_rank "${floor}")" ]]; then
    echo "${floor}"
  else
    echo "${want}"
  fi
}

_clamp_flag() {
  local want="$1" floor="$2"
  if [[ "${floor}" != "allow" ]]; then echo deny; else echo "${want}"; fi
}

ensure_app() {
  local id="$1"
  local f="${STORE}/${id}.env"
  if [[ ! -f "${f}" ]]; then
    if [[ -f "${STORE_SYS}/${id}.env" ]]; then
      cp -a "${STORE_SYS}/${id}.env" "${f}"
    else
      defaults_for "${id}" >"${f}"
    fi
  fi
}

load() {
  # shellcheck disable=SC1090
  source "${STORE}/${1}.env"
}

save() {
  local id="$1"
  _load_sys_floor "${id}"
  NETWORK="$(_clamp_net "${NETWORK}" "${SYS_NETWORK}")"
  FILES="$(_clamp_files "${FILES}" "${SYS_FILES}")"
  CAMERA="$(_clamp_flag "${CAMERA}" "${SYS_CAMERA}")"
  MIC="$(_clamp_flag "${MIC}" "${SYS_MIC}")"
  USB="$(_clamp_flag "${USB}" "${SYS_USB}")"
  SENSORS="$(_clamp_flag "${SENSORS}" "${SYS_SENSORS}")"
  cat >"${STORE}/${id}.env" <<EOF
NETWORK=${NETWORK}
FILES=${FILES}
CAMERA=${CAMERA}
MIC=${MIC}
USB=${USB}
SENSORS=${SENSORS}
EOF
}

cell() {
  local v="$1"
  case "${v}" in
    allow|portal|vpn-only) printf '\033[32m%-8s\033[0m' "${v}" ;;
    *) printf '\033[31m%-8s\033[0m' "${v}" ;;
  esac
}

draw() {
  clear
  cat <<'HDR'
╔══════════════════════════════════════════════════════════════╗
║  CICADA // MAGI-02            SCOPES                         ║
║  per-app permissions · deny looks like "down" not crash      ║
║  KITTY = host/adb (not boxed — toggle sheet does not apply)  ║
║  system floors win — you can only tighten                    ║
╚══════════════════════════════════════════════════════════════╝
HDR
  printf '  %-12s %-8s %-8s %-8s %-8s %-8s %-8s\n' \
    APP NET FILES CAM MIC USB SENS
  printf '  %s\n' "----------------------------------------------------------------"
  local entry id label
  for entry in "${APPS[@]}"; do
    id="${entry%%|*}"
    label="${entry#*|}"
    label="${label%%|*}"
    ensure_app "${id}"
    load "${id}"
    printf '  %-12s ' "${label}"
    cell "${NETWORK}"; printf ' '
    cell "${FILES}"; printf ' '
    cell "${CAMERA}"; printf ' '
    cell "${MIC}"; printf ' '
    cell "${USB}"; printf ' '
    cell "${SENSORS}"
    printf '\n'
  done
  cat <<'FTR'

  [1] HELIUM   [2] KEEPASSXC   [3] FILES
  toggle:  n net   f files   c camera   m mic   u usb   s sensors
  q quit   (enforced by cicada-run on launch)
  vpn-only = host net only while wg0 + killswitch are up

FTR
}

cycle() {
  local cur="$1" kind="$2"
  case "${kind}" in
    NETWORK)
      case "${cur}" in deny) echo allow ;; allow) echo vpn-only ;; *) echo deny ;; esac
      ;;
    FILES)
      case "${cur}" in deny) echo portal ;; portal) echo allow ;; *) echo deny ;; esac
      ;;
    *)
      case "${cur}" in deny) echo allow ;; *) echo deny ;; esac
      ;;
  esac
}

selected=0
ensure_app org.cicada.helium
ensure_app org.keepassxc.KeePassXC
ensure_app org.cicada.files

while true; do
  draw
  id="$(cut -d'|' -f1 <<<"${APPS[${selected}]}")"
  load "${id}"
  printf '  MAGI lock on: %s > ' "${id}"
  read -r -n 1 key || true
  printf '\n'
  case "${key}" in
    1) selected=0 ;;
    2) selected=1 ;;
    3) selected=2 ;;
    n) NETWORK="$(cycle "${NETWORK}" NETWORK)"; save "${id}" ;;
    f) FILES="$(cycle "${FILES}" FILES)"; save "${id}" ;;
    c) CAMERA="$(cycle "${CAMERA}" OTHER)"; save "${id}" ;;
    m) MIC="$(cycle "${MIC}" OTHER)"; save "${id}" ;;
    u) USB="$(cycle "${USB}" OTHER)"; save "${id}" ;;
    s) SENSORS="$(cycle "${SENSORS}" OTHER)"; save "${id}" ;;
    q|Q) exit 0 ;;
  esac
done
