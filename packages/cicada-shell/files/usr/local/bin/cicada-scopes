#!/usr/bin/env bash
# Cicada Scopes — Graphene-shaped permission panel (store + UX).
# Enforcement is cicada-run (later). This is the MAGI sheet.
set -euo pipefail

STORE="${CICADA_SCOPES_ROOT:-$HOME/.local/share/cicada/scopes}"
mkdir -p "${STORE}"

APPS=(
  "org.cicada.helium|HELIUM|browser"
  "org.keepassxc.KeePassXC|KEEPASSXC|secrets"
  "org.cicada.kitty|KITTY|terminal"
)

DEFAULTS='NETWORK=deny
FILES=portal
CAMERA=deny
MIC=deny
USB=deny
SENSORS=deny'

ensure_app() {
  local id="$1"
  local f="${STORE}/${id}.env"
  if [[ ! -f "${f}" ]]; then
    printf '%s\n' "${DEFAULTS}" >"${f}"
  fi
}

load() {
  # shellcheck disable=SC1090
  source "${STORE}/${1}.env"
}

save() {
  local id="$1"
  cat >"${STORE}/${id}.env" <<EOF
NETWORK=${NETWORK}
FILES=${FILES}
CAMERA=${CAMERA}
MIC=${MIC}
USB=${USB}
SENSORS=${SENSORS}
EOF
}

cell() {
  local v="$1"
  case "${v}" in
    allow|portal|vpn-only) printf '\033[32m%-8s\033[0m' "${v}" ;;
    *) printf '\033[31m%-8s\033[0m' "${v}" ;;
  esac
}

draw() {
  clear
  cat <<'HDR'
╔══════════════════════════════════════════════════════════════╗
║  CICADA // MAGI-02            SCOPES                         ║
║  per-app permissions · deny looks like "down" not crash      ║
╚══════════════════════════════════════════════════════════════╝
HDR
  printf '  %-12s %-8s %-8s %-8s %-8s %-8s %-8s\n' \
    APP NET FILES CAM MIC USB SENS
  printf '  %s\n' "----------------------------------------------------------------"
  local entry id label
  for entry in "${APPS[@]}"; do
    id="${entry%%|*}"
    label="${entry#*|}"
    label="${label%%|*}"
    ensure_app "${id}"
    load "${id}"
    printf '  %-12s ' "${label}"
    cell "${NETWORK}"; printf ' '
    cell "${FILES}"; printf ' '
    cell "${CAMERA}"; printf ' '
    cell "${MIC}"; printf ' '
    cell "${USB}"; printf ' '
    cell "${SENSORS}"
    printf '\n'
  done
  cat <<'FTR'

  [1] HELIUM   [2] KEEPASSXC   [3] KITTY
  toggle:  n net   f files   c camera   m mic   u usb   s sensors
  q quit   (enforced by cicada-run on launch)

FTR
}

cycle() {
  local cur="$1" kind="$2"
  case "${kind}" in
    NETWORK)
      case "${cur}" in deny) echo allow ;; allow) echo vpn-only ;; *) echo deny ;; esac
      ;;
    FILES)
      case "${cur}" in deny) echo portal ;; portal) echo allow ;; *) echo deny ;; esac
      ;;
    *)
      case "${cur}" in deny) echo allow ;; *) echo deny ;; esac
      ;;
  esac
}

selected=0
ensure_app org.cicada.helium
ensure_app org.keepassxc.KeePassXC
ensure_app org.cicada.kitty

while true; do
  draw
  id="$(cut -d'|' -f1 <<<"${APPS[${selected}]}")"
  load "${id}"
  printf '  MAGI lock on: %s > ' "${id}"
  read -r -n 1 key || true
  printf '\n'
  case "${key}" in
    1) selected=0 ;;
    2) selected=1 ;;
    3) selected=2 ;;
    n) NETWORK="$(cycle "${NETWORK}" NETWORK)"; save "${id}" ;;
    f) FILES="$(cycle "${FILES}" FILES)"; save "${id}" ;;
    c) CAMERA="$(cycle "${CAMERA}" OTHER)"; save "${id}" ;;
    m) MIC="$(cycle "${MIC}" OTHER)"; save "${id}" ;;
    u) USB="$(cycle "${USB}" OTHER)"; save "${id}" ;;
    s) SENSORS="$(cycle "${SENSORS}" OTHER)"; save "${id}" ;;
    q|Q) exit 0 ;;
  esac
done
