#!/usr/bin/env bash
# Optional session: niri (scrollable tiling). Product name stays Cicada.
set -euo pipefail
export XDG_CURRENT_DESKTOP=Cicada:Cicada.OS
export XDG_SESSION_DESKTOP=Cicada
export XDG_SESSION_TYPE=wayland
export DESKTOP_SESSION=cicada-niri
command -v niri >/dev/null 2>&1 || {
  echo "cicada-session-niri: install the niri package first (Settings → Desktop session)." >&2
  exit 1
}
exec niri "$@"
