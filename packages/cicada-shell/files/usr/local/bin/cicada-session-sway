#!/usr/bin/env bash
# Optional session: Sway (tiling, minimal). Product name stays Cicada.
set -euo pipefail
export XDG_CURRENT_DESKTOP=Cicada:Cicada.OS
export XDG_SESSION_DESKTOP=Cicada
export XDG_SESSION_TYPE=wayland
export DESKTOP_SESSION=cicada-sway
command -v sway >/dev/null 2>&1 || {
  echo "cicada-session-sway: install the sway package first (Settings → Desktop session)." >&2
  exit 1
}
# Prefer Cicada sway config when present.
conf="${HOME}/.config/cicada/sway/config"
if [[ -f "${conf}" ]]; then
  exec sway -c "${conf}" "$@"
fi
exec sway "$@"
