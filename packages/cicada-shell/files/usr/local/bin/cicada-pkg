#!/usr/bin/env bash
# Install software — Tirimid item 4 + daily apps.
# Paths: curated Arch packages, free-form official pacman (password), or Flatpak allowlist.
set -euo pipefail

die() {
  echo "cicada-pkg: $1" >&2
  zenity --error --title="Install software" --width=440 --text="$1" 2>/dev/null || true
  exit 1
}

command -v zenity >/dev/null 2>&1 || die "zenity missing"
HELPER=/usr/local/bin/cicada-pkg-helper
[[ -x "${HELPER}" ]] || die "cicada-pkg-helper missing"

run_helper() {
  if command -v pkexec >/dev/null 2>&1; then
    pkexec "${HELPER}" "$@"
  else
    sudo "${HELPER}" "$@"
  fi
}

pick="$(zenity --list --title="Install software" \
  --text="Curated apps (password once), or any official Arch package.
No AUR. Needs Wi-Fi." \
  --column=Kind --column=Does --print-column=1 --hide-header \
  --width=560 --height=420 \
  "Curated Arch…" "htop, git, code, python, …" \
  "Any Arch package…" "official repo name (extra confirm)" \
  "Spotify" "Flatpak — music (home denied)" \
  "Discord" "Flatpak — chat (home denied)" \
  "Signal" "Flatpak — messenger (home denied)" \
  "SimpleX" "Flatpak — messenger, no account or phone number" \
  "Element" "Flatpak — Matrix client (read docs/COMMS.md first)" \
  "Telegram" "Flatpak — messenger (home denied)" \
  "VLC" "Flatpak — video (home denied)" \
  "LibreOffice" "Flatpak — documents (home denied)" \
  2>/dev/null)" || exit 0

flatpak_install() {
  local app_id="$1" name="$2"
  command -v flatpak >/dev/null 2>&1 || die "flatpak is not installed on this image"
  zenity --question --title="Install ${name}?" \
    --text="Install «${name}» from Flathub (${app_id})?

Cicada will deny full home access after install (Downloads only, plus what the app needs).
Needs network and your password." \
    --ok-label="Install" --cancel-label="Cancel" 2>/dev/null || exit 0
  run_helper flatpak-remote \
    && run_helper flatpak-install "${app_id}" \
    || die "Could not install ${name}. Check Wi-Fi / password."

  # Messengers get one extra sentence, because the default install leaves the
  # message store in the real home where full-disk encryption is the only thing
  # protecting it — i.e. nothing, on a laptop that is already unlocked.
  local extra=""
  case "${app_id}" in
    org.signal.Signal|chat.simplex.simplex|im.riot.Riot|org.telegram.desktop|com.discordapp.Discord)
      extra="

Message history is stored in your home directory, so it is at rest only when
this laptop is off. To put it inside an encrypted profile instead:
  cicada-comms status
  cicada-comms bind <app> <profile>"
      ;;
  esac
  zenity --info --title="Install software" \
    --text="Installed: ${name}\n\nOpen from the app menu or:\n  flatpak run ${app_id}${extra}" 2>/dev/null || true
}

case "${pick}" in
  "Curated Arch…")
    pkg="$(zenity --list --title="Curated Arch packages" \
      --text="One-click curated list (still needs your password)." \
      --column=Package --column=Why --print-column=1 --hide-header \
      --width=520 --height=400 \
      htop "process viewer" \
      git "version control" \
      code "VS Code (official Arch)" \
      python "Python runtime" \
      python-pip "pip" \
      base-devel "gcc/make toolchain" \
      curl "HTTP CLI" \
      jq "JSON CLI" \
      gimp "image editor" \
      mpv "video player" \
      keepassxc "password manager (also on ISO)" \
      cowsay "hello Tirimid" \
      2>/dev/null)" || exit 0
    [[ -n "${pkg}" ]] || exit 0
    zenity --question --title="Install ${pkg}?" \
      --text="Install curated package «${pkg}»?

Needs your password (admin install)." \
      --ok-label="Install" --cancel-label="Cancel" 2>/dev/null || exit 0
    run_helper install "${pkg}" \
      && zenity --info --title="Install software" --text="Installed: ${pkg}" 2>/dev/null \
      || die "Could not install ${pkg}. Check Wi-Fi and password."
    ;;
  "Any Arch package…")
    pkg="$(zenity --entry --title="Arch package" \
      --text="Official package name only (no AUR).

Not on the curated list — still installable with your password.
Examples: btop  ripgrep  docker" \
      --entry-text="" 2>/dev/null)" || exit 0
    pkg="$(echo "${pkg}" | tr -d '[:space:]')"
    [[ -n "${pkg}" ]] || exit 0
    if ! [[ "${pkg}" =~ ^[a-zA-Z0-9@._+-]+$ ]]; then
      die "Invalid package name: ${pkg}"
    fi
    zenity --question --title="Install ${pkg}?" \
      --text="Install «${pkg}» from official Arch repos?

This is outside the curated list. Prefer Curated Arch… when you can.
Needs your password." \
      --ok-label="Install" --cancel-label="Cancel" 2>/dev/null || exit 0
    run_helper install-any "${pkg}" \
      && zenity --info --title="Install software" --text="Installed: ${pkg}" 2>/dev/null \
      || die "Could not install ${pkg}. Check Wi-Fi, the name, and password."
    ;;
  Spotify) flatpak_install com.spotify.Client Spotify ;;
  Discord) flatpak_install com.discordapp.Discord Discord ;;
  Signal) flatpak_install org.signal.Signal Signal ;;
  SimpleX) flatpak_install chat.simplex.simplex SimpleX ;;
  Element) flatpak_install im.riot.Riot Element ;;
  Telegram) flatpak_install org.telegram.desktop Telegram ;;
  VLC) flatpak_install org.videolan.VLC VLC ;;
  LibreOffice) flatpak_install org.libreoffice.LibreOffice LibreOffice ;;
  *) exit 0 ;;
esac
