#!/usr/bin/env bash
# Install a package from official Arch repos — Tirimid item 4.
# GUI front-end; real work is cicada-pkg-helper (root, NOPASSWD).
set -euo pipefail

die() {
  echo "cicada-pkg: $1" >&2
  zenity --error --title="Install software" --width=420 --text="$1" 2>/dev/null || true
  exit 1
}

command -v zenity >/dev/null 2>&1 || die "zenity missing"
[[ -x /usr/local/bin/cicada-pkg-helper ]] || die "cicada-pkg-helper missing"

pkg="$(zenity --entry --title="Install software" \
  --text="Official Arch package name only (no AUR).

Examples: htop  cowsay  nano  git" \
  --entry-text="" 2>/dev/null)" || exit 0
pkg="$(echo "${pkg}" | tr -d '[:space:]')"
[[ -n "${pkg}" ]] || exit 0

if ! [[ "${pkg}" =~ ^[a-zA-Z0-9@._+-]+$ ]]; then
  die "Invalid package name: ${pkg}"
fi

zenity --question --title="Install ${pkg}?" \
  --text="Install «${pkg}» from official repos with pacman?

This needs network (Wi-Fi) and may take a minute." \
  --ok-label="Install" --cancel-label="Cancel" 2>/dev/null || exit 0

(
  echo "10"
  echo "# Resolving ${pkg}…"
  if sudo -n /usr/local/bin/cicada-pkg-helper install "${pkg}"; then
    echo "100"
    echo "# Done"
  else
    echo "100"
    echo "# Failed"
    exit 1
  fi
) | zenity --progress --title="Installing ${pkg}" --percentage=0 --auto-close --width=420 2>/dev/null \
  && zenity --info --title="Install software" --text="Installed: ${pkg}" 2>/dev/null \
  || die "Could not install ${pkg}. Check Wi-Fi and the package name."
