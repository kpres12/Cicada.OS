#!/usr/bin/env bash
# Cicada.OS session — default product desk (compositor is an implementation detail).
set -euo pipefail
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-Cicada:Cicada.OS}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-Cicada}"
export XDG_SESSION_TYPE=wayland
export DESKTOP_SESSION=cicada
exec Hyprland "$@"
