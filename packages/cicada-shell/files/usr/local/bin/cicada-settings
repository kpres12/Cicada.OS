#!/usr/bin/env bash
# Daily-driver settings. Cicada owns the click path — no dump into a foreign app.
set -euo pipefail
DIR="${HOME}/.config/cicada"
mkdir -p "${DIR}"
POS_FILE="${DIR}/dock-position"
MON_FILE="${HOME}/.config/hypr/monitors.conf"
PCMAN_CONF="${HOME}/.config/pcmanfm-qt/default/settings.conf"

restart_dock() {
  printf '%s\n' "$1" > "${POS_FILE}"
  pkill -x nwg-dock-hyprland 2>/dev/null || true
  cicada-dock &
}

brightness() {
  local max cur pct
  max="$(brightnessctl m 2>/dev/null || echo 100)"
  cur="$(brightnessctl g 2>/dev/null || echo 50)"
  [[ "${max}" -gt 0 ]] || max=100
  pct=$((cur * 100 / max))
  [[ "${pct}" -lt 5 ]] && pct=5
  pct="$(zenity --scale --title="Brightness" --text="Display brightness" \
    --min-value=5 --max-value=100 --value="${pct}" --step=5)" || return 0
  brightnessctl set "${pct}%"
}

sound() {
  local vol muted mute_lbl pick pct sink
  vol="$(pamixer --get-volume 2>/dev/null || echo 50)"
  muted="$(pamixer --get-mute 2>/dev/null || echo false)"
  mute_lbl="Mute"
  extra=""
  if [[ "${muted}" == "true" ]]; then
    mute_lbl="Unmute"
    extra=" (muted)"
  fi
  pick="$(zenity --list --title="Sound" \
    --text="Volume ${vol}%${extra}" \
    --column=Setting --column=Does --print-column=1 --hide-header \
    --width=460 --height=280 \
    "Volume" "Set the level" \
    "${mute_lbl}" "Toggle mute" \
    "Output" "Speakers or headphones" \
    2>/dev/null)" || return 0
  case "${pick}" in
    Volume)
      pct="$(zenity --scale --title="Volume" --text="Output volume" \
        --min-value=0 --max-value=100 --value="${vol}" --step=5)" || return 0
      pamixer --unmute
      pamixer --set-volume "${pct}"
      ;;
    Mute|Unmute)
      pamixer -t
      ;;
    Output)
      mapfile -t rows < <(pactl list sinks 2>/dev/null | awk -F': ' '
        /^Sink / { n=""; d="" }
        /Name:/ { n=$2 }
        /Description:/ { d=$2; if (n != "") print n "\t" d }
      ')
      if [[ "${#rows[@]}" -eq 0 ]]; then
        zenity --info --title="Sound" --text="No audio outputs found." 2>/dev/null || true
        return 0
      fi
      local args=()
      local line name desc
      for line in "${rows[@]}"; do
        name="${line%%$'\t'*}"
        desc="${line#*$'\t'}"
        args+=("${name}" "${desc}")
      done
      sink="$(zenity --list --title="Sound" --text="Play sound through" \
        --column=id --column=Output --hide-column=1 --print-column=1 \
        --width=480 --height=320 \
        "${args[@]}" 2>/dev/null)" || return 0
      [[ -n "${sink}" ]] || return 0
      pactl set-default-sink "${sink}" 2>/dev/null || true
      pamixer --unmute
      ;;
  esac
}

displays() {
  local pick scale name
  name="$(hyprctl monitors 2>/dev/null | awk '/^Monitor /{print $2; exit}')"
  [[ -n "${name}" ]] || name=""
  pick="$(zenity --list --title="Displays" \
    --text="This Air has one panel. Pick a scale if text looks tiny or huge." \
    --column=Setting --column=Does --print-column=1 --hide-header \
    --width=480 --height=320 \
    "100%" "Native pixels" \
    "125%" "Slightly larger" \
    "150%" "Larger UI" \
    "200%" "Largest" \
    2>/dev/null)" || return 0
  case "${pick}" in
    "100%") scale=1 ;;
    "125%") scale=1.25 ;;
    "150%") scale=1.5 ;;
    "200%") scale=2 ;;
    *) return 0 ;;
  esac
  mkdir -p "$(dirname "${MON_FILE}")"
  if [[ -n "${name}" ]]; then
    printf 'monitor=%s,preferred,auto,%s\n' "${name}" "${scale}" > "${MON_FILE}"
    hyprctl keyword monitor "${name},preferred,auto,${scale}" >/dev/null 2>&1 || true
  else
    printf 'monitor=,preferred,auto,%s\n' "${scale}" > "${MON_FILE}"
  fi
}

set_gtk_key() {
  local file="$1" key="$2" value="$3"
  mkdir -p "$(dirname "${file}")"
  if [[ -f "${file}" ]] && grep -q "^${key}=" "${file}"; then
    sed -i "s|^${key}=.*|${key}=${value}|" "${file}"
  else
    [[ -f "${file}" ]] || printf '[Settings]\n' > "${file}"
    printf '%s=%s\n' "${key}" "${value}" >> "${file}"
  fi
}

appearance() {
  local pick size img stock
  pick="$(zenity --list --title="Appearance" \
    --text="Theme, desktop icons, wallpaper. Changes apply to this session." \
    --column=Setting --column=Does --print-column=1 --hide-header \
    --width=520 --height=400 \
    "Wallpaper…" "Pick an image (saved under Pictures)" \
    "Stock wallpaper" "Cicada default from /usr/share/cicada/wallpapers" \
    "Dark" "Black / amber (default)" \
    "Light" "Adwaita light" \
    "Icons small" "Desktop icons 48px" \
    "Icons medium" "Desktop icons 56px" \
    "Icons large" "Desktop icons 72px" \
    2>/dev/null)" || return 0
  case "${pick}" in
    "Wallpaper…")
      mkdir -p "${HOME}/Pictures"
      img="$(zenity --file-selection --title="Wallpaper" \
        --filename="${HOME}/Pictures/" \
        --file-filter="Images | *.png *.jpg *.jpeg *.webp *.PNG *.JPG *.JPEG *.WEBP" \
        2>/dev/null)" || return 0
      apply_wallpaper "${img}"
      ;;
    "Stock wallpaper")
      stock="$(zenity --file-selection --title="Stock wallpaper" \
        --filename="/usr/share/cicada/wallpapers/" \
        --file-filter="Images | *.png *.jpg *.jpeg *.webp" \
        2>/dev/null)" || return 0
      apply_wallpaper "${stock}"
      ;;
    Dark)
      set_gtk_key "${HOME}/.config/gtk-3.0/settings.ini" gtk-theme-name Adwaita-dark
      set_gtk_key "${HOME}/.config/gtk-3.0/settings.ini" gtk-application-prefer-dark-theme 1
      set_gtk_key "${HOME}/.config/gtk-4.0/settings.ini" gtk-theme-name Adwaita-dark
      set_gtk_key "${HOME}/.config/gtk-4.0/settings.ini" gtk-application-prefer-dark-theme 1
      mkdir -p "${HOME}/.config/qt6ct"
      if [[ -f "${HOME}/.config/qt6ct/qt6ct.conf" ]]; then
        grep -q '^color_scheme_path=' "${HOME}/.config/qt6ct/qt6ct.conf" \
          && sed -i 's|^color_scheme_path=.*|color_scheme_path=/usr/share/cicada/qt6ct/cicada-dark.conf|' "${HOME}/.config/qt6ct/qt6ct.conf" \
          || printf 'color_scheme_path=/usr/share/cicada/qt6ct/cicada-dark.conf\n' >> "${HOME}/.config/qt6ct/qt6ct.conf"
      fi
      ;;
    Light)
      set_gtk_key "${HOME}/.config/gtk-3.0/settings.ini" gtk-theme-name Adwaita
      set_gtk_key "${HOME}/.config/gtk-3.0/settings.ini" gtk-application-prefer-dark-theme 0
      set_gtk_key "${HOME}/.config/gtk-4.0/settings.ini" gtk-theme-name Adwaita
      set_gtk_key "${HOME}/.config/gtk-4.0/settings.ini" gtk-application-prefer-dark-theme 0
      mkdir -p "${HOME}/.config/qt6ct"
      if [[ -f "${HOME}/.config/qt6ct/qt6ct.conf" ]]; then
        grep -q '^color_scheme_path=' "${HOME}/.config/qt6ct/qt6ct.conf" \
          && sed -i 's|^color_scheme_path=.*|color_scheme_path=/usr/share/cicada/qt6ct/cicada-light.conf|' "${HOME}/.config/qt6ct/qt6ct.conf" \
          || printf 'color_scheme_path=/usr/share/cicada/qt6ct/cicada-light.conf\n' >> "${HOME}/.config/qt6ct/qt6ct.conf"
      fi
      ;;
    "Icons small") size=48 ;;
    "Icons medium") size=56 ;;
    "Icons large") size=72 ;;
  esac
  if [[ -n "${size:-}" ]]; then
    mkdir -p "$(dirname "${PCMAN_CONF}")"
    if [[ -f "${PCMAN_CONF}" ]] && grep -q '^DesktopIconSize=' "${PCMAN_CONF}"; then
      sed -i "s|^DesktopIconSize=.*|DesktopIconSize=${size}|" "${PCMAN_CONF}"
    else
      printf '[Desktop]\nDesktopIconSize=%s\n' "${size}" >> "${PCMAN_CONF}"
    fi
    pkill -f '[p]cmanfm-qt --desktop' 2>/dev/null || true
    pcmanfm-qt --desktop >/dev/null 2>&1 &
  fi
}

apply_wallpaper() {
  local img="$1" paper conf lock
  [[ -f "${img}" ]] || { notify-send "Cicada" "Wallpaper file missing" 2>/dev/null || true; return 1; }
  mkdir -p "${HOME}/Pictures" "${HOME}/.config/hypr" "$(dirname "${PCMAN_CONF}")"
  # Keep a stable copy so sandboxed paths / USB mounts do not break the desk.
  paper="${HOME}/Pictures/cicada-wallpaper.${img##*.}"
  cp -f "${img}" "${paper}"
  conf="${HOME}/.config/hypr/hyprpaper.conf"
  cat > "${conf}" <<EOF
preload = ${paper}
wallpaper = ,${paper}
EOF
  # Desktop icons stay on a solid void layer; hyprpaper is the art plane.
  mkdir -p "$(dirname "${PCMAN_CONF}")"
  if [[ -f "${PCMAN_CONF}" ]]; then
    grep -q '^WallpaperMode=' "${PCMAN_CONF}" \
      && sed -i 's|^WallpaperMode=.*|WallpaperMode=color|' "${PCMAN_CONF}" \
      || printf 'WallpaperMode=color\n' >> "${PCMAN_CONF}"
    grep -q '^Wallpaper=' "${PCMAN_CONF}" \
      && sed -i 's|^Wallpaper=.*|Wallpaper=|' "${PCMAN_CONF}" \
      || true
    grep -q '^BgColor=' "${PCMAN_CONF}" \
      && sed -i 's|^BgColor=.*|BgColor=#000000|' "${PCMAN_CONF}" \
      || printf 'BgColor=#000000\n' >> "${PCMAN_CONF}"
  else
    printf '[Desktop]\nWallpaper=\nWallpaperMode=color\nBgColor=#000000\n' > "${PCMAN_CONF}"
  fi
  lock="${HOME}/.config/hypr/hyprlock.conf"
  if [[ -f "${lock}" ]]; then
    sed -i "s|^[[:space:]]*path = .*|    path = ${paper}|" "${lock}" 2>/dev/null || true
  fi
  pkill -x hyprpaper 2>/dev/null || true
  hyprpaper >/dev/null 2>&1 &
  pkill -f '[p]cmanfm-qt --desktop' 2>/dev/null || true
  pcmanfm-qt --desktop >/dev/null 2>&1 &
  notify-send "Cicada" "Wallpaper updated" 2>/dev/null || true
}

screenshot() {
  local out="${HOME}/Desktop/cicada-$(date +%Y%m%d-%H%M%S).png"
  if grim -g "$(slurp)" "${out}" 2>/dev/null; then
    notify-send "Screenshot" "${out}" 2>/dev/null || true
  fi
}

profiles() {
  local pick
  pick="$(zenity --list --title="Profiles" \
    --text="Work = second Unix UID (cicada-work). Burner = folder home for sandboxed apps only. Kitty stays Owner/adb." \
    --column=Action --column=Does --print-column=1 --hide-header \
    --width=600 --height=400 \
    "List" "Show profiles on this machine" \
    "Set Work password" "Unlock cicada-work login (created on install)" \
    "Login Work" "Open Hyprland as cicada-work (Ctrl+Alt+F3)" \
    "Create Work (UID)" "Manual create if missing" \
    "Create Burner" "Folder home for throwaway sandboxed apps" \
    "Switch Burner" "Next sandboxed apps use Burner HOME" \
    2>/dev/null)" || return 0
  case "${pick}" in
    List)
      cicada-profile list 2>/dev/null | zenity --text-info --title="Profiles" --width=480 --height=320 || true
      ;;
    "Set Work password")
      if id cicada-work >/dev/null 2>&1; then
        kitty --title CICADA-WORK-PASS -e bash -lc 'sudo passwd cicada-work; read -r -p "Enter…"'
      else
        zenity --error --text="cicada-work missing. Use Create Work (UID), or reboot once after install."
      fi
      ;;
    "Create Work (UID)")
      if zenity --question --title="Create Work" \
        --text="Creates Unix user cicada-work (no sudo). You will set its login password."; then
        kitty --title CICADA-PROFILE -e bash -lc 'cicada-profile create work --user; read -r -p "Enter…"'
      fi
      ;;
    "Login Work")
      if id cicada-work >/dev/null 2>&1; then
        cicada-profile login work || zenity --error --text="Set Work password first, or see terminal output."
      else
        zenity --error --text="Create Work first (or wait for installed firstboot)."
      fi
      ;;
    "Create Burner")
      cicada-profile create burner
      notify-send "Cicada" "Burner folder profile created (not Work)" 2>/dev/null || true
      ;;
    "Switch Burner")
      cicada-profile switch burner
      notify-send "Cicada" "Active Burner HOME for sandboxed apps" 2>/dev/null || true
      ;;
  esac
}

av_kill() {
  local pick st
  st="$(cicada-av-kill status 2>/dev/null || echo "camera: on"$'\n'"mic: on")"
  pick="$(zenity --list --title="Camera & microphone" \
    --text="Software kill. Blocks apps + unloads the camera driver. Not a hardware switch — root can reverse it."$'\n\n'"${st}" \
    --column=Action --column=Does --print-column=1 --hide-header \
    --width=560 --height=360 \
    "Status" "Show current kill state" \
    "Camera off" "Blacklist uvcvideo; no /dev/video*" \
    "Camera on" "Allow camera driver again" \
    "Mic off" "Mute capture; force MIC=deny for apps" \
    "Mic on" "Allow microphone again" \
    "Both off" "Camera + mic software kill" \
    "Both on" "Re-enable both" \
    2>/dev/null)" || return 0
  case "${pick}" in
    Status)
      cicada-av-kill status 2>/dev/null | zenity --text-info --title="Camera & microphone" --width=480 --height=200 || true
      ;;
    "Camera off") sudo -n cicada-av-kill camera off && notify-send "Cicada" "Camera off (software)" ;;
    "Camera on")  sudo -n cicada-av-kill camera on  && notify-send "Cicada" "Camera on" ;;
    "Mic off")    sudo -n cicada-av-kill mic off    && notify-send "Cicada" "Mic off (software)" ;;
    "Mic on")     sudo -n cicada-av-kill mic on     && notify-send "Cicada" "Mic on" ;;
    "Both off")   sudo -n cicada-av-kill both off   && notify-send "Cicada" "Camera + mic off" ;;
    "Both on")    sudo -n cicada-av-kill both on    && notify-send "Cicada" "Camera + mic on" ;;
  esac
}

case "${1:-}" in
  wifi|Wi-Fi) exec cicada-wifi ;;
  sound|Sound) sound; exit 0 ;;
  brightness|Brightness) brightness; exit 0 ;;
  displays|Displays) displays; exit 0 ;;
  appearance|Appearance) appearance; exit 0 ;;
  scopes|Scopes) exec cicada-run org.cicada.kitty -- kitty --title CICADA-SCOPES -e cicada-scopes ;;
  profiles|Profiles) profiles; exit 0 ;;
  av|camera|mic|"Camera & microphone") av_kill; exit 0 ;;
  lock|Lock) exec cicada-lock ;;
esac

pick="$(zenity --list --title="Settings" \
  --text="Click a row. Telemetry stays off. Unknown apps are default-deny." \
  --column=Setting --column=Does \
  --print-column=1 --hide-header \
  --width=560 --height=600 \
  "Wi-Fi" "Pick a network from a scan" \
  "Sound" "Volume, mute, headphones" \
  "Brightness" "Screen brightness" \
  "Displays" "How large the UI is" \
  "Appearance" "Wallpaper, dark/light, desktop icon size" \
  "App permissions" "Scopes — network/files/camera per app" \
  "Camera & microphone" "Software kill — not a hardware switch" \
  "Profiles" "Work (UID) / Burner (folder) compartments" \
  "Notifications" "Notification center" \
  "Dock left" "Keep the dock on the left" \
  "Dock bottom" "Move the dock to the bottom" \
  "Dock right" "Move the dock to the right" \
  "Lock" "Lock the screen now" \
  "Screenshot" "Select a region, save to Desktop" \
  "Start here" "First-boot cheat sheet" \
  2>/dev/null)" || exit 0

case "${pick}" in
  "Wi-Fi") exec cicada-wifi ;;
  Sound) sound ;;
  Brightness) brightness ;;
  Displays) displays ;;
  Appearance) appearance ;;
  "App permissions") exec cicada-run org.cicada.kitty -- kitty --title CICADA-SCOPES -e cicada-scopes ;;
  "Camera & microphone") av_kill ;;
  Profiles) profiles ;;
  Notifications) exec swaync-client -t -sw ;;
  "Dock left") restart_dock left ;;
  "Dock bottom") restart_dock bottom ;;
  "Dock right") restart_dock right ;;
  Lock) exec cicada-lock ;;
  Screenshot) screenshot ;;
  "Start here") exec cicada-run org.cicada.start -- kitty --title CICADA-START -e less /usr/share/cicada/FIRST-BOOT.txt ;;
esac
