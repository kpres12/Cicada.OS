# Tor Browser. NETWORK=allow on purpose.
#
# Tor Browser ships its own Tor daemon + bridges. Putting it in the system
# onion netns is Tor-over-Tor: first-run download fails, and you get a black
# window that does nothing. Anonymity here is Tor Browser's job, not cicada-run.
NETWORK=allow
FILES=portal
CAMERA=deny
MIC=deny
USB=deny
SENSORS=deny
