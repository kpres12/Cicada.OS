pkgrel=1
pkgdesc="Cicada.OS desktop shell (session, dock, settings, skel)"
arch=('any')
url="https://github.com/kpres12/Cicada.OS"
license=('GPL-3.0-or-later')
depends=(
  'hyprland'
  'waybar'
  'wofi'
  'kitty'
  'ttf-jetbrains-mono-nerd'
  # MAGI-04 pattern bay (cicada-wallpapers). All three are in [extra] —
  # nothing here reaches into the AUR.
  'quickshell'
  'imagemagick'
  'jq'
  # The brand mark installs into /usr/share/icons/hicolor, so the theme that
  # owns that tree (and declares its directories in index.theme) is a real
  # dependency, not an incidental one. gtk-update-icon-cache's pacman hook
  # rebuilds the cache on install — no post-install step here.
  'hicolor-icon-theme'
)
# Product unit is packages/cicada-desktop (meta). This package is the file tree.
source=()
sha256sums=()

package() {
  cp -a "${startdir}/files/." "${pkgdir}/"
}