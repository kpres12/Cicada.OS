#!/usr/bin/env bash
# cicada-run — the only launcher. MAGI scopes + bwrap (not bind-all).
# Escape from bwrap is still this user. Profiles are the blast-radius layer.
set -euo pipefail

usage() {
  echo "usage: cicada-run <app-id> -- <command> [args...]" >&2
  exit 1
}

[[ $# -ge 1 ]] || usage
APP_ID="$1"
shift
if [[ "${1:-}" == "--" ]]; then
  shift
fi
[[ $# -ge 1 ]] || usage

# Host UI / TTY / NM / polkit — boxing these breaks the product.
# Everything else goes through scopes + bwrap (Chromium family: no --unshare-pid).
case "${APP_ID}" in
  org.cicada.kitty|org.cicada.settings|org.cicada.wifi|org.cicada.install|org.cicada.start)
    export CICADA_APP_ID="${APP_ID}"
    exec "$@"
    ;;
esac

STORE_USER="${CICADA_SCOPES_ROOT:-${HOME}/.local/share/cicada/scopes}"
STORE_SYS="/usr/share/cicada/scopes"
CUR="${HOME}/.local/share/cicada/current-profile"
if [[ -f "${CUR}" ]]; then
  # shellcheck disable=SC1090
  source "${CUR}"
  if [[ -n "${CICADA_PROFILE_HOME:-}" && -d "${CICADA_PROFILE_HOME}" ]]; then
    export HOME="${CICADA_PROFILE_HOME}"
    STORE_USER="${HOME}/.local/share/cicada/scopes"
  fi
fi

# Default-deny. System floor + user file: deny always wins (user can only tighten).
NETWORK=deny
FILES=deny
CAMERA=deny
MIC=deny
USB=deny
SENSORS=deny

_load_scope() {
  local f="$1"
  [[ -f "${f}" ]] || return 0
  # shellcheck disable=SC1090
  source "${f}"
}

_tighten_net() {
  local a="$1" b="$2"
  if [[ "${a}" == "deny" || "${b}" == "deny" ]]; then echo deny
  elif [[ "${a}" == "tor" || "${b}" == "tor" ]]; then echo tor
  elif [[ "${a}" == "vpn-only" || "${b}" == "vpn-only" ]]; then echo vpn-only
  else echo allow
  fi
}

_tighten_files() {
  local a="$1" b="$2"
  if [[ "${a}" == "deny" || "${b}" == "deny" ]]; then echo deny
  elif [[ "${a}" == "portal" || "${b}" == "portal" ]]; then echo portal
  else echo allow
  fi
}

_tighten_flag() {
  local a="$1" b="$2"
  if [[ "${a}" == "allow" && "${b}" == "allow" ]]; then echo allow; else echo deny; fi
}

has_sys=0
has_user=0
SYS_NETWORK=deny SYS_FILES=deny SYS_CAMERA=deny SYS_MIC=deny SYS_USB=deny SYS_SENSORS=deny
USER_NETWORK=deny USER_FILES=deny USER_CAMERA=deny USER_MIC=deny USER_USB=deny USER_SENSORS=deny

if [[ -f "${STORE_SYS}/${APP_ID}.env" ]]; then
  NETWORK=deny FILES=deny CAMERA=deny MIC=deny USB=deny SENSORS=deny
  _load_scope "${STORE_SYS}/${APP_ID}.env"
  SYS_NETWORK="${NETWORK}" SYS_FILES="${FILES}"
  SYS_CAMERA="${CAMERA}" SYS_MIC="${MIC}" SYS_USB="${USB}" SYS_SENSORS="${SENSORS}"
  has_sys=1
fi
if [[ -f "${STORE_USER}/${APP_ID}.env" ]]; then
  NETWORK=deny FILES=deny CAMERA=deny MIC=deny USB=deny SENSORS=deny
  _load_scope "${STORE_USER}/${APP_ID}.env"
  USER_NETWORK="${NETWORK}" USER_FILES="${FILES}"
  USER_CAMERA="${CAMERA}" USER_MIC="${MIC}" USER_USB="${USB}" USER_SENSORS="${SENSORS}"
  has_user=1
fi

if [[ "${has_sys}" -eq 1 && "${has_user}" -eq 1 ]]; then
  NETWORK="$(_tighten_net "${SYS_NETWORK}" "${USER_NETWORK}")"
  FILES="$(_tighten_files "${SYS_FILES}" "${USER_FILES}")"
  CAMERA="$(_tighten_flag "${SYS_CAMERA}" "${USER_CAMERA}")"
  MIC="$(_tighten_flag "${SYS_MIC}" "${USER_MIC}")"
  USB="$(_tighten_flag "${SYS_USB}" "${USER_USB}")"
  SENSORS="$(_tighten_flag "${SYS_SENSORS}" "${USER_SENSORS}")"
elif [[ "${has_sys}" -eq 1 ]]; then
  NETWORK="${SYS_NETWORK}" FILES="${SYS_FILES}" CAMERA="${SYS_CAMERA}"
  MIC="${SYS_MIC}" USB="${SYS_USB}" SENSORS="${SYS_SENSORS}"
elif [[ "${has_user}" -eq 1 ]]; then
  NETWORK="${USER_NETWORK}" FILES="${USER_FILES}" CAMERA="${USER_CAMERA}"
  MIC="${USER_MIC}" USB="${USER_USB}" SENSORS="${USER_SENSORS}"
else
  NETWORK=deny FILES=deny CAMERA=deny MIC=deny USB=deny SENSORS=deny
fi

# System AV kill (Settings → Camera & microphone) overrides per-app allows.
if [[ -f /etc/cicada/av-kill.env ]]; then
  # shellcheck disable=SC1091
  source /etc/cicada/av-kill.env
  [[ "${CAMERA_KILL:-0}" == "1" ]] && CAMERA=deny
  [[ "${MIC_KILL:-0}" == "1" ]] && MIC=deny
fi

if ! command -v bwrap >/dev/null 2>&1; then
  echo "cicada-run: bubblewrap missing; running unsandboxed (fail open is forbidden — abort)." >&2
  exit 78
fi

# --- syscall filter ----------------------------------------------------------
# bubblewrap installs NO seccomp filter unless it is handed one. Namespaces hide
# resources; they do not shrink the kernel API the app can call. cicada-seccomp
# .service builds the program at boot (see cicada-seccomp-gen.sh for the list and
# the reasoning); this passes it on fd 9.
#
# Missing filter reduces protection, it does not leak a secret — so this
# degrades visibly and keeps the sandbox, rather than refusing to launch. The
# escape hatch matches cicada.nomalloc / cicada.nowatchdog.
SECCOMP_BLOB="${CICADA_SECCOMP_BLOB:-/run/cicada/seccomp/default.bpf}"
SECCOMP=1
if [[ "${CICADA_SECCOMP:-1}" != 1 ]] || grep -qw cicada.noseccomp /proc/cmdline 2>/dev/null; then
  SECCOMP=0
elif [[ ! -r "${SECCOMP_BLOB}" ]]; then
  SECCOMP=0
  echo "cicada-run: no syscall filter at ${SECCOMP_BLOB} — sandbox is namespaces only." >&2
  echo "  systemctl start cicada-seccomp   (then relaunch)" >&2
  logger -t cicada-run "seccomp filter missing; ${APP_ID:-app} started with namespace isolation only" 2>/dev/null || true
fi

export CICADA_APP_ID="${APP_ID}"

bind_opt() {
  local src="$1" dest="${2:-$1}"
  [[ -e "${src}" ]] || return 0
  args+=(--ro-bind "${src}" "${dest}")
}

bind_rw() {
  local src="$1" dest="${2:-$1}"
  [[ -e "${src}" ]] || return 0
  args+=(--bind "${src}" "${dest}")
}

mkdir -p "${HOME}/.config" "${HOME}/.cache" "${HOME}/.local/share" "${HOME}/Downloads"

case "${APP_ID}" in
  org.cicada.helium)
    mkdir -p "${HOME}/.config/helium" "${HOME}/.cache/helium" \
             "${HOME}/.config/chromium" "${HOME}/.cache/chromium"
    ;;
  org.keepassxc.KeePassXC)
    mkdir -p "${HOME}/.config/keepassxc" "${HOME}/.local/share/keepassxc"
    ;;
  org.torproject.torbrowser)
    mkdir -p "${HOME}/.local/share/torbrowser" "${HOME}/.cache/torbrowser"
    ;;
esac

# Chromium / Tor Browser: --unshare-pid kills the zygote. Keep other isolation.
UNSHARE_PID=1
case "${APP_ID}" in
  org.cicada.helium|org.torproject.torbrowser) UNSHARE_PID=0 ;;
esac

args=(
  bwrap
  --die-with-parent
  --unshare-uts
  --unshare-cgroup
  # SysV IPC is a namespace the app shares with every other process of this user
  # unless it is unshared: message queues and shared memory segments are a side
  # channel between two scopes that are supposed to be separate. Safe here
  # because Cicada is Wayland-only and /tmp is a tmpfs, so there is no X11 socket
  # in the sandbox and therefore no MIT-SHM client to break.
  --unshare-ipc
  # setsid(). Without it a sandboxed app holds the launching terminal's
  # controlling tty and can push characters into it with TIOCSTI — i.e. type
  # commands into the shell that started it, outside the sandbox. Terminal apps
  # are exempted from cicada-run entirely (see the case above), so nothing that
  # needs a controlling tty passes through here.
  --new-session
  --proc /proc
  --tmpfs /tmp
  --dev /dev
  --ro-bind /usr /usr
  --ro-bind /etc /etc
)
[[ "${UNSHARE_PID}" -eq 1 ]] && args+=(--unshare-pid)
[[ "${SECCOMP}" -eq 1 ]] && args+=(--seccomp 9)

[[ -d /opt ]] && args+=(--ro-bind /opt /opt)
[[ -L /bin ]] && args+=(--symlink usr/bin /bin) || bind_opt /bin
[[ -L /sbin ]] && args+=(--symlink usr/bin /sbin) || bind_opt /sbin
[[ -L /lib ]] && args+=(--symlink usr/lib /lib) || bind_opt /lib
[[ -L /lib64 ]] && args+=(--symlink usr/lib /lib64) || bind_opt /lib64

# SENSORS=deny: bind a filtered /sys (no hidraw / iio). allow: full /sys.
if [[ "${SENSORS}" == "allow" ]]; then
  bind_opt /sys
else
  args+=(--tmpfs /sys)
  bind_opt /sys/devices /sys/devices
  bind_opt /sys/dev /sys/dev
  bind_opt /sys/bus /sys/bus
  bind_opt /sys/class /sys/class
  bind_opt /sys/fs /sys/fs
  bind_opt /sys/kernel /sys/kernel
  bind_opt /sys/module /sys/module
  for sensor_path in /sys/class/hidraw /sys/bus/iio /sys/bus/hid; do
    if [[ -e "${sensor_path}" ]]; then
      args+=(--tmpfs "${sensor_path}")
    fi
  done
fi

bind_rw /dev/dri
bind_rw /dev/shm
bind_opt /run/systemd/resolve

# MIC=deny: selective XDG_RUNTIME_DIR (Wayland + portal sock only).
# Omit pipewire / pulse / pipewire-0 sockets so deny feels like mic unplugged.
if [[ -n "${XDG_RUNTIME_DIR:-}" && -d "${XDG_RUNTIME_DIR}" ]]; then
  if [[ "${MIC}" == "allow" ]]; then
    args+=(--bind "${XDG_RUNTIME_DIR}" "${XDG_RUNTIME_DIR}")
  else
    args+=(--tmpfs "${XDG_RUNTIME_DIR}")
    if [[ -n "${WAYLAND_DISPLAY:-}" && -e "${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}" ]]; then
      bind_rw "${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}"
    fi
    for wsock in "${XDG_RUNTIME_DIR}"/wayland-*; do
      [[ -e "${wsock}" ]] || continue
      bind_rw "${wsock}"
    done
    # Do not bind the real session bus — xdg-dbus-proxy below is the only D-Bus.
    [[ -d "${XDG_RUNTIME_DIR}/dconf" ]] && bind_rw "${XDG_RUNTIME_DIR}/dconf"
    [[ -d "${XDG_RUNTIME_DIR}/at-spi" ]] && bind_rw "${XDG_RUNTIME_DIR}/at-spi"
  fi
fi

if [[ "${CAMERA}" == "allow" ]]; then
  bind_rw /dev/video0
  bind_rw /dev/video1
fi
if [[ "${USB}" == "allow" ]]; then
  bind_rw /dev/bus/usb
fi
if [[ "${SENSORS}" == "allow" ]]; then
  for iio in /dev/iio:device*; do
    [[ -e "${iio}" ]] || continue
    bind_rw "${iio}"
  done
fi

netns_wrap=()
case "${NETWORK}" in
  deny)
    args+=(--unshare-net)
    ;;
  vpn-only)
    if ! ip link show wg0 >/dev/null 2>&1; then
      args+=(--unshare-net)
    elif ! nft list table inet cicada_ks >/dev/null 2>&1; then
      echo "cicada-run: ${APP_ID} is vpn-only but killswitch is down — denying net." >&2
      args+=(--unshare-net)
    fi
    ;;
  tor)
    if ! ip netns list 2>/dev/null | grep -qw onion; then
      echo "cicada-run: ${APP_ID} requires Tor, but the onion namespace is down." >&2
      echo "  sudo systemctl start cicada-tor-netns   (then: cicada-tor check)" >&2
      echo "  Refusing to run it on the direct network." >&2
      exit 78
    fi
    if ! command -v cicada-netns-helper >/dev/null 2>&1; then
      echo "cicada-run: cicada-netns-helper missing; cannot enter the Tor namespace." >&2
      exit 78
    fi
    netns_wrap=(sudo -n /usr/local/bin/cicada-netns-helper exec --)
    ;;
esac

case "${FILES}" in
  deny)
    args+=(--tmpfs "${HOME}")
    ;;
  portal)
    export GTK_USE_PORTAL=1
    export GDK_DEBUG="${GDK_DEBUG:+$GDK_DEBUG,}portals"
    args+=(--tmpfs "${HOME}")
    args+=(--dir "${HOME}/.config" --dir "${HOME}/.cache" --dir "${HOME}/.local/share" --dir "${HOME}/Downloads")
    args+=(--bind "${HOME}/Downloads" "${HOME}/Downloads")
    case "${APP_ID}" in
      org.cicada.helium)
        args+=(--bind "${HOME}/.config/helium" "${HOME}/.config/helium")
        args+=(--bind "${HOME}/.cache/helium" "${HOME}/.cache/helium")
        args+=(--bind "${HOME}/.config/chromium" "${HOME}/.config/chromium")
        args+=(--bind "${HOME}/.cache/chromium" "${HOME}/.cache/chromium")
        ;;
      org.keepassxc.KeePassXC)
        args+=(--bind "${HOME}/.config/keepassxc" "${HOME}/.config/keepassxc")
        args+=(--bind "${HOME}/.local/share/keepassxc" "${HOME}/.local/share/keepassxc")
        ;;
      org.torproject.torbrowser)
        args+=(--bind "${HOME}/.local/share/torbrowser" "${HOME}/.local/share/torbrowser")
        args+=(--bind "${HOME}/.cache/torbrowser" "${HOME}/.cache/torbrowser")
        ;;
      *)
        mkdir -p "${HOME}/.local/share/${APP_ID}"
        args+=(--bind "${HOME}/.local/share/${APP_ID}" "${HOME}/.local/share/${APP_ID}")
        ;;
    esac
    ;;
  *)
    args+=(--bind "${HOME}" "${HOME}")
    ;;
esac

proxy_pid=""
sock=""
cleanup() {
  [[ -n "${proxy_pid}" ]] && kill "${proxy_pid}" 2>/dev/null || true
  [[ -n "${sock}" ]] && rm -f "${sock}" 2>/dev/null || true
  return 0
}
trap cleanup EXIT INT TERM

if command -v xdg-dbus-proxy >/dev/null 2>&1 && [[ -n "${XDG_RUNTIME_DIR:-}" && -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
  sock="${XDG_RUNTIME_DIR}/cicada-${APP_ID}.sock"
  rm -f "${sock}"
  xdg-dbus-proxy "${DBUS_SESSION_BUS_ADDRESS}" "${sock}" --filter \
      --talk=org.freedesktop.portal.Desktop \
      --talk=org.freedesktop.portal.Documents \
      --talk=org.freedesktop.portal.FileChooser \
      --talk=org.freedesktop.portal.OpenURI \
      --talk=org.freedesktop.portal.Settings \
      --talk=org.freedesktop.portal.Inhibit \
      --talk=org.freedesktop.Notifications \
      --talk=org.freedesktop.ScreenSaver \
      >/dev/null 2>&1 &
  proxy_pid=$!
  sleep 0.15
  if [[ -S "${sock}" ]]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=${sock}"
    if [[ "${MIC}" != "allow" ]]; then
      bind_rw "${sock}"
    fi
  else
    kill "${proxy_pid}" 2>/dev/null || true
    proxy_pid=""
  fi
fi

# Chromium inner namespace sandbox fights nested bwrap; outer box is the sandbox.
if [[ "${APP_ID}" == "org.cicada.helium" ]]; then
  set -- "$@" --disable-namespace-sandbox --disable-setuid-sandbox
fi

rc=0
if [[ "${#netns_wrap[@]}" -gt 0 ]]; then
  # The Tor path goes through sudo, and sudo closes every descriptor above 2
  # before the helper starts — so fd 9 cannot be inherited from here. The helper
  # reopens the same root-owned path itself; see cicada-netns-helper. Passing
  # `--seccomp 9` without that would be a hard bwrap failure, which is why the
  # two files name the same default path.
  "${netns_wrap[@]}" "${args[@]}" "$@" || rc=$?
elif [[ "${SECCOMP}" -eq 1 ]]; then
  "${args[@]}" "$@" 9<"${SECCOMP_BLOB}" || rc=$?
else
  "${args[@]}" "$@" || rc=$?
fi
exit "${rc}"
