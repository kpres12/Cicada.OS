#!/usr/bin/env bash
# Graphene-shaped profiles: separate homes. Optional LUKS file for Burner.
# Not Android UIDs. Next apps launched via cicada-run follow the active profile.
set -euo pipefail

BASE="${CICADA_PROFILE_ROOT:-$HOME/.local/share/cicada/profiles}"
CUR="${HOME}/.local/share/cicada/current-profile"
mkdir -p "${BASE}" "$(dirname "${CUR}")"

usage() {
  cat <<'EOF'
cicada-profile — Work / Personal / Burner compartments

  cicada-profile list
  cicada-profile create <name> [--encrypt|--user]
  cicada-profile switch <name>     # directory profiles: next cicada-run apps
  cicada-profile enter <name>      # subshell with HOME set
  cicada-profile login <name>      # Unix-UID profile: new TTY session (Ctrl+Alt+F3)
  cicada-profile freeze <name>
  cicada-profile unlock <name>
  cicada-profile dispose <name>

--encrypt  LUKS2 loop (sudo). Unlocking Work does not unwrap Burner.
--user     real Unix account cicada-NAME (different UID). Same Hyprland cannot
           see that user's files. Log in as that user (Graphene users analogue).
EOF
}

name="${2:-}"
dest() { echo "${BASE}/${1}"; }
home_of() { echo "${BASE}/${1}/home"; }
img_of() { echo "${BASE}/${1}/vault.img"; }

write_current() {
  local n="$1"
  cat > "${CUR}" <<EOF
CICADA_PROFILE=${n}
CICADA_PROFILE_HOME=$(home_of "${n}")
EOF
}

seed_home() {
  local h="$1"
  mkdir -p "${h}"
  if [[ -d /etc/skel ]]; then
    rsync -a /etc/skel/ "${h}/" 2>/dev/null || true
  fi
  mkdir -p "${h}/.local/share/cicada/scopes" "${h}/Downloads"
}

cmd="${1:-}"
case "${cmd}" in
  list)
    if compgen -G "${BASE}/*" >/dev/null; then
      for d in "${BASE}"/*; do
        [[ -d "${d}" ]] || continue
        n="$(basename "${d}")"
        extra=""
        [[ -f "$(img_of "${n}")" ]] && extra=" encrypted"
        [[ -f "${d}/state/UID" ]] && extra="${extra} uid"
        [[ -f "${d}/state/FROZEN" ]] && extra="${extra} frozen"
        if [[ -f "${CUR}" ]] && grep -q "CICADA_PROFILE=${n}$" "${CUR}"; then
          extra="${extra} active"
        fi
        printf '%s%s\n' "${n}" "${extra}"
      done
    else
      echo "personal (default home)"
    fi
    ;;
  create)
    [[ -n "${name}" ]] || { usage; exit 1; }
    mkdir -p "$(dest "${name}")/state"
    if [[ "${3:-}" == "--user" ]]; then
      sudo -n /usr/local/bin/cicada-profile-helper create "${name}"
      echo "uid" > "$(dest "${name}")/state/UID"
      echo "login: cicada-${name}  (Ctrl+Alt+F3 after cicada-profile login ${name})"
    elif [[ "${3:-}" == "--encrypt" ]]; then
      img="$(img_of "${name}")"
      [[ ${EUID} -eq 0 ]] || { echo "create --encrypt needs sudo" >&2; exit 1; }
      [[ -f "${img}" ]] && { echo "already encrypted: ${name}" >&2; exit 1; }
      echo "LUKS passphrase for profile ${name}:"
      read -r -s p1; echo
      read -r -s -p "Again: " p2; echo
      [[ "${p1}" == "${p2}" ]] || { echo "mismatch" >&2; exit 1; }
      truncate -s "${CICADA_PROFILE_SIZE:-8G}" "${img}"
      # Same reasoning as the root volume: this passphrase faces an unlimited
      # offline attack once the image is copied off, so the KDF has to cost.
      printf '%s' "${p1}" | cryptsetup luksFormat --type luks2 \
        --pbkdf argon2id --pbkdf-memory 262144 --pbkdf-parallel 4 --iter-time 3000 \
        --batch-mode "${img}" -
      printf '%s' "${p1}" | cryptsetup open "${img}" "cicada-${name}" -
      unset p1 p2
      mkfs.ext4 -q -L "cicada-${name}" "/dev/mapper/cicada-${name}"
      mkdir -p "$(home_of "${name}")"
      mount "/dev/mapper/cicada-${name}" "$(home_of "${name}")"
      seed_home "$(home_of "${name}")"
      echo "created encrypted profile ${name}"
    else
      seed_home "$(home_of "${name}")"
      echo "created profile ${name}"
    fi
    ;;
  switch)
    [[ -n "${name}" ]] || { usage; exit 1; }
    [[ -d "$(dest "${name}")" ]] || { echo "missing profile: ${name}" >&2; exit 1; }
    [[ -f "$(dest "${name}")/state/FROZEN" ]] && { echo "frozen — unlock first" >&2; exit 1; }
    if [[ -f "$(dest "${name}")/state/UID" ]]; then
      echo "Unix-UID profile: run cicada-profile login ${name} (not switch). Same compositor cannot see that UID."
      exit 0
    fi
    write_current "${name}"
    echo "active profile ${name} (HOME for cicada-run: $(home_of "${name}"))"
    ;;
  enter)
    [[ -n "${name}" ]] || { usage; exit 1; }
    [[ -d "$(home_of "${name}")" ]] || { echo "missing profile: ${name}" >&2; exit 1; }
    write_current "${name}"
    HOME="$(home_of "${name}")"
    export HOME
    export CICADA_PROFILE="${name}"
    cd "${HOME}"
    exec "${SHELL:-/bin/bash}" -l
    ;;
  login)
    [[ -n "${name}" ]] || { usage; exit 1; }
    sudo -n /usr/local/bin/cicada-profile-helper login "${name}"
    ;;
  freeze)
    [[ -n "${name}" ]] || { usage; exit 1; }
    mkdir -p "$(dest "${name}")/state"
    if [[ -f "$(img_of "${name}")" ]]; then
      umount "$(home_of "${name}")" 2>/dev/null || true
      cryptsetup close "cicada-${name}" 2>/dev/null || true
    else
      chmod 000 "$(home_of "${name}")" 2>/dev/null || true
    fi
    touch "$(dest "${name}")/state/FROZEN"
    if [[ -f "${CUR}" ]] && grep -q "CICADA_PROFILE=${name}$" "${CUR}"; then
      rm -f "${CUR}"
    fi
    echo "froze ${name} (keys out of RAM if encrypted)"
    ;;
  freeze-idle)
    # Freeze every encrypted profile that is not the active one. Called from
    # cicada-lock: an unlocked profile keeps its volume key mapped in the
    # kernel, so locking the screen with three profiles open leaves three keys
    # in RAM for anyone who takes the machine in an AFU state.
    active=""
    [[ -f "${CUR}" ]] && active="$(sed -n 's/^CICADA_PROFILE=//p' "${CUR}")"
    compgen -G "${BASE}/*" >/dev/null || exit 0
    for d in "${BASE}"/*; do
      [[ -d "${d}" ]] || continue
      n="$(basename "${d}")"
      [[ "${n}" == "${active}" ]] && continue
      [[ -f "$(img_of "${n}")" ]] || continue           # only encrypted ones hold keys
      [[ -f "${d}/state/FROZEN" ]] && continue
      umount "$(home_of "${n}")" 2>/dev/null || true
      cryptsetup close "cicada-${n}" 2>/dev/null || true
      touch "${d}/state/FROZEN"
      echo "froze ${n}"
    done
    ;;
  end)
    # GrapheneOS calls this "end session": put the profile back at rest while
    # the machine keeps running. Same thing as freeze; named so it is findable.
    exec "$0" freeze "${name}"
    ;;
  unlock)
    [[ -n "${name}" ]] || { usage; exit 1; }
    rm -f "$(dest "${name}")/state/FROZEN"
    if [[ -f "$(img_of "${name}")" ]]; then
      [[ ${EUID} -eq 0 ]] || { echo "unlock encrypted profile needs sudo" >&2; exit 1; }
      cryptsetup open "$(img_of "${name}")" "cicada-${name}"
      mkdir -p "$(home_of "${name}")"
      mount "/dev/mapper/cicada-${name}" "$(home_of "${name}")"
    else
      chmod 700 "$(home_of "${name}")" 2>/dev/null || true
    fi
    echo "unlocked ${name}"
    ;;
  dispose)
    [[ -n "${name}" ]] || { usage; exit 1; }
    command -v cicada-auth >/dev/null && cicada-auth confirm profile.dispose
    if [[ -f "$(dest "${name}")/state/UID" ]]; then
      sudo -n /usr/local/bin/cicada-profile-helper dispose "${name}"
    fi
    if [[ -f "$(img_of "${name}")" ]]; then
      umount "$(home_of "${name}")" 2>/dev/null || true
      cryptsetup close "cicada-${name}" 2>/dev/null || true
      cryptsetup luksErase "$(img_of "${name}")" 2>/dev/null || true
      shred -u "$(img_of "${name}")" 2>/dev/null || rm -f "$(img_of "${name}")"
    fi
    rm -rf "${BASE:?}/${name}"
    if [[ -f "${CUR}" ]] && grep -q "CICADA_PROFILE=${name}$" "${CUR}"; then
      rm -f "${CUR}"
    fi
    echo "disposed ${name}"
    ;;
  *)
    usage
    ;;
esac
