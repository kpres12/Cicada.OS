#!/usr/bin/env bash
# Enroll a duress credential.
#
#   (default)   LUKS duress passphrase — fires at the power-on prompt only.
#   --session   session duress password — fires at hyprlock/sudo/polkit, i.e.
#               the case where you are coerced into unlocking a machine that is
#               already running. The LUKS slot cannot help there because it is
#               never asked for again after boot.
#
# Enrol both. They cover different rooms.
set -euo pipefail

SESSION=0
[[ "${1:-}" == "--session" ]] && SESSION=1

command -v cicada-auth >/dev/null && cicada-auth confirm duress.enroll
[[ ${EUID} -eq 0 ]] || { echo "run as root" >&2; exit 1; }

if [[ "${SESSION}" == 1 ]]; then
  SHASH=/etc/cicada/duress-session.sha256
  if [[ -f "${SHASH}" ]]; then
    echo "session duress verifier already present. Refuse to silently rotate." >&2
    exit 1
  fi
  command -v pam_exec.so >/dev/null 2>&1 || true
  [[ -f /etc/pam.d/hyprlock ]] || echo "warning: /etc/pam.d/hyprlock missing; the hook will not run" >&2
  read -r -s -p "Session duress password (NOT your login password): " s1; echo
  read -r -s -p "Again: " s2; echo
  [[ "${s1}" == "${s2}" ]] || { echo "mismatch" >&2; exit 1; }
  [[ ${#s1} -ge 8 ]] || { echo "too short" >&2; exit 1; }
  # A duress secret identical to the real one would never fire — the real auth
  # would match first and you would believe you had protection you do not.
  if [[ -n "${SUDO_USER:-}" ]] && command -v python3 >/dev/null 2>&1; then
    echo "note: verify this differs from your login password; they are not comparable here" >&2
  fi
  mkdir -p /etc/cicada
  printf '%s' "${s1}" | sha256sum | awk '{print $1}' > "${SHASH}"
  chmod 400 "${SHASH}"
  unset s1 s2
  command -v cicada-seal >/dev/null && cicada-seal append duress.enroll '{"kind":"session"}' >/dev/null 2>&1 || true
  cat <<'EOF'
Session duress enrolled.

Typing it at the lock screen (or any sudo/polkit prompt) erases every LUKS
keyslot, smashes the header, and hard-resets the machine. It does not ask for
confirmation and cannot be interrupted.

This destroys the disk. It does not get you out of the room, and in some
jurisdictions destroying data under legal process is itself an offence. Enrol it
deliberately.
EOF
  exit 0
fi
command -v cryptsetup >/dev/null || { echo "cryptsetup missing" >&2; exit 1; }

dev=""
if [[ -f /etc/cicada/install.env ]]; then
  # shellcheck disable=SC1091
  source /etc/cicada/install.env
  [[ -n "${CICADA_LUKS_UUID:-}" ]] && dev="/dev/disk/by-uuid/${CICADA_LUKS_UUID}"
fi
if [[ -z "${dev}" || ! -e "${dev}" ]]; then
  dev="$(cryptsetup status cicada 2>/dev/null | awk '/device:/{print $2}')"
fi
[[ -e "${dev}" ]] || {
  echo "cicada-duress-enroll: no LUKS device (install to disk first)" >&2
  exit 1
}

if [[ -f /etc/cicada/duress.sha256 ]]; then
  echo "duress verifier already present. Refuse to silently rotate (wipe+re-enroll by hand)." >&2
  exit 1
fi

read -r -s -p "Duress passphrase (NOT your real unlock): " d1; echo
read -r -s -p "Again: " d2; echo
[[ "${d1}" == "${d2}" ]] || { echo "mismatch" >&2; exit 1; }
[[ ${#d1} -ge 8 ]] || { echo "too short" >&2; exit 1; }

echo "Unlock with the REAL passphrase when cryptsetup asks, then the duress key is added from stdin."
printf '%s' "${d1}" | cryptsetup luksAddKey "${dev}"
printf '%s' "${d1}" | sha256sum | awk '{print $1}' > /etc/cicada/duress.sha256
chmod 400 /etc/cicada/duress.sha256
unset d1 d2

if [[ -f /etc/mkinitcpio.conf ]]; then
  if ! grep -q 'cicada-crypt' /etc/mkinitcpio.conf; then
    sed -i 's/encrypt /cicada-crypt /' /etc/mkinitcpio.conf
    if ! grep -q 'cicada-crypt' /etc/mkinitcpio.conf; then
      sed -i 's/^HOOKS=(base /HOOKS=(base udev autodetect microcode modconf kms keyboard keymap consolefont block cicada-crypt /' /etc/mkinitcpio.conf
    fi
  fi
  mkinitcpio -P
fi

command -v cicada-seal >/dev/null && cicada-seal append duress.enroll "{}" >/dev/null 2>&1 || true
echo "Duress enrolled. Wrong PIN and duress both wait ~12s then say Invalid passphrase."
echo "Duress also wipes LUKS keyslots and poweroffs. Real unlock is unchanged."
