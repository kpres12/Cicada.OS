#!/usr/bin/env bash
# First-run wizard — INSTALLED systems only. Live USB exits immediately.
#
# v1.0 path after etch: welcome → Work password → LUKS duress → session duress
# → TPM/USB token → Files tip. Login password was already set during etch.
set -uo pipefail

MARKER="${HOME}/.local/share/cicada/firstrun-done"
FORCE=0
[[ "${1:-}" == "--force" ]] && FORCE=1

[[ -d /run/archiso ]] && exit 0
[[ "${FORCE}" == 1 || ! -f "${MARKER}" ]] || exit 0

have_luks() { cryptsetup status cicada >/dev/null 2>&1; }
have_tpm2() {
  [[ -c /dev/tpmrm0 || -c /dev/tpm0 ]] || return 1
  [[ "$(cat /sys/class/tpm/tpm0/tpm_version_major 2>/dev/null)" == 2 ]]
}
luks_dev() { cryptsetup status cicada 2>/dev/null | awk '/device:/{print $2}'; }
has_tpm_slot() {
  local d; d="$(luks_dev)"; [[ -n "${d}" ]] || return 1
  cryptsetup luksDump "${d}" 2>/dev/null | grep -q 'systemd-tpm2'
}
has_token_slot() { [[ -f /etc/cicada/keyfile.env ]]; }
has_session_duress() { [[ -f /etc/cicada/duress-session.sha256 ]]; }
has_luks_duress() { [[ -f /etc/cicada/duress.sha256 ]]; }

mark_done() { mkdir -p "$(dirname "${MARKER}")"; date -u +%Y-%m-%dT%H:%M:%SZ > "${MARKER}"; }

mkdir -p "${HOME}/Downloads" "${HOME}/Pictures" "${HOME}/Documents" "${HOME}/Desktop"

have_luks || { mark_done; exit 0; }

ask() {
  local title="$1" body="$2"
  if [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]] && command -v zenity >/dev/null 2>&1; then
    zenity --question --title="${title}" --width=500 --text="${body}" 2>/dev/null
  else
    printf '\n%s\n\n%s\n' "${title}" "${body}"
    read -r -p "Continue? [y/N] " a
    [[ "${a}" =~ ^[Yy] ]]
  fi
}

info() {
  local title="$1" body="$2"
  if [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]] && command -v zenity >/dev/null 2>&1; then
    zenity --info --title="${title}" --width=500 --text="${body}" 2>/dev/null || true
  else
    printf '\n%s\n\n%s\n' "${title}" "${body}"
  fi
}

run_in_terminal() {
  if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v kitty >/dev/null 2>&1; then
    kitty --title CICADA-SETUP -e sudo "$@"
  else
    sudo "$@"
  fi
}

info "Cicada.OS — first setup" \
"This disk is the product (etched install), not the live USB.

You already have:
• LUKS disk encryption (power-on passphrase)
• Login as <b>cicada</b> with the password you chose at etch

Next (all optional — skip anything you are not ready for):
• Work profile password (second Unix user)
• Duress at power-on (wipes disk keys)
• Duress at lock screen (wipes if coerced while unlocked)
• TPM PIN or USB unlock token"

# ---- Work UID password ----------------------------------------------------
if id cicada-work >/dev/null 2>&1; then
  if passwd -S cicada-work 2>/dev/null | grep -q ' L '; then
    ask "Set Work profile password?" \
"A second user <tt>cicada-work</tt> exists (locked until you set a password).

Work is a real Unix UID — closest Graphene Users analogue.
Settings → Profiles can also do this later." && {
      if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v kitty >/dev/null 2>&1; then
        kitty --title CICADA-WORK-PASS -e bash -lc 'sudo passwd cicada-work; read -r -p "Enter…"'
      else
        sudo passwd cicada-work
      fi
    }
  fi
fi

# ---- LUKS duress (power-on) -----------------------------------------------
if ! has_luks_duress; then
  ask "Enroll a power-on duress passphrase?" \
"A second LUKS passphrase at boot.
Typing it wipes disk keys and poweroffs — same delay as a wrong guess.

Only if you understand the legal risk. Later:
  sudo cicada-duress-enroll" && run_in_terminal cicada-duress-enroll
fi

# ---- Session duress (hyprlock / sudo) -------------------------------------
if ! has_session_duress; then
  ask "Enroll a lock-screen duress password?" \
"Different threat: machine is already unlocked and someone forces you to
unlock the session (hyprlock) or type a sudo password.

Typing the session duress password erases LUKS and hard-resets.
Must NOT be your login password.

Later:  sudo cicada-duress-enroll --session" && run_in_terminal cicada-duress-enroll --session
fi

# ---- TPM / USB token ------------------------------------------------------
if have_tpm2; then
  if ! has_tpm_slot; then
    ask "Set up a TPM PIN?" \
"This machine has a TPM2. Seal the disk key behind a short PIN
(passphrase kept as fallback). TPM rate-limits guessing in hardware.

Apple EFI Airs: this usually no-ops — skip if unsure." && run_in_terminal cicada-tpm-enroll
  fi
else
  if ! has_token_slot; then
    ask "USB unlock token? (no TPM)" \
"No TPM here. A USB unlock token makes daily unlock survivable.

The stick will be ERASED. Show enrol instructions?" && {
      if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v kitty >/dev/null 2>&1; then
        kitty --title CICADA-SETUP -e bash -c '
          echo "Removable devices:"; echo
          lsblk -o NAME,SIZE,MODEL,TRAN,RM,MOUNTPOINTS | awk "NR==1 || \$5==1"
          echo
          echo "  sudo cicada-keyfile-enroll --or --device /dev/sdX1"
          echo
          exec bash'
      else
        echo "Run: sudo cicada-keyfile-enroll --or --device /dev/sdX1"
      fi
    }
  fi
fi

# ---- Secure Boot (sbctl) — non-Apple Setup Mode only ----------------------
if command -v sbctl >/dev/null 2>&1; then
  if sbctl status 2>/dev/null | grep -qi 'setup mode.*enabled\|setup mode:.*yes'; then
    ask "Enroll Cicada Secure Boot keys?" \
"Firmware is in Setup Mode. This enrolls sbctl keys and signs the boot
chain. Kernel updates re-sign via pacman hook.

Apple EFI: skip (will fail). Framework / Heads: yes." && run_in_terminal cicada-sbctl-enroll
  fi
fi

# ---- UKI repair -----------------------------------------------------------
# The installer builds these; this only fires when that failed (no systemd-ukify
# in the image, an ESP it could not write). Without a UKI the kernel command line
# and the initramfs sit unsigned on the ESP, so Secure Boot covers the one
# component an attacker has no reason to touch.
if command -v cicada-uki >/dev/null 2>&1 \
   && ! compgen -G "/boot/EFI/Linux/*.efi" >/dev/null 2>&1 \
   && ! compgen -G "/efi/EFI/Linux/*.efi" >/dev/null 2>&1; then
  ask "Rebuild the signed boot image?" \
"This machine has no unified kernel image, so the kernel command line and
the initramfs are NOT covered by Secure Boot — an attacker with a few
minutes and a USB stick can edit either one on the EFI partition.

This rebuilds and signs them. Safe: the current boot entries stay until
the new image is built and verified." && run_in_terminal cicada-uki build
fi

# ---- LUKS header backup ---------------------------------------------------
# Asked once, here, because this is the moment a USB stick is most likely to be
# in someone's hand — and because the attempt cap and the duress passphrase both
# destroy keyslots by design, which makes header damage a routine outcome on this
# system rather than an exotic one.
if command -v cicada-luks-header >/dev/null 2>&1 \
   && [[ ! -f /var/lib/cicada/header-backed-up ]]; then
  ask "Back up the LUKS header to a USB?" \
"The header holds the wrapped master key. If the first 16 MB of the disk
is damaged, everything on it is gone — no passphrase can recover it.

Read the warning first: the backup also UNDOES the duress wipe and the
wrong-guess wipe for anyone holding it, and keeps working with
passphrases you later revoke. Store it away from the laptop, or decline.

Shows the instructions; nothing is written without your confirmation." && {
    run_in_terminal bash -c 'cicada-luks-header; echo; echo "Plug in a USB, then:"; echo "  sudo cicada-luks-header backup /run/media/'"${USER}"'/USB/cicada-header.img"; echo; exec bash'
  }
fi

# ---- Witness pairing (the beacon) -----------------------------------------
# Offered here and not on the live ISO: a live image has no machine identity and
# the same boot hash on every copy, so a beacon from it says nothing.
#
# This is the only step in the wizard that is *more* important the worse the
# hardware is. On Tier 2+ the boot chain prevents the attack this detects. On an
# Apple EFI Air it is the only thing standing between an edited initramfs and a
# passphrase typed into it — see docs/BEACON.md.
if command -v cicada-link >/dev/null 2>&1 \
   && [[ ! -f /var/lib/cicada/witnesses.json && ! -f "${HOME}/.local/share/cicada/witnesses.json" ]]; then
  _tier_note="This laptop cannot verify its own boot chain, so this is the only
tamper detection it has."
  if [[ -c /dev/tpmrm0 || -c /dev/tpm0 ]]; then
    _tier_note="This laptop has a TPM, so the boot chain can also be checked
locally. The beacon still catches what a compromised local check would hide."
  fi
  # Opt-in, and it stays opt-in: nothing here enables the beacon unless someone
  # reads this and says yes. An alarm you did not consciously choose to receive
  # is an alarm you learn to dismiss, which costs you the one that matters.
  #
  # So the prompt does the explaining rather than leaving a systemctl line for
  # later. Saying yes completes the setup; saying no leaves the machine exactly
  # as it is, and `cicada-link show` is there whenever you change your mind.
  ask "Turn on tamper detection?" \
"<b>In one sentence:</b> this laptop will sign a short statement about its own
boot chain every time it starts, and send it to one device you pair by hand,
so that device can tell you if your boot partition changed when it should not
have.

${_tier_note}

It carries no messages, has no account and no server, and cannot receive —
pairing is one-way. If you never finish pairing, it sends nothing and nothing
breaks.

<b>Saying yes will:</b>
 • show this laptop's fingerprint and a code to scan with the other device
 • enable the statement at every boot, and every six hours after

You can turn it off at any time:
  sudo systemctl disable --now cicada-beacon.timer" && {
    _enable_beacon() {
      sudo systemctl enable --now cicada-beacon.timer 2>/dev/null \
        && echo "Boot statement enabled." \
        || echo "Could not enable the timer — run: sudo systemctl enable --now cicada-beacon.timer"
    }
    if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v kitty >/dev/null 2>&1; then
      kitty --title CICADA-WITNESS -e bash -lc '
        cicada-link show
        echo
        sudo systemctl enable --now cicada-beacon.timer 2>/dev/null \
          && echo "Boot statement enabled — every boot, then every six hours." \
          || echo "Could not enable the timer. Run: sudo systemctl enable --now cicada-beacon.timer"
        echo
        echo "Scan the code above with the device that will watch this laptop."
        echo "Nothing you do on this screen finishes the pairing — that happens there."
        echo
        read -r -p "Enter…"'
    else
      cicada-link show
      echo
      _enable_beacon
    fi
  }
fi

# ---- Channel pin (updates stay Cicada, not raw Arch rolling) --------------
if [[ -x /usr/local/lib/cicada/cicada-channel-enable.sh ]]; then
  sudo /usr/local/lib/cicada/cicada-channel-enable.sh /etc/pacman.conf >/dev/null 2>&1 || true
fi

info "You are set" \
"• Dock: Files, Helium, Wi-Fi, Settings
• Lock: Super+L — login password
• Settings → Security for TPM / Secure Boot / allocator / updates
• Settings → Profiles for Work
• Super+/ or Start here for the cheat sheet

Updates: cicada-update (channel only — not raw Arch rolling).
Live USB remains the try-before-you-buy demo."

mark_done
