#!/usr/bin/env bash
# First-run wizard — INSTALLED systems only. Live USB exits immediately (beta demo).
#
# Public-beta path: welcome → optional Work password → optional duress hint →
# TPM PIN or USB token (machine-tier) → point at Files/Pictures.
set -uo pipefail

MARKER="${HOME}/.local/share/cicada/firstrun-done"
FORCE=0
[[ "${1:-}" == "--force" ]] && FORCE=1

# Live has no LUKS to enrol against, and nothing here persists anyway.
[[ -d /run/archiso ]] && exit 0
[[ "${FORCE}" == 1 || ! -f "${MARKER}" ]] || exit 0

have_luks() { cryptsetup status cicada >/dev/null 2>&1; }
have_tpm2() {
  [[ -c /dev/tpmrm0 || -c /dev/tpm0 ]] || return 1
  [[ "$(cat /sys/class/tpm/tpm0/tpm_version_major 2>/dev/null)" == 2 ]]
}
luks_dev() { cryptsetup status cicada 2>/dev/null | awk '/device:/{print $2}'; }
has_tpm_slot() {
  local d; d="$(luks_dev)"; [[ -n "${d}" ]] || return 1
  cryptsetup luksDump "${d}" 2>/dev/null | grep -q 'systemd-tpm2'
}
has_token_slot() { [[ -f /etc/cicada/keyfile.env ]]; }

mark_done() { mkdir -p "$(dirname "${MARKER}")"; date -u +%Y-%m-%dT%H:%M:%SZ > "${MARKER}"; }

# Seed daily-driver folders even if the user skips every prompt.
mkdir -p "${HOME}/Downloads" "${HOME}/Pictures" "${HOME}/Documents" "${HOME}/Desktop"

# No LUKS means this is not a Cicada install (or the mapping is named something
# else). Nothing to offer; do not nag on every login.
have_luks || { mark_done; exit 0; }

ask() {
  local title="$1" body="$2"
  if [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]] && command -v zenity >/dev/null 2>&1; then
    zenity --question --title="${title}" --width=480 --text="${body}" 2>/dev/null
  else
    printf '\n%s\n\n%s\n' "${title}" "${body}"
    read -r -p "Continue? [y/N] " a
    [[ "${a}" =~ ^[Yy] ]]
  fi
}

info() {
  local title="$1" body="$2"
  if [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]] && command -v zenity >/dev/null 2>&1; then
    zenity --info --title="${title}" --width=480 --text="${body}" 2>/dev/null || true
  else
    printf '\n%s\n\n%s\n' "${title}" "${body}"
  fi
}

run_in_terminal() {
  if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v kitty >/dev/null 2>&1; then
    kitty --title CICADA-SETUP -e sudo "$@"
  else
    sudo "$@"
  fi
}

# ---- Welcome (public beta) ------------------------------------------------
info "Cicada.OS — installed (public beta)" \
"You left the live USB. This disk is the product:

• Files and wallpaper survive reboot (under LUKS)
• Live USB stays the try-before-you-buy demo
• Claims stay honest — see Settings → Start here

Next prompts are optional. Skip anything you are not ready for."

# ---- Work UID password ----------------------------------------------------
if id cicada-work >/dev/null 2>&1; then
  if passwd -S cicada-work 2>/dev/null | grep -q ' L '; then
    ask "Set Work profile password?" \
"A second user cicada-work already exists (locked).
Work is a real Unix UID — closest Graphene Users analogue.

Set its login password now? (Settings → Profiles also does this.)" && {
      if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v kitty >/dev/null 2>&1; then
        kitty --title CICADA-WORK-PASS -e bash -lc 'sudo passwd cicada-work; read -r -p "Enter…"'
      else
        sudo passwd cicada-work
      fi
    }
  fi
fi

# ---- Duress (optional) ----------------------------------------------------
ask "Enroll a duress disk passphrase?" \
"Duress is a second LUKS passphrase at power-on.
Typing it wipes disk keys and poweroffs — same delay as a wrong guess.

Only do this if you understand it. You can run later:
  sudo cicada-duress-enroll" && run_in_terminal cicada-duress-enroll

# ---- TPM / USB token (existing Tier path) ---------------------------------
if have_tpm2; then
  if ! has_tpm_slot; then
    ask "Cicada — TPM PIN unlock" \
"This machine has a TPM2.

Seal the disk key behind a short PIN (passphrase kept as fallback).
The TPM rate-limits guessing in hardware.

Set up a TPM PIN now?" && run_in_terminal cicada-tpm-enroll
  fi
else
  if ! has_token_slot; then
    ask "Cicada — USB unlock token (no TPM)" \
"No TPM here, so the disk passphrase must stay long.
A USB unlock token makes daily unlock survivable with a short AFU reboot window.

The stick will be ERASED. Show enrol instructions now?" && {
      if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v kitty >/dev/null 2>&1; then
        kitty --title CICADA-SETUP -e bash -c '
          echo "Removable devices:"; echo
          lsblk -o NAME,SIZE,MODEL,TRAN,RM,MOUNTPOINTS | awk "NR==1 || \$5==1"
          echo
          echo "Enrol with (partition, not whole disk):"
          echo "  sudo cicada-keyfile-enroll --or --device /dev/sdX1"
          echo
          exec bash'
      else
        lsblk -o NAME,SIZE,MODEL,TRAN,RM | awk 'NR==1 || $5==1'
        echo "Run: sudo cicada-keyfile-enroll --or --device /dev/sdX1"
      fi
    }
  fi
fi

# ---- Point at daily persistence -------------------------------------------
info "Files & wallpaper" \
"• Open Files from the dock — Downloads, Pictures, Documents are yours
• Settings → Appearance → Wallpaper… to change the desk
• Helium saves into Downloads by default (storage scopes)

Live USB testing continues in parallel; this install is the release path."

mark_done
