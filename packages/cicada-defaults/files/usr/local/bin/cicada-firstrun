#!/usr/bin/env bash
# First-run wizard — INSTALLED systems only. Live USB exits immediately.
#
# v1.0 path after etch: welcome → Work password → LUKS duress → session duress
# → TPM/USB token → Files tip. Login password was already set during etch.
set -uo pipefail

MARKER="${HOME}/.local/share/cicada/firstrun-done"
FORCE=0
[[ "${1:-}" == "--force" ]] && FORCE=1

[[ -d /run/archiso ]] && exit 0
[[ "${FORCE}" == 1 || ! -f "${MARKER}" ]] || exit 0

have_luks() { cryptsetup status cicada >/dev/null 2>&1; }
have_tpm2() {
  [[ -c /dev/tpmrm0 || -c /dev/tpm0 ]] || return 1
  [[ "$(cat /sys/class/tpm/tpm0/tpm_version_major 2>/dev/null)" == 2 ]]
}
luks_dev() { cryptsetup status cicada 2>/dev/null | awk '/device:/{print $2}'; }
has_tpm_slot() {
  local d; d="$(luks_dev)"; [[ -n "${d}" ]] || return 1
  cryptsetup luksDump "${d}" 2>/dev/null | grep -q 'systemd-tpm2'
}
has_token_slot() { [[ -f /etc/cicada/keyfile.env ]]; }
has_session_duress() { [[ -f /etc/cicada/duress-session.sha256 ]]; }
has_luks_duress() { [[ -f /etc/cicada/duress.sha256 ]]; }

mark_done() { mkdir -p "$(dirname "${MARKER}")"; date -u +%Y-%m-%dT%H:%M:%SZ > "${MARKER}"; }

mkdir -p "${HOME}/Downloads" "${HOME}/Pictures" "${HOME}/Documents" "${HOME}/Desktop"

have_luks || { mark_done; exit 0; }

ask() {
  local title="$1" body="$2"
  if [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]] && command -v zenity >/dev/null 2>&1; then
    zenity --question --title="${title}" --width=500 --text="${body}" 2>/dev/null
  else
    printf '\n%s\n\n%s\n' "${title}" "${body}"
    read -r -p "Continue? [y/N] " a
    [[ "${a}" =~ ^[Yy] ]]
  fi
}

info() {
  local title="$1" body="$2"
  if [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]] && command -v zenity >/dev/null 2>&1; then
    zenity --info --title="${title}" --width=500 --text="${body}" 2>/dev/null || true
  else
    printf '\n%s\n\n%s\n' "${title}" "${body}"
  fi
}

run_in_terminal() {
  if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v kitty >/dev/null 2>&1; then
    kitty --title CICADA-SETUP -e sudo "$@"
  else
    sudo "$@"
  fi
}

info "Cicada.OS — first setup" \
"This disk is the product (etched install), not the live USB.

You already have:
• LUKS disk encryption (power-on passphrase)
• Login as <b>cicada</b> with the password you chose at etch

Next (all optional — skip anything you are not ready for):
• Work profile password (second Unix user)
• Duress at power-on (wipes disk keys)
• Duress at lock screen (wipes if coerced while unlocked)
• TPM PIN or USB unlock token"

# ---- Work UID password ----------------------------------------------------
if id cicada-work >/dev/null 2>&1; then
  if passwd -S cicada-work 2>/dev/null | grep -q ' L '; then
    ask "Set Work profile password?" \
"A second user <tt>cicada-work</tt> exists (locked until you set a password).

Work is a real Unix UID — closest Graphene Users analogue.
Settings → Profiles can also do this later." && {
      if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v kitty >/dev/null 2>&1; then
        kitty --title CICADA-WORK-PASS -e bash -lc 'sudo passwd cicada-work; read -r -p "Enter…"'
      else
        sudo passwd cicada-work
      fi
    }
  fi
fi

# ---- LUKS duress (power-on) -----------------------------------------------
if ! has_luks_duress; then
  ask "Enroll a power-on duress passphrase?" \
"A second LUKS passphrase at boot.
Typing it wipes disk keys and poweroffs — same delay as a wrong guess.

Only if you understand the legal risk. Later:
  sudo cicada-duress-enroll" && run_in_terminal cicada-duress-enroll
fi

# ---- Session duress (hyprlock / sudo) -------------------------------------
if ! has_session_duress; then
  ask "Enroll a lock-screen duress password?" \
"Different threat: machine is already unlocked and someone forces you to
unlock the session (hyprlock) or type a sudo password.

Typing the session duress password erases LUKS and hard-resets.
Must NOT be your login password.

Later:  sudo cicada-duress-enroll --session" && run_in_terminal cicada-duress-enroll --session
fi

# ---- TPM / USB token ------------------------------------------------------
if have_tpm2; then
  if ! has_tpm_slot; then
    ask "Set up a TPM PIN?" \
"This machine has a TPM2. Seal the disk key behind a short PIN
(passphrase kept as fallback). TPM rate-limits guessing in hardware.

Apple EFI Airs: this usually no-ops — skip if unsure." && run_in_terminal cicada-tpm-enroll
  fi
else
  if ! has_token_slot; then
    ask "USB unlock token? (no TPM)" \
"No TPM here. A USB unlock token makes daily unlock survivable.

The stick will be ERASED. Show enrol instructions?" && {
      if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v kitty >/dev/null 2>&1; then
        kitty --title CICADA-SETUP -e bash -c '
          echo "Removable devices:"; echo
          lsblk -o NAME,SIZE,MODEL,TRAN,RM,MOUNTPOINTS | awk "NR==1 || \$5==1"
          echo
          echo "  sudo cicada-keyfile-enroll --or --device /dev/sdX1"
          echo
          exec bash'
      else
        echo "Run: sudo cicada-keyfile-enroll --or --device /dev/sdX1"
      fi
    }
  fi
fi

# ---- Secure Boot (sbctl) — non-Apple Setup Mode only ----------------------
if command -v sbctl >/dev/null 2>&1; then
  if sbctl status 2>/dev/null | grep -qi 'setup mode.*enabled\|setup mode:.*yes'; then
    ask "Enroll Cicada Secure Boot keys?" \
"Firmware is in Setup Mode. This enrolls sbctl keys and signs the boot
chain. Kernel updates re-sign via pacman hook.

Apple EFI: skip (will fail). Framework / Heads: yes." && run_in_terminal cicada-sbctl-enroll
  fi
fi

# ---- Channel pin (updates stay Cicada, not raw Arch rolling) --------------
if [[ -x /usr/local/lib/cicada/cicada-channel-enable.sh ]]; then
  sudo /usr/local/lib/cicada/cicada-channel-enable.sh /etc/pacman.conf >/dev/null 2>&1 || true
fi

info "You are set" \
"• Dock: Files, Helium, Wi-Fi, Settings
• Lock: Super+L — login password
• Settings → Security for TPM / Secure Boot / allocator / updates
• Settings → Profiles for Work
• Super+/ or Start here for the cheat sheet

Updates: cicada-update (channel only — not raw Arch rolling).
Live USB remains the try-before-you-buy demo."

mark_done
