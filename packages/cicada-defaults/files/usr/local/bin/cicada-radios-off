#!/usr/bin/env bash
set -euo pipefail
# Soft-block Wi-Fi/Bluetooth only if explicitly requested.
# Default is off: this is a laptop, not a phone.
if [[ "${CICADA_RADIOS_OFF_DEFAULT:-0}" != "1" ]]; then
  exit 0
fi
rfkill block wifi || true
rfkill block bluetooth || true
logger -t cicada "Wi-Fi and Bluetooth soft-blocked (defaults)"