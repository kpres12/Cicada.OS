#!/usr/bin/env bash
# Privileged helper: only create/delete cicada-* users or open a TTY session.
set -euo pipefail
[[ ${EUID} -eq 0 ]] || { echo "root only" >&2; exit 1; }

valid() {
  [[ "$1" =~ ^[a-z][a-z0-9]{0,12}$ ]] || return 1
  [[ "$1" != "root" && "$1" != "cicada" ]]
}

cmd="${1:-}"
name="${2:-}"
user="cicada-${name}"

case "${cmd}" in
  create|create-locked)
    valid "${name}" || { echo "bad profile name" >&2; exit 1; }
    id "${user}" >/dev/null 2>&1 && { echo "exists: ${user}" >&2; exit 1; }
    # No `input` group. It grants read on /dev/input/event*, which is every
    # keystroke on the machine regardless of which VT has focus — a Work or
    # Burner session left running would log the owner's sudo password and
    # duress PIN. The compositor gets its devices from logind, not from groups.
    useradd -m -G video,audio,storage,rfkill,network,users -s /bin/bash "${user}"
    if [[ -d /etc/skel ]]; then
      rsync -a /etc/skel/ "/home/${user}/"
      chown -R "${user}:${user}" "/home/${user}"
    fi
    if [[ "${cmd}" == "create-locked" ]]; then
      # Firstboot / non-interactive: account exists, login locked until owner sets a password.
      passwd -l "${user}" >/dev/null
      echo "created locked Unix user ${user} (passwd -l). Set password before login:"
      echo "  sudo passwd ${user}"
    else
      echo "Set a login password for ${user} (not in wheel, cannot sudo):"
      passwd "${user}"
      echo "created Unix user ${user}. Log in as ${user} — different UID, not a folder."
    fi
    ;;
  login)
    valid "${name}" || { echo "bad profile name" >&2; exit 1; }
    id "${user}" >/dev/null 2>&1 || { echo "missing ${user}" >&2; exit 1; }
    command -v openvt >/dev/null || { echo "openvt missing (kbd)" >&2; exit 1; }
    command -v setpriv >/dev/null || { echo "setpriv missing (util-linux)" >&2; exit 1; }
    # This verb is NOPASSWD, so the gate has to live here and not in the caller
    # — the same lesson as dispose. `su` run by root asks nothing, which made
    # "open a session as the Work user" free for anything executing as the
    # owner. Dropping to nobody first means su itself authenticates, on the new
    # VT, against the PROFILE's password: the one secret the owner's processes
    # do not hold. A create-locked account therefore cannot be entered until
    # its password is set, which is what "locked" was supposed to mean.
    #
    # 65534 by number, because the group is `nobody` on Arch and `nogroup`
    # elsewhere. No --no-new-privs: su is setuid and has to stay that way.
    openvt -c 3 -s -- setpriv --reuid 65534 --regid 65534 --clear-groups -- \
      su - "${user}" -c 'Hyprland || bash'
    ;;
  dispose)
    valid "${name}" || { echo "bad profile name" >&2; exit 1; }
    id "${user}" >/dev/null 2>&1 || { echo "missing ${user}" >&2; exit 1; }
    userdel -r "${user}"
    echo "deleted ${user}"
    ;;
  *)
    echo "usage: cicada-profile-helper create|create-locked|login|dispose NAME" >&2
    exit 1
    ;;
esac
