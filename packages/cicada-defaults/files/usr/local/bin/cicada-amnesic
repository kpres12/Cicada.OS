#!/usr/bin/env bash
# Live ISO only: ignore internal disks. Yank watch is a separate daemon —
# udev RUN+systemctl is sandboxed and does not reliably start panic.
set -euo pipefail
[[ -d /run/archiso ]] || exit 0

mkdir -p /run/udev/rules.d
for d in /sys/block/*; do
  [[ -d "${d}" ]] || continue
  name="$(basename "${d}")"
  case "${name}" in
    loop*|ram*|zram*|dm-*) continue ;;
  esac
  rem=0
  [[ -f "${d}/removable" ]] && rem="$(cat "${d}/removable")"
  usb=0
  if readlink -f "${d}" 2>/dev/null | grep -q '/usb'; then
    usb=1
  fi
  if [[ "${rem}" == "0" && "${usb}" == "0" ]]; then
    {
      printf 'KERNEL=="%s", ENV{UDISKS_IGNORE}="1"\n' "${name}"
      case "${name}" in
        nvme*) printf 'KERNEL=="%sp*", ENV{UDISKS_IGNORE}="1"\n' "${name}" ;;
        mmcblk*) printf 'KERNEL=="%sp*", ENV{UDISKS_IGNORE}="1"\n' "${name}" ;;
        *) printf 'KERNEL=="%s[0-9]*", ENV{UDISKS_IGNORE}="1"\n' "${name}" ;;
      esac
    } > "/run/udev/rules.d/61-cicada-ignore-${name}.rules"
  fi
done

# Reload only. A full `udevadm trigger` can replay remove and false-panic at boot.
udevadm control --reload 2>/dev/null || true
udevadm trigger --subsystem-match=block --action=change 2>/dev/null || true

if grep -qw copytoram /proc/cmdline 2>/dev/null; then
  logger -t cicada "amnesic: copytoram — overlay+ISO in RAM; yank USB → panic reboot"
else
  logger -t cicada "live cow is RAM; squashfs still on USB. Amnesic boot entry adds copytoram."
fi
