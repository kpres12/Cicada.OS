#!/usr/bin/env bash
# PAM hook: duress password entered at a session prompt (hyprlock, sudo, polkit).
#
# The LUKS duress slot only exists at power-on. If you are coerced into unlocking
# a *running* session — the far more likely scenario, and the one an abusive
# partner or a campus office actually produces — it never fires. This closes
# that gap: the same wipe, reachable from the lock screen.
#
# Invoked by pam_exec with expose_authtok, so the typed secret arrives on stdin.
# Never echo it, never log it, never write it anywhere.
#
# Exits 0 unconditionally. A non-zero exit from an `optional` pam_exec module is
# ignored, but returning 0 also means a wrong guess here is indistinguishable
# from this module not existing.
set -uo pipefail

HASHFILE="${CICADA_DURESS_HASHFILE:-/etc/cicada/duress-session.sha256}"
INSTALL_ENV="${CICADA_DURESS_INSTALL_ENV:-/etc/cicada/install.env}"
# The reset path is overridable for exactly one reason: tests/linux/duress.sh
# has to be able to drive the *matching* branch, and writing 'b' to the real
# sysrq trigger would reset the machine running the test. Nothing in the product
# sets it. It is the last line of the script, so a test that redirects it still
# exercises everything that decides whether to wipe.
SYSRQ="${CICADA_DURESS_SYSRQ:-/proc/sysrq-trigger}"
[[ -r "${HASHFILE}" ]] || exit 0

# `|| true`, not `|| exit 0`, and this is the whole feature.
#
# pam_exec with expose_authtok writes the password with
# write(fds[1], authtok, strlen(authtok)) and then closes the pipe — no
# newline, no NUL terminator (linux-pam modules/pam_exec/pam_exec.c). `read`
# therefore fills the variable and *returns non-zero*, because it hit EOF
# without seeing a delimiter. With `|| exit 0` this script exited before it
# ever computed a hash, which meant the session duress credential silently
# never fired: typing it did nothing, and the failure was invisible because
# exiting 0 is also what a wrong guess does.
#
# The emptiness check below is what actually rejects no-input, and it still does.
read -r -s token || true
[[ -n "${token}" ]] || exit 0

got="$(printf '%s' "${token}" | sha256sum | awk '{print $1}')"
token=""
want="$(tr -d '[:space:]' < "${HASHFILE}")"
[[ -n "${want}" ]] || exit 0

# Constant-ish comparison: both sides are fixed-length hex from sha256, so a
# plain string compare leaks nothing useful about the secret itself.
[[ "${got}" == "${want}" ]] || exit 0

# Match. From here on, do not stop for errors and do not let anything block.
logger -t cicada "duress credential entered at session prompt — wiping" 2>/dev/null || true

dev=""
if [[ -f "${INSTALL_ENV}" ]]; then
  # shellcheck disable=SC1091
  source "${INSTALL_ENV}"
  [[ -n "${CICADA_LUKS_UUID:-}" ]] && dev="/dev/disk/by-uuid/${CICADA_LUKS_UUID}"
fi
[[ -n "${dev}" && -e "${dev}" ]] \
  || dev="$(cryptsetup status cicada 2>/dev/null | awk '/device:/{print $2}')" || true

if [[ -n "${dev}" && -e "${dev}" ]]; then
  # Erase every keyslot, then smash the header. After this the volume key that
  # is still live in RAM is the only copy, and the reset below takes that too.
  cryptsetup luksErase --batch-mode "${dev}" >/dev/null 2>&1 \
    || cryptsetup erase --batch-mode "${dev}" >/dev/null 2>&1 || true
  dd if=/dev/zero of="${dev}" bs=1M count=4 conv=notrunc >/dev/null 2>&1 || true
  sync || true
fi

# Hard reset rather than a clean shutdown: a clean shutdown can be inhibited,
# and every second of delay is a second the key is still in DRAM.
echo b > "${SYSRQ}" 2>/dev/null || systemctl reboot --force || true
exit 0
