#!/usr/bin/env bash
# Panic if the live boot USB disappears. Not udev RUN+systemctl (that is sandboxed).
# copytoram may release the UUID without a yank — only arm if the device stays present.
set -euo pipefail
[[ -d /run/archiso ]] || exit 0

uuid=""
if [[ -r /proc/cmdline ]]; then
  uuid="$(sed -n 's/.*archisosearchuuid=\([^ ]*\).*/\1/p' /proc/cmdline | head -1)"
fi
[[ -n "${uuid}" ]] || { logger -t cicada-yank-watch "no archisosearchuuid"; exit 0; }

dev="/dev/disk/by-uuid/${uuid}"
deadline=$((SECONDS + 90))
seen=0
while (( SECONDS < deadline )); do
  if [[ -e "${dev}" ]]; then
    seen=1
    break
  fi
  sleep 0.5
done

if [[ "${seen}" -ne 1 ]]; then
  logger -t cicada-yank-watch "boot UUID never appeared — not arming (copytoram already released?)"
  exit 0
fi

logger -t cicada-yank-watch "armed ${uuid}"
while [[ -e "${dev}" ]]; do
  sleep 0.5
done
logger -t cicada-yank-watch "boot USB gone — panic"
exec /usr/local/bin/cicada-panic
