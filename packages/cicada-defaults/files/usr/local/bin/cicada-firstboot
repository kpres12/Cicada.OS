#!/usr/bin/env bash
# Root systemd unit only. Do not run from Hyprland exec-once (polkit loop on live).
set -euo pipefail

# Always (before the firstboot marker): repair Helium modes lost to mkarchiso
# --no-preserve=mode. A 0644 /opt/helium/helium makes every Web click a no-op.
# Must run on live AND installed, every boot, or a bad stick stays broken after
# the one-shot marker is written.
if [[ ${EUID} -eq 0 && -x /usr/local/lib/cicada/heal-helium.sh ]]; then
  /usr/local/lib/cicada/heal-helium.sh || true
fi

# Overridable so tests/afu.sh can drive the escape hatch without a kernel
# cmdline or a real /etc. Nothing in the product sets them.
CMDLINE="${CICADA_CMDLINE:-/proc/cmdline}"
PRELOAD_F="${CICADA_PRELOAD:-/etc/ld.so.preload}"

# --- cicada.nomalloc rescue --------------------------------------------------
# This has to sit ABOVE the firstboot marker check, for the same reason the
# Helium mode repair does: the marker makes this script exit immediately on
# every boot after the first. hardened_malloc is turned on *after* install, by
# cicada-malloc — so the boot where somebody needs this rescue is always a boot
# where the marker already exists, and a hatch below the marker could only ever
# fire on a machine that is not broken yet.
#
# It also has to *remove* the preload, not merely decline to add one. The block
# further down abstains, which does nothing for a machine whose
# /etc/ld.so.preload was already written and whose browser therefore will not
# start. README promises this flag "disables hardened_malloc"; abstaining is not
# disabling.
if [[ ${EUID} -eq 0 ]] && grep -qw cicada.nomalloc "${CMDLINE}" 2>/dev/null; then
  if [[ -f "${PRELOAD_F}" ]] && grep -q 'libhardened_malloc' "${PRELOAD_F}"; then
    # Filter the one line rather than deleting the file: something else may
    # legitimately be preloaded, and this is a rescue path, not a reset.
    grep -v 'libhardened_malloc' "${PRELOAD_F}" > "${PRELOAD_F}.tmp" || true
    if [[ -s "${PRELOAD_F}.tmp" ]]; then
      mv "${PRELOAD_F}.tmp" "${PRELOAD_F}"
    else
      rm -f "${PRELOAD_F}" "${PRELOAD_F}.tmp"
    fi
    echo "cicada-firstboot: cicada.nomalloc — hardened_malloc preload removed for this boot."
    echo "  This lasts one boot. To make it stick: sudo cicada-malloc off"
    logger -t cicada-firstboot "cicada.nomalloc: removed hardened_malloc preload" 2>/dev/null || true
  fi
fi

MARKER=/var/lib/cicada/firstboot-done
mkdir -p /var/lib/cicada
if [[ -f "${MARKER}" ]]; then
  exit 0
fi

cat <<'EOF'
╔══════════════════════════════════════════════╗
║             C I C A D A . O S                ║
║         nimbus // channel:dev                ║
║  inbound deny · telemetry off                ║
║  wifi: click WIFI · settings: click SETTINGS ║
║  live: overlay is RAM · yank USB = panic     ║
╚══════════════════════════════════════════════╝
EOF

if [[ ${EUID} -ne 0 ]]; then
  echo "cicada-firstboot: not root — skip (Hyprland must not call this)" >&2
  exit 0
fi

# hardened_malloc: opt-in via /etc/cicada/hardened-malloc-enable (or keep a
# prior preload). Global preload on by default silently killed Helium's zygote
# — Tirimid "browse the internet" failed while Doom still worked. Browser and
# daily apps must come first; allocator hardening is useless if the user has
# to abandon the OS to open a URL.
if [[ -f /usr/lib/libhardened_malloc.so ]] \
   && [[ ! -f /etc/cicada/hardened-malloc-disable ]] \
   && [[ -f /etc/cicada/hardened-malloc-enable ]] \
   && ! grep -qw cicada.nomalloc "${CMDLINE}" 2>/dev/null; then
  echo '/usr/lib/libhardened_malloc.so' > "${PRELOAD_F}"
elif [[ -f /run/archiso ]]; then
  # Live demo: never leave a broken preload from a previous overlay session.
  rm -f "${PRELOAD_F}" 2>/dev/null || true
fi

# Live ISO already has units enabled in the profile. enable --now as the
# desktop user trips polkit and stalls tty1.
if [[ ! -d /run/archiso ]]; then
  systemctl enable --now nftables.service 2>/dev/null || true
  systemctl enable --now cicada-locked-reboot.timer 2>/dev/null || true

  # AppArmor only does something if the LSM is in the kernel's stack. Arch's
  # stock kernel builds it in but leaves it out of the default list, so
  # enable --now can report success on a kernel where no profile will ever be
  # consulted. Check the kernel's own answer, and say so when it is no —
  # this reduces protection, it does not leak a secret, so it degrades visibly
  # rather than failing closed.
  if grep -qw apparmor /sys/kernel/security/lsm 2>/dev/null; then
    systemctl enable --now apparmor.service 2>/dev/null || true
  else
    systemctl enable apparmor.service 2>/dev/null || true
    logger -t cicada "apparmor NOT in the kernel LSM stack — profiles will not be enforced; add lsm=...,apparmor,... to /etc/kernel/cmdline and rebuild the UKI" 2>/dev/null || true
    echo "cicada-firstboot: apparmor is not in /sys/kernel/security/lsm — enabled but NOT enforcing" >&2
  fi

  if command -v usbguard >/dev/null 2>&1; then
    rules=/etc/usbguard/rules.conf
    if [[ ! -s "${rules}" ]] || ! grep -qvE '^[[:space:]]*(#|$)' "${rules}"; then
      usbguard generate-policy > "${rules}" 2>/dev/null || true
    fi
    systemctl enable --now usbguard.service 2>/dev/null || true
  fi

  # Work-as-UID: create cicada-work once on installed systems (locked until passwd).
  if [[ -x /usr/local/bin/cicada-profile-helper ]] && ! id cicada-work >/dev/null 2>&1; then
    /usr/local/bin/cicada-profile-helper create-locked work || true
    if id cicada >/dev/null 2>&1; then
      mkdir -p /home/cicada/.local/share/cicada/profiles/work/state
      echo uid > /home/cicada/.local/share/cicada/profiles/work/state/UID
      chown -R cicada:cicada /home/cicada/.local/share/cicada/profiles/work 2>/dev/null || true
    fi
  fi
fi

# Launcher monopoly: hide Arch .desktop files from generic XDG menus.
if [[ -x /usr/local/lib/cicada/hide-arch-desktops.sh ]]; then
  /usr/local/lib/cicada/hide-arch-desktops.sh || true
fi

# Prefer signed cicada-stable channel when present.
if [[ -x /usr/local/lib/cicada/cicada-channel-enable.sh ]]; then
  /usr/local/lib/cicada/cicada-channel-enable.sh /etc/pacman.conf || true
fi

# Import Cicada channel pubkey when pacman-key exists (installed systems).
if [[ -f /etc/pacman.d/cicada-stable-key.gpg ]] && command -v pacman-key >/dev/null 2>&1; then
  pacman-key --add /etc/pacman.d/cicada-stable-key.gpg 2>/dev/null || true
  pacman-key --lsign-key "$(pacman-key --list-keys 2>/dev/null | awk '/cicada-stable|Cicada/{getline; print $1; exit}')" 2>/dev/null || true
fi

# Tell the session whether locking is survivable. An empty password hash means
# hyprlock would grab input and accept nothing — see cicada-lock. Root-only work,
# which is why it lives here and not in the lock helper.
# Setuid carve-out. The pacman hook keeps it applied afterwards.
[[ -x /usr/local/lib/cicada/strip-setuid.sh ]] && /usr/local/lib/cicada/strip-setuid.sh || true

mkdir -p /run/cicada
rm -f /run/cicada/live-nopasswd
if [[ -z "$(awk -F: '$1 == "cicada" { print $2 }' /etc/shadow 2>/dev/null)" ]]; then
  : > /run/cicada/live-nopasswd
  logger -t cicada "lock disabled: user cicada has no password" 2>/dev/null || true
fi

if command -v cicada-seal >/dev/null 2>&1; then
  cicada-seal init >/dev/null 2>&1 || true
  cicada-seal append boot.first "{}" >/dev/null 2>&1 || true
fi
command -v cicada-attest >/dev/null && cicada-attest >/dev/null 2>&1 || true

if [[ ! -d /home/cicada/.config/hypr ]] && [[ -d /etc/skel/.config ]]; then
  rsync -a /etc/skel/ /home/cicada/ 2>/dev/null || true
  chown -R cicada:cicada /home/cicada 2>/dev/null || true
fi

touch "${MARKER}"
