#!/usr/bin/env bash
# Root systemd unit only. Do not run from Hyprland exec-once (polkit loop on live).
set -euo pipefail
MARKER=/var/lib/cicada/firstboot-done
mkdir -p /var/lib/cicada
if [[ -f "${MARKER}" ]]; then
  exit 0
fi

cat <<'EOF'
╔══════════════════════════════════════════════╗
║             C I C A D A . O S                ║
║         nimbus // channel:dev                ║
║  inbound deny · telemetry off                ║
║  wifi: click WIFI · settings: click SETTINGS ║
║  live: overlay is RAM · yank USB = panic     ║
╚══════════════════════════════════════════════╝
EOF

if [[ ${EUID} -ne 0 ]]; then
  echo "cicada-firstboot: not root — skip (Hyprland must not call this)" >&2
  exit 0
fi

# hardened_malloc applies on live too. The live stick is where a browser 0-day
# actually gets pointed at this OS — demoing on stock glibc while claiming
# hardened allocation was the wrong way round. The .so is built into the ISO,
# so the only real risk is a compat regression, and `cicada.nomalloc` on the
# kernel cmdline is the escape hatch you can reach from the bootloader when
# there is no writable filesystem to drop a disable file onto.
if [[ -f /usr/lib/libhardened_malloc.so ]] \
   && [[ ! -f /etc/cicada/hardened-malloc-disable ]] \
   && ! grep -qw cicada.nomalloc /proc/cmdline 2>/dev/null; then
  echo '/usr/lib/libhardened_malloc.so' > /etc/ld.so.preload
fi

# Live ISO already has units enabled in the profile. enable --now as the
# desktop user trips polkit and stalls tty1.
if [[ ! -d /run/archiso ]]; then
  systemctl enable --now nftables.service 2>/dev/null || true
  systemctl enable --now cicada-locked-reboot.timer 2>/dev/null || true
  systemctl enable --now apparmor.service 2>/dev/null || true

  if command -v usbguard >/dev/null 2>&1; then
    rules=/etc/usbguard/rules.conf
    if [[ ! -s "${rules}" ]] || ! grep -qvE '^[[:space:]]*(#|$)' "${rules}"; then
      usbguard generate-policy > "${rules}" 2>/dev/null || true
    fi
    systemctl enable --now usbguard.service 2>/dev/null || true
  fi

  # Work-as-UID: create cicada-work once on installed systems (locked until passwd).
  if [[ -x /usr/local/bin/cicada-profile-helper ]] && ! id cicada-work >/dev/null 2>&1; then
    /usr/local/bin/cicada-profile-helper create-locked work || true
    if id cicada >/dev/null 2>&1; then
      mkdir -p /home/cicada/.local/share/cicada/profiles/work/state
      echo uid > /home/cicada/.local/share/cicada/profiles/work/state/UID
      chown -R cicada:cicada /home/cicada/.local/share/cicada/profiles/work 2>/dev/null || true
    fi
  fi
fi

# Launcher monopoly: hide Arch .desktop files from generic XDG menus.
if [[ -x /usr/local/lib/cicada/hide-arch-desktops.sh ]]; then
  /usr/local/lib/cicada/hide-arch-desktops.sh || true
fi

# Prefer signed cicada-stable channel when present.
if [[ -x /usr/local/lib/cicada/cicada-channel-enable.sh ]]; then
  /usr/local/lib/cicada/cicada-channel-enable.sh /etc/pacman.conf || true
fi

# Import Cicada channel pubkey when pacman-key exists (installed systems).
if [[ -f /etc/pacman.d/cicada-stable-key.gpg ]] && command -v pacman-key >/dev/null 2>&1; then
  pacman-key --add /etc/pacman.d/cicada-stable-key.gpg 2>/dev/null || true
  pacman-key --lsign-key "$(pacman-key --list-keys 2>/dev/null | awk '/cicada-stable|Cicada/{getline; print $1; exit}')" 2>/dev/null || true
fi

# Tell the session whether locking is survivable. An empty password hash means
# hyprlock would grab input and accept nothing — see cicada-lock. Root-only work,
# which is why it lives here and not in the lock helper.
mkdir -p /run/cicada
rm -f /run/cicada/live-nopasswd
if [[ -z "$(awk -F: '$1 == "cicada" { print $2 }' /etc/shadow 2>/dev/null)" ]]; then
  : > /run/cicada/live-nopasswd
  logger -t cicada "lock disabled: user cicada has no password" 2>/dev/null || true
fi

if command -v cicada-seal >/dev/null 2>&1; then
  cicada-seal init >/dev/null 2>&1 || true
  cicada-seal append boot.first "{}" >/dev/null 2>&1 || true
fi
command -v cicada-attest >/dev/null && cicada-attest >/dev/null 2>&1 || true

if [[ ! -d /home/cicada/.config/hypr ]] && [[ -d /etc/skel/.config ]]; then
  rsync -a /etc/skel/ /home/cicada/ 2>/dev/null || true
  chown -R cicada:cicada /home/cicada 2>/dev/null || true
fi

touch "${MARKER}"
