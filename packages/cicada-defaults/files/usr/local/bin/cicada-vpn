#!/usr/bin/env bash
# WireGuard up/down with nftables kill switch. Off by default — no endpoint means no tunnel.
# Kill switch is NOT loaded at boot; that would black-hole Wi-Fi setup.
set -euo pipefail
CONF=/etc/wireguard/wg0.conf
KS="${CICADA_KS:-/etc/cicada/killswitch.nft}"

usage() {
  echo "usage: cicada-vpn on|off|status|verify"
  echo "copy /etc/wireguard/wg0.conf.example to wg0.conf first"
  echo "verify — dry-check killswitch.nft + Endpoint port (no traffic test)"
}

need_conf() {
  if [[ ! -f "${CONF}" ]] || ! grep -q '^PrivateKey' "${CONF}"; then
    echo "cicada-vpn: no real wg0.conf (only the example). Wi-Fi still works; tunnel is opt-in." >&2
    exit 1
  fi
}

case "${1:-}" in
  on)
    need_conf
    # The killswitch only whitelists udp/51820. A non-standard Endpoint port
    # would hand you a tunnel that cannot handshake, which reads as "VPN broken"
    # rather than "port mismatch". Say so up front.
    endpoint_line="$(sed -n 's/^[[:space:]]*Endpoint[[:space:]]*=[[:space:]]*//p' "${CONF}" | head -1)"
    port="$(printf '%s' "${endpoint_line}" | sed -n 's/.*:\([0-9]\+\)$/\1/p')"
    peer_host="$(printf '%s' "${endpoint_line}" | sed 's/:\([0-9]\+\)$//')"
    # Strip IPv6 brackets if present.
    peer_host="${peer_host#[}"
    peer_host="${peer_host%]}"
    if [[ -n "${port}" && "${port}" != "51820" ]]; then
      echo "cicada-vpn: Endpoint uses udp/${port}; killswitch only permits 51820." >&2
      echo "  Edit ${KS} to match, or move the endpoint to 51820." >&2
      exit 1
    fi
    # Pin handshake to the peer address when we can resolve it. Port-only
    # fallback remains in killswitch.nft for the rare case resolve fails at
    # bring-up (captive portal, DNS down) — still better than open net.
    ks_file="${KS}"
    ks_tmp=""
    if [[ -n "${peer_host}" ]]; then
      peer_ip=""
      if [[ "${peer_host}" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        peer_ip="${peer_host}"
      elif [[ "${peer_host}" =~ : ]]; then
        peer_ip="${peer_host}"
      else
        peer_ip="$(getent ahostsv4 "${peer_host}" 2>/dev/null | awk 'NR==1{print $1; exit}')" || true
      fi
      if [[ -n "${peer_ip}" ]]; then
        ks_tmp="$(mktemp)"
        # Replace the port-only handshake accept with a peer-pinned rule.
        if [[ "${peer_ip}" =~ : ]]; then
          sed "s/udp dport 51820 accept/ip6 daddr ${peer_ip} udp dport 51820 accept/" \
            "${KS}" >"${ks_tmp}"
        else
          sed "s/udp dport 51820 accept/ip daddr ${peer_ip} udp dport 51820 accept/" \
            "${KS}" >"${ks_tmp}"
        fi
        # Input path: pin source too when we have a peer.
        if [[ "${peer_ip}" =~ : ]]; then
          sed -i "s/udp sport 51820 accept/ip6 saddr ${peer_ip} udp sport 51820 accept/" "${ks_tmp}"
        else
          sed -i "s/udp sport 51820 accept/ip saddr ${peer_ip} udp sport 51820 accept/" "${ks_tmp}"
        fi
        ks_file="${ks_tmp}"
        echo "cicada-vpn: killswitch handshake pinned to ${peer_ip}:51820"
      else
        echo "cicada-vpn: could not resolve Endpoint ${peer_host} — using port-only handshake allow." >&2
      fi
    fi
    # Load killswitch BEFORE raising the tunnel so there is no clearnet window.
    if ! nft -f "${ks_file}"; then
      echo "cicada-vpn: killswitch failed to load — refusing to bring the tunnel up." >&2
      nft delete table inet cicada_ks 2>/dev/null || true
      [[ -n "${ks_tmp}" ]] && rm -f "${ks_tmp}"
      exit 1
    fi
    [[ -n "${ks_tmp}" ]] && rm -f "${ks_tmp}"
    if ! wg-quick up wg0; then
      echo "cicada-vpn: tunnel failed — removing killswitch so Wi-Fi still works." >&2
      nft delete table inet cicada_ks 2>/dev/null || true
      exit 1
    fi
    cicada-seal append vpn.on "{}" >/dev/null 2>&1 || true
    logger -t cicada "VPN up, kill switch on"
    notify-send "Cicada VPN" "Tunnel up · kill switch on" 2>/dev/null || true
    ;;
  off)
    cicada-auth confirm vpn.off
    nft delete table inet cicada_ks 2>/dev/null || true
    wg-quick down wg0 2>/dev/null || true
    cicada-seal append vpn.off "{}" >/dev/null 2>&1 || true
    logger -t cicada "VPN down, kill switch off"
    notify-send "Cicada VPN" "Tunnel down · kill switch off" 2>/dev/null || true
    ;;
  status)
    if ip link show wg0 >/dev/null 2>&1; then
      echo "vpn: up"
    else
      echo "vpn: down"
    fi
    if nft list table inet cicada_ks >/dev/null 2>&1; then
      echo "killswitch: on"
    else
      echo "killswitch: off"
    fi
    ;;
  verify)
    # Static policy check — full leak test is tests/killswitch.sh on Linux + wg0.
    fail=0
    [[ -f "${KS}" ]] || { echo "FAIL: missing ${KS}"; exit 1; }
    if ! grep -q 'policy drop' "${KS}"; then
      echo "FAIL: killswitch must default-drop"; fail=1
    fi
    if awk '/chain output/,/^  }/' "${KS}" | grep -v '^[[:space:]]*#' \
         | grep -q 'ct state established'; then
      echo "FAIL: output chain must not accept established (leak on tunnel death)"
      fail=1
    fi
    if ! grep -q 'udp dport 51820 accept' "${KS}"; then
      echo "FAIL: handshake udp/51820 must be allowed"; fail=1
    fi
    if ! grep -q 'udp dport 67 ip daddr 255.255.255.255 accept' "${KS}" \
      && ! grep -q 'udp dport 67 accept' "${KS}"; then
      echo "FAIL: DHCP client path missing"; fail=1
    fi
    if grep -qE '^[[:space:]]*udp dport 67 accept$' "${KS}"; then
      echo "FAIL: DHCP must not allow arbitrary udp/67 (broadcast-only)"
      fail=1
    fi
    if [[ -f "${CONF}" ]] && grep -q '^PrivateKey' "${CONF}"; then
      port="$(sed -n 's/^[[:space:]]*Endpoint[[:space:]]*=.*:\([0-9]\+\).*/\1/p' "${CONF}" | head -1)"
      if [[ -n "${port}" && "${port}" != "51820" ]]; then
        echo "FAIL: Endpoint port ${port} != killswitch 51820"; fail=1
      else
        echo "OK: Endpoint port matches killswitch (or unset)"
      fi
      if grep -q 'peer-pinned\|pinned to' "${0}" 2>/dev/null \
        || grep -q 'getent ahostsv4' "${0}"; then
        echo "OK: on-path pins handshake to resolved Endpoint IP"
      fi
    else
      echo "NOTE: no wg0.conf yet — ruleset check only"
    fi
    # Syntax check when nft is available (may need root for some builds)
    if command -v nft >/dev/null 2>&1; then
      if nft -c -f "${KS}" 2>/dev/null; then
        echo "OK: nft syntax"
      else
        # -c may require caps; still try loading into a temp check by parsing
        echo "NOTE: nft -c unavailable (permissions) — ruleset present"
      fi
    fi
    [[ "${fail}" -eq 0 ]] || exit 1
    echo "PASS: killswitch policy looks closed"
    echo "On a live tunnel: tests/killswitch.sh <iface> for tcpdump proof"
    ;;
  *)
    usage
    exit 1
    ;;
esac
