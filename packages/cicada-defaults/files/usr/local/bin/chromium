#!/usr/bin/env bash
# Chromium wrapper. Loads Graphene's hardened_malloc when present (AUR — not on the ISO).
# Official-repo ISO uses stock glibc malloc until docs/aur-audit.md clears the PKGBUILD.
set -euo pipefail
HM=""
for cand in /usr/lib/libhardened_malloc.so /usr/lib/hardened_malloc/libhardened_malloc.so; do
  if [[ -f "${cand}" ]]; then
    HM="${cand}"
    break
  fi
done
if [[ -n "${HM}" ]]; then
  export LD_PRELOAD="${HM}${LD_PRELOAD:+:${LD_PRELOAD}}"
fi
if command -v cicada-run >/dev/null 2>&1; then
  exec cicada-run org.cicada.helium -- /usr/bin/chromium "$@"
fi
exec /usr/bin/chromium "$@"
