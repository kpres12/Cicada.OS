#!/usr/bin/env bash
# Default browser: Helium (official tarball at /opt/helium), else Arch chromium.
# Preloads GrapheneOS hardened_malloc when the library is on disk.
set -euo pipefail

# hardened_malloc breaks Chromium/Helium zygote forks (silent exit, no window).
# Never preload it into the browser — even if ld.so.preload is set system-wide,
# clear it for this process tree before exec.
if [[ -n "${LD_PRELOAD:-}" ]]; then
  _pl="${LD_PRELOAD}"
  _pl="${_pl//\/usr\/lib\/libhardened_malloc.so/}"
  _pl="${_pl//\/usr\/lib\/hardened_malloc\/libhardened_malloc.so/}"
  _pl="${_pl//::/:}"
  _pl="${_pl#:}"
  _pl="${_pl%:}"
  if [[ -n "${_pl}" ]]; then
    export LD_PRELOAD="${_pl}"
  else
    unset LD_PRELOAD
  fi
  unset _pl
fi
# ld.so.preload still applies to children. If it points at hardened_malloc,
# refuse to launch until the operator clears it — better a zenity than a no-op.
if [[ -f /etc/ld.so.preload ]] && grep -q hardened_malloc /etc/ld.so.preload 2>/dev/null; then
  die "Browser blocked: hardened_malloc is in /etc/ld.so.preload and crashes Helium.

Fix (this session):
  sudo rm -f /etc/ld.so.preload
Then click Web again.

Or reboot with kernel option: cicada.nomalloc"
fi

# Do not set LD_PRELOAD to hardened_malloc for the browser (removed above).
# Other apps can still opt in via cicada-run if desired.

# Launched from a desktop icon, stderr goes nowhere. A browser that exits 1 with
# a message no one can see is indistinguishable from a click that did nothing —
# which is exactly how a 0644 Helium binary went unnoticed for a whole build.
# Every exit path from here on has to be visible on screen.
die() {
  echo "cicada: $1" >&2
  if [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]]; then
    if command -v zenity >/dev/null 2>&1; then
      zenity --error --title="Cicada — browser" --width=460 --text="$1" 2>/dev/null || true
    elif command -v notify-send >/dev/null 2>&1; then
      notify-send "Cicada — browser" "$1" 2>/dev/null || true
    fi
  fi
  exit 1
}

BIN=""
found_unusable=""
# Prefer helium-wrapper: it sets LD_LIBRARY_PATH=$HERE before exec.
for cand in /opt/helium/helium-wrapper /opt/helium/chrome /opt/helium/helium \
            /usr/bin/helium /usr/bin/helium-browser /usr/bin/chromium; do
  if [[ -x "${cand}" ]]; then
    BIN="${cand}"
    break
  fi
  # Present but not executable is a build defect, not a missing browser. Say so:
  # the two have completely different fixes and identical symptoms.
  # Written as an `if`, not `[[ ... ]] && x=y`: under `set -e` a false test as
  # the last command in the loop body would exit the script — silently, which
  # is the exact failure mode this block exists to eliminate.
  if [[ -e "${cand}" && -z "${found_unusable}" ]]; then
    found_unusable="${cand}"
  fi
done
if [[ -z "${BIN}" ]]; then
  # Last chance: heal modes then retry (NOPASSWD on live/installed wheel).
  if [[ -n "${found_unusable}" ]] && [[ -x /usr/local/lib/cicada/heal-helium.sh ]]; then
    sudo -n /usr/local/lib/cicada/heal-helium.sh 2>/dev/null || true
    for cand in /opt/helium/helium-wrapper /opt/helium/chrome /opt/helium/helium; do
      if [[ -x "${cand}" ]]; then
        BIN="${cand}"
        break
      fi
    done
  fi
fi
if [[ -z "${BIN}" ]]; then
  if [[ -n "${found_unusable}" ]]; then
    die "Helium is installed at ${found_unusable} but is not executable.

This is a build defect (the exec bit was lost). Fix it on this machine with:
  sudo chmod 755 /opt/helium/helium /opt/helium/helium-wrapper \\
                 /opt/helium/helium_crashpad_handler"
  fi
  die "No browser found (Helium / Chromium)."
fi

if command -v cicada-run >/dev/null 2>&1; then
  exec cicada-run org.cicada.helium -- "${BIN}" "$@"
fi
exec "${BIN}" "$@"
