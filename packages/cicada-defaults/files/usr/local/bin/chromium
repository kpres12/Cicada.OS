#!/usr/bin/env bash
# Default browser: Helium (official tarball at /opt/helium), else Arch chromium.
# Never preload hardened_malloc into the browser — it kills the zygote.
set -euo pipefail

# Visible failure: desktop clicks have nowhere for stderr. Define before any use.
die() {
  echo "cicada: $1" >&2
  if [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]]; then
    if command -v zenity >/dev/null 2>&1; then
      zenity --error --title="Cicada — browser" --width=480 --text="$1" 2>/dev/null || true
    elif command -v notify-send >/dev/null 2>&1; then
      notify-send "Cicada — browser" "$1" 2>/dev/null || true
    fi
  fi
  exit 1
}

# Strip hardened_malloc from this process tree's LD_PRELOAD.
if [[ -n "${LD_PRELOAD:-}" ]]; then
  _pl="${LD_PRELOAD}"
  _pl="${_pl//\/usr\/lib\/libhardened_malloc.so/}"
  _pl="${_pl//\/usr\/lib\/hardened_malloc\/libhardened_malloc.so/}"
  _pl="${_pl//::/:}"
  _pl="${_pl#:}"
  _pl="${_pl%:}"
  if [[ -n "${_pl}" ]]; then
    export LD_PRELOAD="${_pl}"
  else
    unset LD_PRELOAD
  fi
  unset _pl
fi

# ld.so.preload still applies to every child. Clear it (NOPASSWD on live) —
# do not call die() before the function existed (that was a silent no-op click).
if [[ -f /etc/ld.so.preload ]] && grep -q hardened_malloc /etc/ld.so.preload 2>/dev/null; then
  if sudo -n rm -f /etc/ld.so.preload 2>/dev/null; then
    notify-send "Cicada" "Cleared hardened_malloc preload so Helium can start" 2>/dev/null || true
  else
    die "Browser blocked: hardened_malloc is in /etc/ld.so.preload and crashes Helium.

Fix:
  sudo rm -f /etc/ld.so.preload
Then click Web again."
  fi
fi

BIN=""
found_unusable=""
# Prefer helium-wrapper: it sets LD_LIBRARY_PATH=$HERE before exec.
for cand in /opt/helium/helium-wrapper /opt/helium/chrome /opt/helium/helium \
            /usr/bin/helium /usr/bin/helium-browser /usr/bin/chromium; do
  if [[ -x "${cand}" ]]; then
    BIN="${cand}"
    break
  fi
  if [[ -e "${cand}" && -z "${found_unusable}" ]]; then
    found_unusable="${cand}"
  fi
done
if [[ -z "${BIN}" ]]; then
  if [[ -n "${found_unusable}" ]] && [[ -x /usr/local/lib/cicada/heal-helium.sh ]]; then
    sudo -n /usr/local/lib/cicada/heal-helium.sh 2>/dev/null || true
    for cand in /opt/helium/helium-wrapper /opt/helium/chrome /opt/helium/helium; do
      if [[ -x "${cand}" ]]; then
        BIN="${cand}"
        break
      fi
    done
  fi
fi
if [[ -z "${BIN}" ]]; then
  if [[ -n "${found_unusable}" ]]; then
    die "Helium is installed at ${found_unusable} but is not executable.

Fix:
  sudo chmod 755 /opt/helium/helium /opt/helium/helium-wrapper"
  fi
  die "No browser found (Helium / Chromium)."
fi

# Wayland session: force ozone so we do not silently fall into a missing XWayland.
extra=()
if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
  extra+=(--ozone-platform=wayland --ozone-platform-hint=wayland)
fi
# Official Helium tarball ships no chrome_sandbox on this channel — without
# these flags the zygote exits immediately (looks like a dead dock icon).
extra+=(--no-sandbox --disable-setuid-sandbox --disable-namespace-sandbox)

LOG="${XDG_RUNTIME_DIR:-/tmp}/cicada-helium.log"
run_browser() {
  if command -v cicada-run >/dev/null 2>&1; then
    cicada-run org.cicada.helium -- "${BIN}" "${extra[@]}" "$@"
  else
    "${BIN}" "${extra[@]}" "$@"
  fi
}

# If the browser dies in the first second, surface the log — not a silent click.
run_browser "$@" >"${LOG}" 2>&1 &
pid=$!
sleep 1.2
if ! kill -0 "${pid}" 2>/dev/null; then
  wait "${pid}" 2>/dev/null || true
  tailtxt="$(tail -c 800 "${LOG}" 2>/dev/null || true)"
  die "Helium exited immediately.

${tailtxt:-(no log — try: /opt/helium/helium-wrapper)}"
fi
wait "${pid}" || true
