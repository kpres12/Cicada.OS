#!/usr/bin/env bash
# If hyprlock has been running longer than CICADA_LOCK_REBOOT_SEC (default 30 min), reboot to rest.
# Unlocked sessions reset the timer. Does not reboot a machine that is in use.
set -euo pipefail
MAX="${CICADA_LOCK_REBOOT_SEC:-1800}"
if [[ -f /etc/cicada/defaults.env ]]; then
  # shellcheck disable=SC1091
  source /etc/cicada/defaults.env
  MAX="${CICADA_LOCK_REBOOT_SEC:-1800}"
fi
LID_MAX="${CICADA_LID_REBOOT_SEC:-120}"
STAMP=/run/cicada/locked-since
mkdir -p /run/cicada

# A shut lid means the machine is in a bag or in someone else's hands. Collapse
# the window to BFU accordingly — an AFU machine is one where the volume key is
# still in RAM and recoverable by anyone who has the hardware.
lid_closed() {
  local f
  for f in /proc/acpi/button/lid/*/state; do
    [[ -r "${f}" ]] || continue
    grep -qi closed "${f}" && return 0
  done
  return 1
}

if pgrep -x hyprlock >/dev/null 2>&1; then
  if [[ ! -f "${STAMP}" ]]; then
    date +%s > "${STAMP}"
  fi
  start="$(cat "${STAMP}")"
  now="$(date +%s)"
  if lid_closed; then
    MAX="${LID_MAX}"
  fi
  if (( now - start >= MAX )); then
    logger -t cicada "locked ${MAX}s — forcing reboot to rest (LUKS / BFU)"
    systemctl reboot --force || echo b > /proc/sysrq-trigger
  fi
else
  rm -f "${STAMP}"
fi
