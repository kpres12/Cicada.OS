#!/usr/bin/env bash
# Root helper for cicada-pkg. Official repos + curated Flatpak. No AUR.
# Curated pacman names install via `install`; anything else needs `install-any`
# (still password via pkexec — never NOPASSWD).
set -euo pipefail
[[ ${EUID} -eq 0 ]] || { echo "cicada-pkg-helper: root only" >&2; exit 1; }

usage() {
  echo "usage: cicada-pkg-helper install <pkg>          # curated allowlist" >&2
  echo "       cicada-pkg-helper install-any <pkg>      # official repo, password path" >&2
  echo "       cicada-pkg-helper flatpak-remote" >&2
  echo "       cicada-pkg-helper flatpak-install <app-id>" >&2
  echo "       cicada-pkg-helper flatpak-harden <app-id>  # re-apply the system floors" >&2
  exit 1
}
[[ $# -ge 1 ]] || usage
cmd="$1"
shift || true

# Daily-driver packages — Settings catalog + common tools. No AUR/-git.
# shellcheck disable=SC2034
CURATED_PACMAN=(
  htop btop git nano vim code firefox
  python python-pip base-devel make cmake
  curl wget rsync zip unzip p7zip
  jq tree ripgrep fd bat eza
  gimp inkscape obs-studio
  mpv ffmpeg imagemagick
  keepassxc veracrypt
  wireguard-tools openvpn
  docker docker-compose
  nodejs npm rust go
  cowsay fortune-mod
)

is_curated_pacman() {
  local p="$1" x
  for x in "${CURATED_PACMAN[@]}"; do
    [[ "${x}" == "${p}" ]] && return 0
  done
  return 1
}

validate_pkg_name() {
  local pkg="$1"
  [[ "${pkg}" =~ ^[a-zA-Z0-9@._+-]+$ ]] || { echo "invalid package name" >&2; exit 1; }
  case "${pkg}" in
    */*|*:*|*.pkg.tar*) echo "refusing path/url install" >&2; exit 1 ;;
    *-git|*-bin|*-appimage) echo "refusing VCS/bin package name" >&2; exit 1 ;;
  esac
}

pacman_install() {
  local pkg="$1"
  export LANG=C
  pacman -Sy --noconfirm --needed "${pkg}"
}

apply_flatpak_overrides() {
  local app_id="$1"
  # Honest floors: no full $HOME. Downloads (+ media/docs where the app needs them).
  flatpak override --system --nofilesystem=home --filesystem=xdg-download "${app_id}" || true
  case "${app_id}" in
    com.spotify.Client)
      flatpak override --system --filesystem=xdg-music "${app_id}" || true
      ;;
    org.videolan.VLC)
      flatpak override --system \
        --filesystem=xdg-videos --filesystem=xdg-music --filesystem=xdg-pictures \
        "${app_id}" || true
      ;;
    org.libreoffice.LibreOffice)
      flatpak override --system --filesystem=xdg-documents "${app_id}" || true
      ;;
    org.signal.Signal|org.telegram.desktop|com.discordapp.Discord|\
    chat.simplex.simplex|im.riot.Riot)
      # Chat: Downloads only (already set). No Documents/Pictures by default.
      #
      # These are --system on purpose. A --user override can grant back what a
      # user override removed, so a floor written at user level is not a floor —
      # the same rule cicada-scopes enforces for cicada-run scopes.
      #
      # X11 is refused outright rather than left as a fallback: Cicada is
      # Wayland-only, so nothing here needs it, and an app holding the X socket
      # reads every keystroke sent to every other X client.
      flatpak override --system --nosocket=x11 --nosocket=fallback-x11 "${app_id}" || true
      # Camera and mic through the portal — a prompt at the moment of use —
      # rather than as a standing grant for the life of the install.
      flatpak override --system --nodevice=all --device=dri "${app_id}" || true
      ;;
  esac
}

case "${cmd}" in
  install)
    [[ $# -ge 1 ]] || usage
    pkg="$1"
    validate_pkg_name "${pkg}"
    if ! is_curated_pacman "${pkg}"; then
      echo "not in Cicada curated list: ${pkg}" >&2
      echo "use: cicada-pkg-helper install-any ${pkg}  (still needs admin password)" >&2
      exit 2
    fi
    pacman_install "${pkg}"
    ;;
  install-any)
    [[ $# -ge 1 ]] || usage
    pkg="$1"
    validate_pkg_name "${pkg}"
    # Official repos only; name already validated. Password comes from pkexec/sudo caller.
    pacman_install "${pkg}"
    ;;
  flatpak-remote)
    command -v flatpak >/dev/null 2>&1 || { echo "flatpak missing" >&2; exit 1; }
    if ! flatpak remotes --system 2>/dev/null | grep -qw flathub; then
      flatpak remote-add --if-not-exists --system flathub \
        https://dl.flathub.org/repo/flathub.flatpakrepo
    fi
    ;;
  flatpak-install)
    [[ $# -ge 1 ]] || usage
    app_id="$1"
    case "${app_id}" in
      com.spotify.Client|com.discordapp.Discord|org.signal.Signal|\
      org.telegram.desktop|org.videolan.VLC|org.libreoffice.LibreOffice|\
      chat.simplex.simplex|im.riot.Riot) ;;
      *)
        echo "app not in Cicada allowlist: ${app_id}" >&2
        exit 1
        ;;
    esac
    command -v flatpak >/dev/null 2>&1 || { echo "flatpak missing" >&2; exit 1; }
    if ! flatpak remotes --system 2>/dev/null | grep -qw flathub; then
      flatpak remote-add --if-not-exists --system flathub \
        https://dl.flathub.org/repo/flathub.flatpakrepo
    fi
    flatpak install -y --system flathub "${app_id}"
    apply_flatpak_overrides "${app_id}"
    ;;
  flatpak-harden)
    # Re-apply the floors without reinstalling. A Flatpak update can reset an
    # app's permissions to whatever the new manifest asks for, so this needs to
    # be runnable on its own — cicada-comms harden is the front end.
    [[ $# -ge 1 ]] || usage
    app_id="$1"
    case "${app_id}" in
      org.signal.Signal|chat.simplex.simplex|im.riot.Riot|\
      org.telegram.desktop|com.discordapp.Discord|com.spotify.Client|\
      org.videolan.VLC|org.libreoffice.LibreOffice) ;;
      *) echo "app not in Cicada allowlist: ${app_id}" >&2; exit 1 ;;
    esac
    command -v flatpak >/dev/null 2>&1 || { echo "flatpak missing" >&2; exit 1; }
    apply_flatpak_overrides "${app_id}"
    ;;
  *) usage ;;
esac
