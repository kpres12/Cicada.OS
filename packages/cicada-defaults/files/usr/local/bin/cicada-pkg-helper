#!/usr/bin/env bash
# Root helper for cicada-pkg. Official repos + curated Flatpak. No AUR.
# Curated pacman names install via `install`; anything else needs `install-any`
# (still password via pkexec — never NOPASSWD).
set -euo pipefail
[[ ${EUID} -eq 0 ]] || { echo "cicada-pkg-helper: root only" >&2; exit 1; }

usage() {
  echo "usage: cicada-pkg-helper install <pkg>          # curated allowlist" >&2
  echo "       cicada-pkg-helper install-any <pkg>      # official repo, password path" >&2
  echo "       cicada-pkg-helper flatpak-remote" >&2
  echo "       cicada-pkg-helper flatpak-install <app-id>      # curated" >&2
  echo "       cicada-pkg-helper flatpak-install-any <app-id>  # any Flathub app, floors still applied" >&2
  echo "       cicada-pkg-helper flatpak-harden <app-id>  # re-apply the system floors" >&2
  exit 1
}
[[ $# -ge 1 ]] || usage
cmd="$1"
shift || true

# Daily-driver packages — Settings catalog + common tools. No AUR/-git.
# shellcheck disable=SC2034
# A hardened OS nobody can read their email on protects nobody. Everything here
# is from Arch's official repos (no AUR) and everything graphical still launches
# through a cicada-run scope or, for Flatpaks, under the floors below. Breadth
# is not the risk; an unsandboxed launcher path would be, and there isn't one.
CURATED_PACMAN=(
  # CLI and system tools ONLY. Graphical applications belong in CURATED_FLATPAK,
  # where they land under the system-level floors in apply_flatpak_overrides.
  #
  # This list previously carried gimp, vlc, libreoffice, firefox, krita and the
  # rest. That was a mistake: a pacman-installed GUI app gets no cicada-run scope
  # and no Flatpak floor, so it reads the whole home directory — and five of them
  # were ALSO on the Flatpak list, meaning a user could install the unsandboxed
  # copy of an application Cicada already offered sandboxed. docs/PRODUCT.md
  # already said these are "not on the Cicada scopes sheet"; now they are not on
  # the pacman path either.
  #
  # pacman stays for command-line tools because Flatpak is built for GUI apps and
  # is a poor fit for something that has to see your files and your shell — and
  # because Kitty is the owner's escape hatch, which is meaningless if the owner
  # cannot install git.
  # shell / dev
  htop btop git nano vim
  # code is the one graphical exception, and it is deliberate. An IDE exists to
  # drive compilers, language servers and your working tree; a sandbox that
  # denies it the filesystem denies it its job, which is why the VS Code Flatpak
  # is a known source of pain. It sits with git and docker as a developer tool,
  # not with the media apps. Everything that merely *renders* untrusted content
  # is a Flatpak.
  code
  python python-pip base-devel make cmake
  curl wget rsync zip unzip p7zip
  jq tree ripgrep fd bat eza
  nodejs npm rust go
  docker docker-compose
  # security / network — need system integration, cannot be Flatpaks
  keepassxc veracrypt
  wireguard-tools openvpn
  syncthing
  # media/codec libraries and CLI encoders (not the GUI players)
  ffmpeg imagemagick
  # misc
  cowsay fortune-mod
)

# --- Flatpak catalog -------------------------------------------------------
#
# One table, used by both flatpak-install and flatpak-harden. They used to carry
# separate copies of the allowlist, which is a drift bug waiting to happen: an
# app installable but not hardenable would keep Flathub's own permissions after
# the first update that reset them.
#
# Breadth here is deliberate. A privacy OS nobody can read their mail or play
# music on does not get used, and an OS that does not get used protects nobody.
# What keeps this safe is not a short list, it is that every entry lands under
# system-level floors below Flathub's defaults (see apply_flatpak_overrides) —
# and --system, so a --user override cannot grant back what was taken away.
#
# Format: <app-id> <extra-filesystem-floor|-> <note>
CURATED_FLATPAK=(
  # mail. Deliberately NOT the [extra] thunderbird package: email is
  # attacker-controlled content arriving from strangers, which is exactly the
  # workload that belongs behind a sandbox rather than beside one.
  "org.mozilla.Thunderbird xdg-documents mail"
  # chat
  "org.signal.Signal - chat"
  "chat.simplex.simplex - chat"
  "im.riot.Riot - chat"
  "org.telegram.desktop - chat"
  "com.discordapp.Discord - chat"
  "com.slack.Slack - chat"
  # music / media
  "org.js.nuclear.Nuclear xdg-music music"
  "com.spotify.Client xdg-music music"
  "org.videolan.VLC xdg-videos media"
  # notes / documents
  "md.obsidian.Obsidian xdg-documents notes"
  "io.appflowy.AppFlowy xdg-documents notes"
  # Notion has no official Linux client. Cohesion is a third-party wrapper by a
  # Flathub-verified publisher who is not Notion — a browser tab in Helium runs
  # the same web app with one less maintainer in the trust path. Listed because
  # it was asked for; the note is printed at install so the choice is informed.
  "io.github.brunofin.Cohesion xdg-documents notion-unofficial"
  # office / reading
  "org.libreoffice.LibreOffice xdg-documents office"
  "org.onlyoffice.desktopeditors xdg-documents office"
  "org.kde.okular xdg-documents reader"
  # graphics
  "org.gimp.GIMP xdg-pictures graphics"
  "org.inkscape.Inkscape xdg-pictures graphics"
  "org.kde.krita xdg-pictures graphics"
  "org.darktable.Darktable xdg-pictures photos"
  # audio / video. These are the ones that used to be installed via pacman with
  # no sandbox at all, which is the worst place for software that parses hostile
  # media files from the internet.
  "io.mpv.Mpv xdg-videos media"
  "org.audacityteam.Audacity xdg-music audio"
  "org.strawberrymusicplayer.strawberry xdg-music music"
  "com.obsproject.Studio xdg-videos capture"
  # reading
  "org.gnome.Evince xdg-documents reader"
  # a second browser engine, sandboxed rather than loose on the system
  "org.mozilla.firefox - browser"
  # passwords
  "com.bitwarden.desktop - vault"
)
# Flatseal is deliberately absent: it exists to rewrite Flatpak permissions, and
# a tool that hands the user a button to undo the floors above is not a floor.

flatpak_row() {
  local id="$1" row
  for row in "${CURATED_FLATPAK[@]}"; do
    [[ "${row%% *}" == "${id}" ]] && { printf '%s' "${row}"; return 0; }
  done
  return 1
}
is_allowed_flatpak() { flatpak_row "$1" >/dev/null; }

is_curated_pacman() {
  local p="$1" x
  for x in "${CURATED_PACMAN[@]}"; do
    [[ "${x}" == "${p}" ]] && return 0
  done
  return 1
}

validate_pkg_name() {
  local pkg="$1"
  [[ "${pkg}" =~ ^[a-zA-Z0-9@._+-]+$ ]] || { echo "invalid package name" >&2; exit 1; }
  case "${pkg}" in
    */*|*:*|*.pkg.tar*) echo "refusing path/url install" >&2; exit 1 ;;
    *-git|*-bin|*-appimage) echo "refusing VCS/bin package name" >&2; exit 1 ;;
  esac
}

pacman_install() {
  local pkg="$1"
  export LANG=C
  pacman -Sy --noconfirm --needed "${pkg}"
}

apply_flatpak_overrides() {
  local app_id="$1" row="" extra="" note=""
  # NOTE the missing `|| return 0`. This used to bail out for any app that was
  # not in the table, which meant an unlisted app received NO floors whatever —
  # fine while the allowlist was the only way in, and exactly wrong the moment
  # there is an escape hatch. The floor is now unconditional and the table only
  # adds the one extra directory an app needs.
  #
  # This is the split that matters: the FLOORS are the containment, and they
  # apply to everything. The allowlist is curation — it protects a user from
  # choosing badly, which is a different job and not one worth capping the
  # system at 27 applications for.
  if row="$(flatpak_row "${app_id}")"; then
    extra="$(awk '{print $2}' <<<"${row}")"
    note="$(awk '{print $3}' <<<"${row}")"
  fi

  #   --nofilesystem=home  Flathub grants broad host access so attachments "just
  #                        work"; it also means one renderer bug reads every
  #                        document in the profile.
  #   --nosocket=x11       Cicada is Wayland-only, so nothing needs it, and an
  #                        app holding the X socket reads every keystroke sent to
  #                        every other X client.
  #   --nodevice=all       Camera and mic come through the portal — a prompt at
  #     --device=dri       the moment of use — not as a standing grant for the
  #                        life of the install. dri is kept so things render.
  #
  # --system throughout: a --user override can grant back what a user override
  # removed, so a floor written at user level is not a floor.
  flatpak override --system --nofilesystem=home --filesystem=xdg-download "${app_id}" || true
  flatpak override --system --nosocket=x11 --nosocket=fallback-x11 "${app_id}" || true
  flatpak override --system --nodevice=all --device=dri "${app_id}" || true

  if [[ -n "${extra}" && "${extra}" != "-" ]]; then
    flatpak override --system --filesystem="${extra}" "${app_id}" || true
  fi

  if [[ "${note}" == "notion-unofficial" ]]; then
    echo "note: ${app_id} is a third-party wrapper around notion.so, not an" >&2
    echo "      official Notion client. Helium runs the same web app with one" >&2
    echo "      less maintainer in the trust path." >&2
  fi
}

# Applications whose entire purpose is to rewrite Flatpak permissions. Installing
# one hands the user a button to undo every floor above, so it is refused on both
# the curated and the open path — this is the one thing an escape hatch may not
# escape. Not a moral judgement on the software; Flatseal is good at its job.
is_permission_tool() {
  case "$1" in
    com.github.tchx84.Flatseal|io.github.flattool.Warehouse) return 0 ;;
    *) return 1 ;;
  esac
}

# Reverse-DNS, which is what Flathub enforces. Rejects paths, URLs, shell
# metacharacters and anything that could be read as a flatpak flag.
valid_app_id() {
  [[ "$1" =~ ^[A-Za-z][A-Za-z0-9_-]*(\.[A-Za-z0-9_-]+){2,}$ ]]
}

case "${cmd}" in
  install)
    [[ $# -ge 1 ]] || usage
    pkg="$1"
    validate_pkg_name "${pkg}"
    if ! is_curated_pacman "${pkg}"; then
      echo "not in Cicada curated list: ${pkg}" >&2
      echo "use: cicada-pkg-helper install-any ${pkg}  (still needs admin password)" >&2
      exit 2
    fi
    pacman_install "${pkg}"
    ;;
  install-any)
    [[ $# -ge 1 ]] || usage
    pkg="$1"
    validate_pkg_name "${pkg}"
    # Official repos only; name already validated. Password comes from pkexec/sudo caller.
    pacman_install "${pkg}"
    ;;
  flatpak-remote)
    command -v flatpak >/dev/null 2>&1 || { echo "flatpak missing" >&2; exit 1; }
    if ! flatpak remotes --system 2>/dev/null | grep -qw flathub; then
      flatpak remote-add --if-not-exists --system flathub \
        https://dl.flathub.org/repo/flathub.flatpakrepo
    fi
    ;;
  flatpak-install)
    [[ $# -ge 1 ]] || usage
    app_id="$1"
    is_allowed_flatpak "${app_id}" || {
      echo "app not in Cicada allowlist: ${app_id}" >&2
      exit 1
    }
    command -v flatpak >/dev/null 2>&1 || { echo "flatpak missing" >&2; exit 1; }
    if ! flatpak remotes --system 2>/dev/null | grep -qw flathub; then
      flatpak remote-add --if-not-exists --system flathub \
        https://dl.flathub.org/repo/flathub.flatpakrepo
    fi
    flatpak install -y --system flathub "${app_id}"
    apply_flatpak_overrides "${app_id}"
    ;;
  flatpak-install-any)
    # The counterpart to install-any for pacman. Without it the policy was
    # incoherent: any of ~14000 Arch packages with a password, but graphical
    # software capped at 27. The floors are what protect the user, and they now
    # apply to every app regardless of whether it is on the list.
    [[ $# -ge 1 ]] || usage
    app_id="$1"
    valid_app_id "${app_id}" || { echo "not a Flatpak application id: ${app_id}" >&2; exit 1; }
    is_permission_tool "${app_id}" && {
      echo "refusing ${app_id}: it exists to rewrite Flatpak permissions, which" >&2
      echo "would undo the floors Cicada applies to every app on this system." >&2
      exit 1
    }
    command -v flatpak >/dev/null 2>&1 || { echo "flatpak missing" >&2; exit 1; }
    if ! flatpak remotes --system 2>/dev/null | grep -qw flathub; then
      flatpak remote-add --if-not-exists --system flathub \
        https://dl.flathub.org/repo/flathub.flatpakrepo
    fi
    is_allowed_flatpak "${app_id}" \
      || echo "note: ${app_id} is not on the Cicada curated list. Installing anyway;" >&2
    is_allowed_flatpak "${app_id}" \
      || echo "      the standard floors still apply (home denied, Downloads only, no X11, no devices)." >&2
    flatpak install -y --system flathub "${app_id}"
    apply_flatpak_overrides "${app_id}"
    ;;

  flatpak-harden)
    # Re-apply the floors without reinstalling. A Flatpak update can reset an
    # app's permissions to whatever the new manifest asks for, so this needs to
    # be runnable on its own — cicada-comms harden is the front end.
    [[ $# -ge 1 ]] || usage
    app_id="$1"
    # Any installed app, not just curated ones: a Flatpak update can reset
    # permissions to whatever the new manifest asks for, and an app installed
    # through flatpak-install-any needs re-hardening just as much.
    valid_app_id "${app_id}" || { echo "not a Flatpak application id: ${app_id}" >&2; exit 1; }
    command -v flatpak >/dev/null 2>&1 || { echo "flatpak missing" >&2; exit 1; }
    apply_flatpak_overrides "${app_id}"
    ;;
  *) usage ;;
esac
