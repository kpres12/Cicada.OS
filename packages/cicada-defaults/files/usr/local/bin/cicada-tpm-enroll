#!/usr/bin/env bash
# Seal the LUKS key to the TPM2, gated behind a PIN.
#
# THE PIN IS THE POINT. Sealing to PCRs alone means the disk unlocks itself
# whenever the machine boots into the expected firmware state — a stolen laptop
# powers on and decrypts, and only the login password stands between an attacker
# and the data. That is weaker than a passphrase, not stronger.
#
# With --tpm2-with-pin, unsealing requires the PIN *and* the TPM performs the
# check itself. The TPM's dictionary-attack lockout then rate-limits guessing in
# hardware: wrong attempts increment a counter the CPU cannot reset, and the TPM
# refuses to cooperate for an escalating cooldown.
#
# That is the property that makes a 6-digit PIN safe on a Pixel behind Titan M2,
# and it is the closest a commodity x86 laptop gets to it. On this path the
# secret can be short and memorable *because* the hardware throttles guessing —
# which is the opposite of the no-TPM path, where the passphrase must carry 80+
# bits because nothing rate-limits an offline attack on a disk image.
#
# The passphrase keyslot is always kept. Firmware updates change PCRs and will
# make unsealing fail; that is the tamper signal working, and you type the
# passphrase and re-enroll.
set -euo pipefail

WITH_PIN=1
PCRS="${CICADA_TPM_PCRS:-}"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-pin) WITH_PIN=0 ;;   # deliberately undocumented in --help; see below
    --pcrs) PCRS="${2:?}"; shift ;;
    -h|--help)
      cat <<'EOF'
usage: cicada-tpm-enroll [--pcrs 0+7]

Seals the LUKS key to the TPM2 behind a PIN. The TPM rate-limits PIN guessing
in hardware, so a short PIN is safe here in a way it never is on a machine
without a TPM.

Your passphrase keyslot is kept. If a firmware update changes the measurements,
unsealing fails by design — type the passphrase and re-run this.
EOF
      exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 1 ;;
  esac
  shift
done

if [[ ! -c /dev/tpmrm0 && ! -c /dev/tpm0 ]]; then
  echo "cicada-tpm-enroll: no TPM2 on this machine (Apple EFI MBA: expected)." >&2
  echo "Passphrase-only LUKS stays. Nothing here can rate-limit guessing without a TPM." >&2
  exit 2
fi
[[ ${EUID} -eq 0 ]] || { echo "run as root" >&2; exit 1; }
command -v systemd-cryptenroll >/dev/null || { echo "systemd-cryptenroll missing" >&2; exit 1; }

dev=""
if [[ -f /etc/cicada/install.env ]]; then
  # shellcheck disable=SC1091
  source /etc/cicada/install.env
  [[ -n "${CICADA_LUKS_UUID:-}" ]] && dev="/dev/disk/by-uuid/${CICADA_LUKS_UUID}"
fi
if [[ -z "${dev}" || ! -e "${dev}" ]]; then
  dev="$(cryptsetup status cicada 2>/dev/null | awk '/device:/{print $2}')"
fi
[[ -n "${dev}" && -e "${dev}" ]] || { echo "cannot find LUKS device (boot the installed system)" >&2; exit 1; }

# PCR choice is a usability/security trade, so pick deliberately:
#   7  Secure Boot policy — changes if someone disables Secure Boot or swaps keys.
#   0  Firmware code — changes if the firmware itself is replaced.
#   11 The UKI, when one is in use; the strongest binding, set by the caller.
# PCRs 1 and 3 are firmware *configuration* and option ROMs: they churn on
# unrelated setting changes and dock/GPU swaps, which trains users to re-enroll
# reflexively and defeats the point of a tamper signal.

# The existence of a UKI on the ESP is NOT evidence that one booted. If the
# machine came up through a leftover type-1 entry, PCR 11 is still all-zeros, and
# sealing to it would bind the disk to "booted without a UKI" — the exact state
# we are trying to make unbootable. The next real UKI boot would then fail to
# unseal and the user would be back on the passphrase, blaming the TPM.
#
# So ask the TPM what actually happened. systemd-stub extends PCR 11 with each
# UKI section, so a non-zero PCR 11 means a UKI measured itself this boot, and an
# all-zero one means nothing did.
uki_measured() {
  local f v
  for f in /sys/class/tpm/tpm0/pcr-sha256/11 /sys/class/tpm/tpm0/pcrs; do
    [[ -r "${f}" ]] || continue
    v="$(tr -d '[:space:]' < "${f}" 2>/dev/null | tr -d '0')"
    [[ -n "${v}" ]] && return 0
  done
  if command -v tpm2_pcrread >/dev/null 2>&1; then
    v="$(tpm2_pcrread sha256:11 2>/dev/null | tr -d '[:space:]' | sed 's/.*0x//' | tr -d '0')"
    [[ -n "${v}" ]] && return 0
  fi
  return 1
}

if [[ -z "${PCRS}" ]]; then
  if uki_measured; then
    PCRS="0+7+11"
  else
    PCRS="0+7"
    if compgen -G "/boot/EFI/Linux/*.efi" >/dev/null 2>&1 \
       || compgen -G "/efi/EFI/Linux/*.efi" >/dev/null 2>&1; then
      echo "Note: a UKI exists on the ESP but PCR 11 is empty, so this boot did" >&2
      echo "not come from it. Sealing to 0+7 only. Remove the leftover type-1" >&2
      echo "entries (cicada-uki build), reboot into the UKI, and re-run this to" >&2
      echo "get the full 0+7+11 binding." >&2
    fi
  fi
fi

echo "Sealing ${dev} to TPM2 PCRs ${PCRS}"
if [[ "${WITH_PIN}" == 1 ]]; then
  echo
  echo "You will be asked for a NEW PIN. This is not your passphrase."
  echo "It can be short — the TPM rate-limits guessing in hardware — but it must"
  echo "not be one an observer could shoulder-surf and reuse."
  echo
  systemd-cryptenroll --tpm2-device=auto --tpm2-pcrs="${PCRS}" --tpm2-with-pin=yes "${dev}"
  crypttab_opts="tpm2-device=auto"
else
  # Reachable only via --no-pin. Kept for machines used as unattended servers,
  # where nobody is present to type anything. On a laptop this means the disk
  # decrypts itself on power-on, so it is never the default.
  echo "WARNING: enrolling WITHOUT a PIN. This disk will unlock automatically" >&2
  echo "whenever the machine boots into the expected state. A thief who powers" >&2
  echo "it on gets a decrypted disk. Only do this for an unattended server." >&2
  read -r -p "Type UNATTENDED to continue: " ans
  [[ "${ans}" == UNATTENDED ]] || { echo "aborted"; exit 1; }
  systemd-cryptenroll --tpm2-device=auto --tpm2-pcrs="${PCRS}" "${dev}"
  crypttab_opts="tpm2-device=auto"
fi

if [[ -f /etc/crypttab ]]; then
  if grep -q 'tpm2-device=' /etc/crypttab; then
    :
  else
    sed -i "s/ none luks$/ none luks,${crypttab_opts}/" /etc/crypttab || true
  fi
fi
command -v cicada-seal >/dev/null && \
  cicada-seal append tpm.enroll "{\"pcrs\":\"${PCRS}\",\"pin\":${WITH_PIN}}" >/dev/null 2>&1 || true

echo
echo "Rebuilding initramfs so cicada-crypt can talk to the TPM…"
mkinitcpio -P
echo
echo "Enrolled. Boot asks for TPM PIN first; passphrase remains the fallback."
echo "If a firmware update changes PCRs, unsealing fails — type the passphrase"
echo "and re-run cicada-tpm-enroll (tamper signal, not a fault)."
