#!/usr/bin/env bash
# Channel-first updates. Never instruct users to raw `pacman -Syu` from Arch.
# Fail closed: refuse to install from cicada-stable unless signatures are Required.
set -euo pipefail

die() {
  echo "cicada-update: $1" >&2
  if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v zenity >/dev/null 2>&1; then
    zenity --error --title="Cicada — Update" --width=440 --text="$1" 2>/dev/null || true
  fi
  exit 1
}

info() {
  echo "$*"
  if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v zenity >/dev/null 2>&1; then
    zenity --info --title="Cicada — Update" --width=440 --text="$*" 2>/dev/null || true
  fi
}

[[ ${EUID} -eq 0 ]] || exec sudo "$0" "$@"

if [[ -x /usr/local/lib/cicada/cicada-channel-enable.sh ]]; then
  /usr/local/lib/cicada/cicada-channel-enable.sh /etc/pacman.conf || true
fi

pin="$(cat /etc/cicada/channel 2>/dev/null || cat /usr/share/cicada/channel/CURRENT 2>/dev/null || echo unknown)"
echo "==> channel pin: ${pin}"

# Key import + local signing happens in cicada-channel-enable.sh above, which is
# also what firstboot and install-chroot call. Keeping a second copy here meant
# the key got added but never locally signed, so SigLevel=Required rejected the
# database as untrusted.

# Unsigned remote upgrades + NOPASSWD would be root RCE via mirror MITM.
has_key=0
[[ -f /etc/pacman.d/cicada-stable-key.gpg || -f /etc/pacman.d/cicada-stable-key.asc ]] && has_key=1
sig="$(awk '/^\[cicada-stable\]/{p=1;next} /^\[/{p=0} p && /^SigLevel/{print $3; exit}' \
  /etc/pacman.d/cicada-repos.conf 2>/dev/null || true)"
remote=0
grep -qE '^Server = https?://' /etc/pacman.d/cicada-repos.conf 2>/dev/null && remote=1

if [[ "${remote}" -eq 1 && "${has_key}" -eq 0 ]]; then
  die "Hosted cicada-stable mirror is set, but no Cicada signing key is installed.

Refusing to update (unsigned remote packages + root helper = fail open).
Install /etc/pacman.d/cicada-stable-key.gpg from a trusted ISO, or remove
/etc/cicada/channel-mirror.url and reflash for a new build."
fi
if [[ "${remote}" -eq 1 && "${sig}" != "Required" ]]; then
  die "cicada-stable SigLevel is '${sig:-unset}', not Required. Refusing hosted update."
fi

echo "==> syncing cicada-stable"
if ! pacman -Sy --noconfirm 2>&1 | tee /tmp/cicada-update-sync.log; then
  die "pacman -Sy failed. Check network / mirror URL in /etc/cicada/channel-mirror.url"
fi

mapfile -t channel_pkgs < <(pacman -Slq cicada-stable 2>/dev/null || true)
if [[ ${#channel_pkgs[@]} -eq 0 ]]; then
  info "No cicada-stable packages on this machine yet.

Your ISO pin is the product version (${pin}).
Host a signed repo (scripts/channel-publish.sh) or reflash for a new build.

Raw Arch rolling is not the Cicada update path."
  exit 0
fi

if [[ "${has_key}" -eq 0 ]]; then
  # Local file:// repo only — still warn; do not pull https without a key.
  info "Upgrading ${#channel_pkgs[@]} local channel package(s) (no signing key yet — file:// only)."
fi

echo "==> upgrading ${#channel_pkgs[@]} channel package(s)"
pacman -S --needed --noconfirm "${channel_pkgs[@]}"
info "Channel update finished (${pin})."
