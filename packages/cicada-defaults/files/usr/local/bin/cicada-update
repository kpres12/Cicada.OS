#!/usr/bin/env bash
# Channel-first updates. Never instruct users to raw `pacman -Syu` from Arch.
set -euo pipefail

die() {
  echo "cicada-update: $1" >&2
  if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v zenity >/dev/null 2>&1; then
    zenity --error --title="Cicada — Update" --width=440 --text="$1" 2>/dev/null || true
  fi
  exit 1
}

info() {
  echo "$*"
  if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v zenity >/dev/null 2>&1; then
    zenity --info --title="Cicada — Update" --width=440 --text="$*" 2>/dev/null || true
  fi
}

[[ ${EUID} -eq 0 ]] || exec sudo -n "$0" "$@" 2>/dev/null || exec sudo "$0" "$@"

if [[ -x /usr/local/lib/cicada/cicada-channel-enable.sh ]]; then
  /usr/local/lib/cicada/cicada-channel-enable.sh /etc/pacman.conf || true
fi

pin="$(cat /etc/cicada/channel 2>/dev/null || cat /usr/share/cicada/channel/CURRENT 2>/dev/null || echo unknown)"
echo "==> channel pin: ${pin}"

# Import pubkey once when present.
if [[ -f /etc/pacman.d/cicada-stable-key.gpg ]] && command -v pacman-key >/dev/null 2>&1; then
  pacman-key --add /etc/pacman.d/cicada-stable-key.gpg 2>/dev/null || true
fi

echo "==> syncing cicada-stable"
if ! pacman -Sy --noconfirm 2>&1 | tee /tmp/cicada-update-sync.log; then
  die "pacman -Sy failed. Check network / mirror URL in /etc/cicada/channel-mirror.url"
fi

mapfile -t channel_pkgs < <(pacman -Slq cicada-stable 2>/dev/null || true)
if [[ ${#channel_pkgs[@]} -eq 0 ]]; then
  info "No cicada-stable packages on this machine yet.

Your ISO pin is the product version (${pin}).
Host a signed repo (scripts/channel-publish.sh) or reflash for a new build.

Raw Arch rolling is not the Cicada update path."
  exit 0
fi

echo "==> upgrading ${#channel_pkgs[@]} channel package(s)"
pacman -S --needed --noconfirm "${channel_pkgs[@]}"
info "Channel update finished (${pin})."
