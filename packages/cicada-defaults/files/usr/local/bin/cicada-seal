#!/usr/bin/env python3
"""Cicada seal log — Ed25519-signed, SHA-256 hash-chained (Heli.OS-shaped audit).

init / append / verify / pubkey / tip
Does not prompt. Signing is the device key. Destructive gates stay in cicada-auth.
"""
from __future__ import annotations

import base64
import hashlib
import json
import os
import subprocess
import sys
import tempfile
import time
from pathlib import Path

DIR = Path(os.environ.get("CICADA_SEAL_DIR", "/var/lib/cicada"))
if not os.access(DIR, os.W_OK):
    DIR = Path.home() / ".local/share/cicada"
DIR.mkdir(parents=True, exist_ok=True)
KEY = DIR / "device.key"
PUB = DIR / "device.pub"
LOG = DIR / "seal.jsonl"
GENESIS = "cicada-seal-v1"
BODY_KEYS = ("seq", "ts", "prev", "action", "detail", "uid")


def _run(cmd: list[str], data: bytes | None = None) -> bytes:
    return subprocess.check_output(cmd, input=data, stderr=subprocess.DEVNULL)


def init() -> None:
    if not KEY.exists():
        _run(["openssl", "genpkey", "-algorithm", "ED25519", "-out", str(KEY)])
        KEY.chmod(0o440)
        pub = _run(["openssl", "pkey", "-in", str(KEY), "-pubout"])
        PUB.write_bytes(pub)
        PUB.chmod(0o444)
    if not LOG.exists():
        append("seal.init", {"host": os.uname().nodename})
        print(f"initialized {LOG}")
    else:
        print(f"already {LOG}")


def _tip() -> tuple[int, str]:
    if not LOG.exists() or LOG.stat().st_size == 0:
        return -1, GENESIS
    last = LOG.read_text().strip().splitlines()[-1]
    obj = json.loads(last)
    return int(obj["seq"]), str(obj["hash"])


def _canonical(obj: dict) -> bytes:
    body = {k: obj[k] for k in BODY_KEYS}
    return json.dumps(body, sort_keys=True, separators=(",", ":")).encode()


def _sign(payload: bytes) -> str:
    if not KEY.exists():
        init()
    with tempfile.NamedTemporaryFile() as inf:
        inf.write(payload)
        inf.flush()
        sig = _run(
            [
                "openssl",
                "pkeyutl",
                "-sign",
                "-inkey",
                str(KEY),
                "-rawin",
                "-in",
                inf.name,
            ]
        )
    return base64.b64encode(sig).decode("ascii")


def _verify_sig(payload: bytes, sig_b64: str) -> bool:
    if not PUB.exists():
        return False
    raw = base64.b64decode(sig_b64)
    with tempfile.NamedTemporaryFile() as sigf, tempfile.NamedTemporaryFile() as inf:
        sigf.write(raw)
        sigf.flush()
        inf.write(payload)
        inf.flush()
        try:
            _run(
                [
                    "openssl",
                    "pkeyutl",
                    "-verify",
                    "-pubin",
                    "-inkey",
                    str(PUB),
                    "-rawin",
                    "-in",
                    inf.name,
                    "-sigfile",
                    sigf.name,
                ]
            )
            return True
        except subprocess.CalledProcessError:
            return False


def append(action: str, detail: dict | None = None) -> str:
    seq, prev = _tip()
    seq += 1
    body = {
        "seq": seq,
        "ts": int(time.time()),
        "prev": prev,
        "action": action,
        "detail": detail or {},
        "uid": os.getuid(),
    }
    canonical = _canonical(body)
    digest = hashlib.sha256(canonical).hexdigest()
    body["hash"] = digest
    body["sig"] = _sign(canonical)
    with LOG.open("a") as f:
        f.write(json.dumps(body, separators=(",", ":")) + "\n")
    return digest


def verify() -> int:
    if not LOG.exists():
        print("no log")
        return 1
    prev = GENESIS
    expect = 0
    for line in LOG.read_text().splitlines():
        obj = json.loads(line)
        if obj["seq"] != expect:
            print(f"seq break at {obj['seq']}")
            return 1
        if obj["prev"] != prev:
            print(f"chain break at seq {obj['seq']}")
            return 1
        canonical = _canonical(obj)
        if hashlib.sha256(canonical).hexdigest() != obj["hash"]:
            print(f"hash mismatch seq {obj['seq']}")
            return 1
        if not _verify_sig(canonical, obj["sig"]):
            print(f"sig mismatch seq {obj['seq']}")
            return 1
        prev = obj["hash"]
        expect += 1
    print(f"ok {expect} events tip={prev}")
    return 0


def pubkey() -> None:
    if not PUB.exists():
        init()
    sys.stdout.write(PUB.read_text())


def tip() -> None:
    seq, h = _tip()
    print(f"{seq} {h}")


def main() -> int:
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "init":
        init()
        return 0
    if cmd == "append":
        action = sys.argv[2] if len(sys.argv) > 2 else ""
        if not action:
            print("usage: cicada-seal append ACTION [json-detail]", file=sys.stderr)
            return 1
        detail = json.loads(sys.argv[3]) if len(sys.argv) > 3 else {}
        print(append(action, detail))
        return 0
    if cmd == "verify":
        return verify()
    if cmd == "pubkey":
        pubkey()
        return 0
    if cmd == "tip":
        tip()
        return 0
    print("usage: cicada-seal init|append|verify|pubkey|tip", file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
