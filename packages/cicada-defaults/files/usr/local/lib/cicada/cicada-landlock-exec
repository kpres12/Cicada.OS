#!/usr/bin/env python3
"""Apply a Landlock FS allowlist, then exec the real command.

Runs *inside* the bwrap mount namespace as the first process. Landlock is a
second filesystem floor: even if a bind was too broad or a path sneaks in,
the process tree can only use the paths listed here.

Degrades visibly on ENOSYS / EOPNOTSUPP (old kernel, Landlock not in LSM
list) — prints to stderr and execs unconfined rather than refusing to launch.
Escape hatch is the caller's job (cicada.nolandlock / CICADA_LANDLOCK=0).
"""
from __future__ import annotations

import ctypes
import ctypes.util
import os
import sys


# linux/landlock.h — keep in sync with kernel UAPI; unknown high bits are
# rejected by landlock_create_ruleset so we probe downward.
LANDLOCK_ACCESS_FS_EXECUTE = 1 << 0
LANDLOCK_ACCESS_FS_WRITE_FILE = 1 << 1
LANDLOCK_ACCESS_FS_READ_FILE = 1 << 2
LANDLOCK_ACCESS_FS_READ_DIR = 1 << 3
LANDLOCK_ACCESS_FS_REMOVE_DIR = 1 << 4
LANDLOCK_ACCESS_FS_REMOVE_FILE = 1 << 5
LANDLOCK_ACCESS_FS_MAKE_CHAR = 1 << 6
LANDLOCK_ACCESS_FS_MAKE_DIR = 1 << 7
LANDLOCK_ACCESS_FS_MAKE_REG = 1 << 8
LANDLOCK_ACCESS_FS_MAKE_SOCK = 1 << 9
LANDLOCK_ACCESS_FS_MAKE_FIFO = 1 << 10
LANDLOCK_ACCESS_FS_MAKE_BLOCK = 1 << 11
LANDLOCK_ACCESS_FS_MAKE_SYM = 1 << 12
LANDLOCK_ACCESS_FS_REFER = 1 << 13
LANDLOCK_ACCESS_FS_TRUNCATE = 1 << 14
LANDLOCK_ACCESS_FS_IOCTL_DEV = 1 << 15

LANDLOCK_RULE_PATH_BENEATH = 1

FS_READ = (
    LANDLOCK_ACCESS_FS_EXECUTE
    | LANDLOCK_ACCESS_FS_READ_FILE
    | LANDLOCK_ACCESS_FS_READ_DIR
)
FS_WRITE = (
    LANDLOCK_ACCESS_FS_WRITE_FILE
    | LANDLOCK_ACCESS_FS_REMOVE_DIR
    | LANDLOCK_ACCESS_FS_REMOVE_FILE
    | LANDLOCK_ACCESS_FS_MAKE_CHAR
    | LANDLOCK_ACCESS_FS_MAKE_DIR
    | LANDLOCK_ACCESS_FS_MAKE_REG
    | LANDLOCK_ACCESS_FS_MAKE_SOCK
    | LANDLOCK_ACCESS_FS_MAKE_FIFO
    | LANDLOCK_ACCESS_FS_MAKE_BLOCK
    | LANDLOCK_ACCESS_FS_MAKE_SYM
    | LANDLOCK_ACCESS_FS_TRUNCATE
)
FS_RW = FS_READ | FS_WRITE


class LandlockRulesetAttr(ctypes.Structure):
    _fields_ = [("handled_access_fs", ctypes.c_uint64)]


class LandlockPathBeneathAttr(ctypes.Structure):
    _fields_ = [
        ("allowed_access", ctypes.c_uint64),
        ("parent_fd", ctypes.c_int32),
    ]


def _syscall_numbers() -> tuple[int, int, int]:
    # x86_64 Landlock syscalls. Other arches are left unfiltered by the caller.
    return 444, 445, 446  # create_ruleset, add_rule, restrict_self


def _libc():
    lib = ctypes.CDLL(ctypes.util.find_library("c"), use_errno=True)
    lib.syscall.restype = ctypes.c_long
    return lib


def _create_ruleset(lib, handled: int) -> int:
    create, _, _ = _syscall_numbers()
    attr = LandlockRulesetAttr(handled_access_fs=handled)
    fd = lib.syscall(
        create,
        ctypes.byref(attr),
        ctypes.c_size_t(ctypes.sizeof(attr)),
        ctypes.c_uint(0),
    )
    return int(fd)


def _probe_handled(lib) -> int | None:
    # Newest bits first; kernels that do not know a bit return -1 / EINVAL.
    candidates = [
        FS_RW | LANDLOCK_ACCESS_FS_REFER | LANDLOCK_ACCESS_FS_IOCTL_DEV,
        FS_RW | LANDLOCK_ACCESS_FS_REFER,
        FS_RW,
        FS_READ | FS_WRITE,  # without truncate on very old ABI
        FS_READ
        | LANDLOCK_ACCESS_FS_WRITE_FILE
        | LANDLOCK_ACCESS_FS_REMOVE_DIR
        | LANDLOCK_ACCESS_FS_REMOVE_FILE
        | LANDLOCK_ACCESS_FS_MAKE_DIR
        | LANDLOCK_ACCESS_FS_MAKE_REG
        | LANDLOCK_ACCESS_FS_MAKE_SYM,
    ]
    for handled in candidates:
        fd = _create_ruleset(lib, handled)
        if fd >= 0:
            return handled
        err = ctypes.get_errno()
        if err in (errno_enosys(), errno_eopnotsupp()):
            return None
    return None


def errno_enosys() -> int:
    return 38


def errno_eopnotsupp() -> int:
    return 95


def _add_path(lib, ruleset_fd: int, path: str, access: int, handled: int) -> None:
    if not path or not os.path.exists(path):
        return
    access &= handled
    if access == 0:
        return
    _, add_rule, _ = _syscall_numbers()
    dirfd = os.open(path, os.O_PATH | os.O_CLOEXEC)
    try:
        rule = LandlockPathBeneathAttr(allowed_access=access, parent_fd=dirfd)
        rc = lib.syscall(
            add_rule,
            ctypes.c_int(ruleset_fd),
            ctypes.c_uint(LANDLOCK_RULE_PATH_BENEATH),
            ctypes.byref(rule),
            ctypes.c_uint(0),
        )
        if rc != 0:
            err = ctypes.get_errno()
            # EBADFD / EINVAL on exotic mounts — skip rather than abort launch.
            if err not in (0,):
                sys.stderr.write(
                    f"cicada-landlock: skip {path}: errno {err}\n"
                )
    finally:
        os.close(dirfd)


def _restrict(lib, ruleset_fd: int) -> None:
    _, _, restrict = _syscall_numbers()
    rc = lib.syscall(restrict, ctypes.c_int(ruleset_fd), ctypes.c_uint(0))
    if rc != 0:
        raise OSError(ctypes.get_errno(), "landlock_restrict_self")


def _usage() -> None:
    sys.stderr.write(
        "usage: cicada-landlock-exec [--rw PATH]... -- COMMAND [ARGS...]\n"
    )
    sys.exit(1)


def main(argv: list[str]) -> int:
    rw_paths: list[str] = []
    i = 0
    while i < len(argv):
        if argv[i] == "--":
            i += 1
            break
        if argv[i] == "--rw" and i + 1 < len(argv):
            rw_paths.append(argv[i + 1])
            i += 2
            continue
        _usage()
    else:
        _usage()
    if not argv[i:]:
        _usage()
    cmd = argv[i:]

    # Non-x86_64: do not invent syscall numbers.
    if os.uname().machine not in ("x86_64", "amd64"):
        sys.stderr.write(
            "cicada-landlock: non-x86_64 — exec without Landlock\n"
        )
        os.execvp(cmd[0], cmd)

    lib = _libc()
    handled = _probe_handled(lib)
    if handled is None:
        sys.stderr.write(
            "cicada-landlock: Landlock unavailable — exec without second floor\n"
        )
        os.execvp(cmd[0], cmd)

    fd = _create_ruleset(lib, handled)
    if fd < 0:
        sys.stderr.write(
            f"cicada-landlock: create_ruleset errno {ctypes.get_errno()} — "
            "exec without second floor\n"
        )
        os.execvp(cmd[0], cmd)

    try:
        # Read+exec the whole tree; write only where cicada-run listed.
        _add_path(lib, fd, "/", FS_READ | LANDLOCK_ACCESS_FS_REFER, handled)
        for p in ("/tmp", "/dev/shm", "/var/tmp"):
            _add_path(lib, fd, p, FS_RW | LANDLOCK_ACCESS_FS_REFER, handled)
        # Device nodes the sandbox already exposed (DRI, etc.).
        _add_path(
            lib,
            fd,
            "/dev",
            FS_READ
            | LANDLOCK_ACCESS_FS_WRITE_FILE
            | LANDLOCK_ACCESS_FS_IOCTL_DEV
            | LANDLOCK_ACCESS_FS_REFER,
            handled,
        )
        for p in rw_paths:
            _add_path(lib, fd, p, FS_RW | LANDLOCK_ACCESS_FS_REFER, handled)
        _restrict(lib, fd)
    except OSError as exc:
        sys.stderr.write(
            f"cicada-landlock: {exc} — exec without second floor\n"
        )
        try:
            os.close(fd)
        except OSError:
            pass
        os.execvp(cmd[0], cmd)
    try:
        os.close(fd)
    except OSError:
        pass
    os.execvp(cmd[0], cmd)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
