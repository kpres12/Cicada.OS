#!/usr/bin/ash
# LUKS unlock with a duress slot that must not look like success.
# Wrong passphrase and duress both wait CICADA_DURESS_BUDGET seconds, then
# print the same line. Real unlock returns immediately (daily driver).
# Duress: luksErase + header smash + poweroff (keys gone).
# After CICADA_LUKS_MAX_FAIL wrong guesses (default 20), same wipe — Graphene-
# shaped attempt cap. Counter persists on the ESP across reboots when possible.
# Session lock (hyprlock) does NOT wipe — typos while logged in stay recoverable.

CICADA_DURESS_BUDGET=12
# Overridden by /cicada-luks-max-fail baked into the initramfs (see install hook).
CICADA_LUKS_MAX_FAIL=20

_pad() {
  local start="$1"
  local now elapsed wait
  now="$(date +%s)"
  elapsed=$((now - start))
  wait=$((CICADA_DURESS_BUDGET - elapsed))
  [ "${wait}" -gt 0 ] && sleep "${wait}"
}

_parse_cryptdevice() {
  local param rest
  for param in $(cat /proc/cmdline); do
    case "${param}" in
      cryptdevice=*)
        rest="${param#cryptdevice=}"
        rest="${rest%%,*}"
        CRYPTDEV="${rest%%:*}"
        CRYPTNAME="${rest#*:}"
        ;;
    esac
  done
}

ESPMNT=/cicada-esp
_mount_esp() {
  local cand
  mkdir -p "${ESPMNT}"
  # Already mounted from a previous try in this boot?
  if grep -q " ${ESPMNT} " /proc/mounts 2>/dev/null; then
    return 0
  fi
  if command -v blkid >/dev/null 2>&1; then
    for cand in $(blkid -t TYPE=vfat -o device 2>/dev/null); do
      if mount -t vfat -o rw "${cand}" "${ESPMNT}" 2>/dev/null; then
        if [ -d "${ESPMNT}/EFI" ] || [ -d "${ESPMNT}/loader" ] || [ -d "${ESPMNT}/cicada" ]; then
          mkdir -p "${ESPMNT}/cicada"
          return 0
        fi
        umount "${ESPMNT}" 2>/dev/null
      fi
    done
  fi
  return 1
}

_fail_path() {
  echo "${ESPMNT}/cicada/luks-fail.count"
}

_read_fails() {
  local f n=0
  if _mount_esp; then
    f="$(_fail_path)"
    if [ -f "${f}" ]; then
      n="$(cat "${f}" 2>/dev/null)"
    fi
  fi
  # Also track in-memory for this boot if ESP is missing.
  [ -n "${CICADA_FAILS_MEM:-}" ] && n="${CICADA_FAILS_MEM}"
  case "${n}" in
    ''|*[!0-9]*) n=0 ;;
  esac
  echo "${n}"
}

_write_fails() {
  local n="$1" f
  CICADA_FAILS_MEM="${n}"
  if _mount_esp; then
    f="$(_fail_path)"
    mkdir -p "${ESPMNT}/cicada"
    echo "${n}" > "${f}" 2>/dev/null || true
  fi
}

_reset_fails() {
  CICADA_FAILS_MEM=0
  if _mount_esp; then
    rm -f "$(_fail_path)" 2>/dev/null || true
    # leave max-fail override alone
  fi
}

_wipe_disk() {
  local start="$1"
  cryptsetup close "${CRYPTNAME}" 2>/dev/null
  cryptsetup luksErase --batch-mode "${CRYPTDEV}" >/dev/null 2>&1 \
    || cryptsetup erase --batch-mode "${CRYPTDEV}" >/dev/null 2>&1 || true
  dd if=/dev/zero of="${CRYPTDEV}" bs=1M count=4 conv=notrunc >/dev/null 2>&1 || true
  _reset_fails
  umount "${KEYMNT}" 2>/dev/null
  umount "${ESPMNT}" 2>/dev/null
  _pad "${start}"
  echo "Invalid passphrase"
  poweroff -f
}

# A USB key token, if one was enrolled. Mounted read-only, unmounted before we
# do anything else, and never copied anywhere.
KEYMNT=/cicada-token
_find_token() {
  local label="$1" dev=""
  [ -e "/dev/disk/by-label/${label}" ] && dev="/dev/disk/by-label/${label}"
  if [ -z "${dev}" ] && command -v blkid >/dev/null 2>&1; then
    dev="$(blkid -L "${label}" 2>/dev/null)"
  fi
  [ -n "${dev}" ] || return 1
  mkdir -p "${KEYMNT}"
  mount -o ro "${dev}" "${KEYMNT}" 2>/dev/null || return 1
  return 0
}

run_hook() {
  _parse_cryptdevice
  [ -n "${CRYPTDEV}" ] && [ -n "${CRYPTNAME}" ] || return 0
  [ "${CRYPTDEV#UUID=}" != "${CRYPTDEV}" ] && CRYPTDEV="/dev/disk/by-uuid/${CRYPTDEV#UUID=}"

  local pass rc start got want fails max
  local kf_mode="" kf_label="CICADA-KEY" kf_name="cicada.key" kf=""

  if [ -f /cicada-luks-max-fail ]; then
    max="$(cat /cicada-luks-max-fail 2>/dev/null)"
    case "${max}" in
      ''|*[!0-9]*) ;;
      *) CICADA_LUKS_MAX_FAIL="${max}" ;;
    esac
  fi
  # ESP override (no mkinitcpio rebuild): /EFI…/cicada/max-fail
  if _mount_esp && [ -f "${ESPMNT}/cicada/max-fail" ]; then
    max="$(cat "${ESPMNT}/cicada/max-fail" 2>/dev/null)"
    case "${max}" in
      ''|*[!0-9]*) ;;
      *) CICADA_LUKS_MAX_FAIL="${max}" ;;
    esac
  fi

  # /etc/cicada/keyfile.env lives on the encrypted root, so it cannot be read
  # before unlock. cicada-keyfile-enroll therefore also stamps the mode into the
  # initramfs at build time (see install/cicada-crypt).
  if [ -f /cicada-keyfile.env ]; then
    # shellcheck disable=SC1091
    . /cicada-keyfile.env
    kf_mode="${CICADA_KEYFILE_MODE:-}"
    kf_label="${CICADA_KEYFILE_LABEL:-CICADA-KEY}"
    kf_name="${CICADA_KEYFILE_NAME:-cicada.key}"
  fi

  if [ -n "${kf_mode}" ] && _find_token "${kf_label}"; then
    kf="${KEYMNT}/${kf_name}"
    [ -f "${kf}" ] || kf=""
  fi

  if [ -n "${kf}" ] && [ "${kf_mode}" = "or" ]; then
    # Token alone is a full factor in --or mode: no prompt at all.
    if cryptsetup open --type luks --key-file "${kf}" "${CRYPTDEV}" "${CRYPTNAME}" >/dev/null 2>&1; then
      umount "${KEYMNT}" 2>/dev/null
      _reset_fails
      echo "Unlocked with Cicada key token."
      return 0
    fi
    echo "Key token present but rejected; falling back to passphrase."
  fi

  while true; do
    if [ -n "${kf}" ] && [ "${kf_mode}" = "and" ]; then
      echo -n "Passphrase for ${CRYPTNAME} (token detected): "
    else
      echo -n "Enter passphrase for ${CRYPTNAME}: "
    fi
    read -r -s pass
    echo
    start="$(date +%s)"

    if [ -n "${kf}" ] && [ "${kf_mode}" = "and" ]; then
      # Secret is passphrase||keyfile — matches how the slot was created, and
      # means neither the stick nor the phrase is worth anything on its own.
      { printf '%s' "${pass}"; cat "${kf}"; } \
        | cryptsetup open --type luks "${CRYPTDEV}" "${CRYPTNAME}" >/dev/null 2>&1
    else
      printf '%s' "${pass}" | cryptsetup open --type luks "${CRYPTDEV}" "${CRYPTNAME}" >/dev/null 2>&1
    fi
    rc=$?

    if [ "${rc}" -eq 0 ]; then
      mkdir -p /cicada-check
      if mount -o ro,subvol=@ "/dev/mapper/${CRYPTNAME}" /cicada-check 2>/dev/null \
        || mount -o ro "/dev/mapper/${CRYPTNAME}" /cicada-check 2>/dev/null; then
        if [ -f /cicada-check/etc/cicada/duress.sha256 ]; then
          got="$(printf '%s' "${pass}" | sha256sum | awk '{print $1}')"
          want="$(cat /cicada-check/etc/cicada/duress.sha256)"
          if [ "${got}" = "${want}" ]; then
            umount /cicada-check 2>/dev/null
            _wipe_disk "${start}"
          fi
        fi
        umount /cicada-check 2>/dev/null
      fi
      pass=""
      umount "${KEYMNT}" 2>/dev/null
      _reset_fails
      return 0
    fi

    pass=""
    fails="$(_read_fails)"
    fails=$((fails + 1))
    _write_fails "${fails}"

    # 0 = unlimited. Otherwise wipe at the threshold (same look as a wrong guess).
    if [ "${CICADA_LUKS_MAX_FAIL}" -gt 0 ] 2>/dev/null; then
      if [ "${fails}" -ge "${CICADA_LUKS_MAX_FAIL}" ]; then
        _wipe_disk "${start}"
      fi
    fi

    _pad "${start}"
    echo "Invalid passphrase"
  done
}

run_latehook() {
  return 0
}
