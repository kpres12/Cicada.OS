# Cicada hostile defaults — sourced by firstboot and services
CICADA_RADIOS_OFF_DEFAULT=0
CICADA_FIREWALL_DEFAULT=1
CICADA_TELEMETRY=0
CICADA_IPV6_PRIVACY=1
# Seconds hyprlock may run before reboot-to-rest (BFU). 30m default — not 6h AFU.
CICADA_LOCK_REBOOT_SEC=1800
# Same idea, but for a machine whose lid is shut: that is a laptop in a bag or
# in someone else's hands, not one you stepped away from. Drop to BFU fast.
# 20 minutes, not 2. Locking is still immediate on lid close — this is only
# how long before the machine drops to BFU (keys out of RAM). At 2 minutes you
# lose your session walking between rooms, which makes the laptop unusable and
# means the user turns the whole feature off. GrapheneOS ships 18 HOURS by
# default; 20 minutes is already far more aggressive than the thing we are
# claiming parity with.
CICADA_LID_REBOOT_SEC=1200
# Hardware watchdog enforces the AFU window even if userspace is compromised or
# the systemd timer is stopped. 0 disables. Timeout is the pet deadline, not the
# AFU window — most PC watchdogs cap around 60s.
CICADA_WATCHDOG=1
CICADA_WATCHDOG_TIMEOUT=30

# Scrub free RAM at shutdown. Does not cover pages still in use — that is
# what reboot-to-BFU is for. 0 disables.
CICADA_MEMWIPE=1
