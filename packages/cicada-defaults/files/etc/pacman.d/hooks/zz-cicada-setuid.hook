# Upgrading a package restores its setuid bit, silently undoing the hardening.
# Re-apply after every transaction. Runs last (zz-) so it sees the final state.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/bin/*

[Action]
Description = Cicada: re-strip setuid from unused binaries
When = PostTransaction
# /bin/bash explicitly: if the exec bit is ever lost the hook still runs,
# instead of failing every pacman transaction with 'execv: Permission denied'.
Exec = /bin/bash /usr/local/lib/cicada/strip-setuid.sh
