#%PAM-1.0
# Cicada: session duress runs before normal auth (hyprlock + sudo).
# optional + seteuid — never locks you out if the hook is missing.
#
# sudo IS setuid root, so seteuid gives the hook euid 0 and it does the wipe
# in-process, without touching cicada-duress.socket. The lock screen is the case
# that needs the socket; see /etc/pam.d/hyprlock for why.
auth       optional   pam_exec.so seteuid expose_authtok quiet /usr/local/bin/cicada-duress-check
auth		include		system-auth
account		include		system-auth
session		include		system-auth
