[Unit]
Description=Cicada free-RAM scrub before power off
DefaultDependencies=no
# Late: after filesystems are read-only and services are down, so the memory
# being scrubbed is genuinely free rather than about to be reused.
After=umount.target final.target
Before=poweroff.target reboot.target halt.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/cicada-memwipe
# A slow disk or an odd tmpfs must never wedge shutdown — a machine that will
# not power off is worse than one with unscrubbed free pages.
TimeoutStartSec=45
RemainAfterExit=no

# --- confinement -------------------------------------------------------------
# Mounts a scratch tmpfs and fills it. That tmpfs is nobody else's business, so
# unlike cicada-tor-netns this one *wants* a private mount namespace.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run
ProtectHome=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectHostname=yes
ProtectClock=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# CAP_SYS_ADMIN to mount the scratch tmpfs; nothing else.
CapabilityBoundingSet=CAP_SYS_ADMIN
SystemCallFilter=@system-service @mount
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

[Install]
WantedBy=poweroff.target reboot.target halt.target
