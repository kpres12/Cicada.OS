[Unit]
Description=Cicada sandbox syscall filter (build the bwrap seccomp program)
# Must exist before anything the user can launch. Nothing else depends on it,
# and cicada-run degrades visibly if it is missing rather than refusing to run.
DefaultDependencies=no
After=local-fs.target
Before=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Generated per boot into tmpfs rather than shipped as a file in the package:
# the syscall numbers come from the running system's uapi header, so a kernel or
# glibc bump can never leave a stale table behind, and there is no binary blob in
# the repo for a reviewer to take on faith.
RuntimeDirectory=cicada/seccomp
RuntimeDirectoryPreserve=yes
ExecStart=/usr/local/lib/cicada/cicada-seccomp-gen.sh /run/cicada/seccomp/default.bpf

# --- confinement -------------------------------------------------------------
# Reads one header, writes one file. It should be able to do nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectHostname=yes
ProtectClock=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
