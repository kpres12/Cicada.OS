[Unit]
Description=Cicada onion network namespace (Tor-only egress)
After=network.target nss-lookup.target
Wants=tor.service
After=tor.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/cicada-tor-netns up
ExecStop=/usr/local/bin/cicada-tor-netns down

# --- confinement -------------------------------------------------------------
# Deliberately NO filesystem namespacing here — not ProtectSystem, ProtectHome,
# PrivateTmp, ProtectKernelTunables or ProtectKernelLogs. Every one of those puts
# the service in a private mount namespace with slave propagation, and `ip netns
# add` works by bind-mounting the new namespace at /run/netns/onion. In a private
# mount namespace that bind mount is invisible to the rest of the system, so the
# unit would report success while `ip netns list` shows nothing and every
# NETWORK=tor scope refuses to launch. PrivateMounts=no states the requirement
# instead of leaving it as a trap for whoever adds ProtectSystem= later.
#
# What is left is the confinement that does not touch mounts: capabilities,
# syscalls, address families, namespace types. `ip netns add` needs CAP_SYS_ADMIN
# for the mount and CAP_NET_ADMIN for the namespace, so those are the floor.
PrivateMounts=no
NoNewPrivileges=yes
ProtectClock=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# net: the namespace itself. mnt: iproute2 unshares a mount namespace to swap
# /etc/netns config in. Nothing else — no user, pid, ipc or cgroup namespaces.
RestrictNamespaces=net mnt
# nft and ip speak netlink; logger speaks AF_UNIX.
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN
SystemCallFilter=@system-service @mount
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
