# Cicada extras merged on top of official archiso releng.
# Keep this list product-layer only — rescue/install tooling comes from releng.

# --- GPU (Intel MBA 2015–2017: HD 5000/6000) ---
mesa
vulkan-intel
libva-intel-driver
intel-media-driver
libva-utils
linux-firmware-broadcom
# --- firmware, named explicitly -------------------------------------------
# The linux-firmware META package is excluded (see packages.exclude) because it
# hard-depends on every vendor split including nvidia, which was 541 MiB across
# the squashfs, both initramfs images and the efiboot duplicate. Listing the
# splits here is what keeps that choice ours instead of the meta's.
#
# Kept because real laptops need them; dropped ones are one pacman command away.
linux-firmware-intel
linux-firmware-atheros
linux-firmware-realtek
linux-firmware-mediatek
linux-firmware-amdgpu
linux-firmware-radeon
linux-firmware-cirrus
linux-firmware-other
# pin providers so pacstrap is non-interactive
iptables
pipewire-jack

# --- Hyprland daily driver ---
hyprland
xdg-desktop-portal
xdg-desktop-portal-hyprland
xdg-desktop-portal-gtk
hyprpolkitagent
hyprpaper
hyprlock
# Login greeter (etched installs). Live keeps getty autologin.
greetd
greetd-tuigreet
waybar
wofi
kitty
grim
slurp
swappy
wl-clipboard
qt6-wayland
qt6ct
qt6-svg
lxqt-qtplugin
adwaita-cursors
xorg-xwayland
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
pamixer
brightnessctl
playerctl

# --- MAGI-04 pattern bay (cicada-wallpapers) ---
# quickshell renders the panel, imagemagick builds the plate thumbnails,
# jq reads the panel config. All three ship in [extra]; no AUR.
quickshell
imagemagick
jq

ttf-jetbrains-mono-nerd
ttf-font-awesome
noto-fonts
noto-fonts-emoji

# --- browser runtime (Helium itself is the pinned tarball, not a pacman pkg) ---
nss
nspr
gtk3
libxss
libcups
xdg-utils

# --- desktop shell (mouse-first; Hyprland is the engine, not the UX) ---
file-roller
layer-shell-qt
pcmanfm-qt
gvfs
tumbler
ffmpegthumbnailer
xdg-user-dirs
papirus-icon-theme
gnome-themes-extra
swaync
nwg-dock-hyprland
zenity
networkmanager
nm-connection-editor
# Doom runtime (engine built by scripts/install-doom.sh; not AUR)
sdl2
sdl2_mixer
sdl2_net

# --- privacy / security baseline ---
python
nftables
usbguard
apparmor
firejail
bubblewrap
xdg-dbus-proxy
keepassxc
gnupg
age
wireguard-tools
macchanger
# cicada-link / cicada-beacon draw the pairing key and the signed statement as a
# scannable code. That is the witness transport that needs no radio, no network
# and no second machine — the one that still works when everything else is the
# adversary.
qrencode
libnotify
lynis
# linux-hardened is NOT on the live ISO: neither loader entry can boot it, so it
# was 667 MiB of dead weight. Installed systems get it from install-packages.txt.
sbctl
# Builds the unified kernel images (cicada-uki). Without this, sbctl signs the
# kernel but not the cmdline or the initramfs, and there is no PCR 11 to seal
# the disk against — i.e. Tier 2 is unreachable.
systemd-ukify
tpm2-tools
hypridle
qt6ct
flatpak
restic
tor
torbrowser-launcher
chrony
meek
torsocks
zram-generator

# Tirimid: editor + compile toolchain + Python
nano
base-devel
python
python-pip
